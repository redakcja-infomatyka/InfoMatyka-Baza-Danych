     "litera": "D",
     "html": "5 : 2"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Sprowadzamy do wspólnego <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math>: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>a</mi><mo>:</mo><mi>b</mi><mo>=</mo><mn>45</mn><mo>:</mo><mn>20</mn></mrow></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>b</mi><mo>:</mo><mi>c</mi><mo>=</mo><mn>20</mn><mo>:</mo><mn>12</mn></mrow></math>, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>a</mi><mo>=</mo><mn>45</mn><mi>t</mi><mo>,</mo><mi>b</mi><mo>=</mo><mn>20</mn><mi>t</mi><mo>,</mo><mi>c</mi><mo>=</mo><mn>12</mn><mi>t</mi></mrow></math>. Wtedy <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo>(</mo><mi>a</mi><mo>−</mo><mi>b</mi><mo>)</mo><mo>:</mo><mo>(</mo><mi>b</mi><mo>−</mo><mi>c</mi><mo>)</mo><mo>=</mo><mn>25</mn><mi>t</mi><mo>:</mo><mn>8</mn><mi>t</mi><mo>=</mo><mn>25</mn><mo>:</mo><mn>8</mn></mrow></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "sprowadź obie proporcje do wspólnej wartości b",
   "czas_min": 2
  },
  {
   "id": "rejonowy_2010_podkarpackie_gim_q10",
   "numer": 10,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "układ współrzędnych",
    "równania z jedną zmienną"
   ],
   "tresc_html": "<p>Jakim wzorem określona jest funkcja liniowa, której wykres przecina oś rzędnych w punkcie <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo>(</mo><mn>0</mn><mo>,</mo><mn>7</mn><mo>)</mo></mrow></math> i której miejscem zerowym jest liczba 7?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>y</mi><mo>=</mo><mi>x</mi><mo>+</mo><mn>7</mn></mrow></math>"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>y</mi><mo>=</mo><mo>−</mo><mi>x</mi><mo>+</mo><mn>7</mn></mrow></math>"
    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>y</mi><mo>=</mo><mn>7</mn><mi>x</mi><mo>+</mo><mn>7</mn></mrow></math>"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>y</mi><mo>=</mo><mfrac><mn>1</mn><mn>7</mn></mfrac><mi>x</mi><mo>+</mo><mn>7</mn></mrow></math>"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Przecięcie osi <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Oy</mi></math> w punkcie <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo>(</mo><mn>0</mn><mo>,</mo><mn>7</mn><mo>)</mo></mrow></math> daje wzór <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>y</mi><mo>=</mo><mi>a</mi><mi>x</mi><mo>+</mo><mn>7</mn></mrow></math>. Miejsce zerowe <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>x</mi><mo>=</mo><mn>7</mn></mrow></math> daje <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>0</mn><mo>=</mo><mn>7</mn><mi>a</mi><mo>+</mo><mn>7</mn></mrow></math>, skąd <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>a</mi><mo>=</mo><mo>−</mo><mn>1</mn></mrow></math>. Wzór funkcji: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>y</mi><mo>=</mo><mo>−</mo><mi>x</mi><mo>+</mo><mn>7</mn></mrow></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "wyraz wolny odczytaj z przecięcia z osią OY, resztę z warunku f(7) = 0",
   "czas_min": 1
  },
  {
   "id": "rejonowy_2010_podkarpackie_gim_q11",
   "numer": 11,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "proporcjonalność prosta"
   ],
   "tresc_html": "<p>Taką samą ilością karmy, jaką zjada 8 kaczek, można nakarmić 20 kur. Ilość karmy, jaką zjada 12 kaczek, wystarczy dla:</p>",
   "warianty": [
