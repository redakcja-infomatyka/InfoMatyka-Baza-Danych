   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "proporcjonalność prosta"
   ],
   "tresc_html": "<p>Wiadomo, że <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>a</mi><mo>:</mo><mi>b</mi><mo>=</mo><mn>9</mn><mo>:</mo><mn>4</mn></mrow></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>b</mi><mo>:</mo><mi>c</mi><mo>=</mo><mn>5</mn><mo>:</mo><mn>3</mn></mrow></math>. Wówczas <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo>(</mo><mi>a</mi><mo>−</mo><mi>b</mi><mo>)</mo><mo>:</mo><mo>(</mo><mi>b</mi><mo>−</mo><mi>c</mi><mo>)</mo></mrow></math> jest równe:</p>",
   "warianty": [
