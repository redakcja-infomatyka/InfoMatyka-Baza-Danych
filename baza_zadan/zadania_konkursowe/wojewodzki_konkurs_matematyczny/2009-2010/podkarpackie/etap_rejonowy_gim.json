    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Liczba przekątnych: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mi>n</mi><mo>(</mo><mi>n</mi><mo>−</mo><mn>3</mn><mo>)</mo></mrow><mn>2</mn></mfrac><mo>=</mo><mn>119</mn></mrow></math>, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><msup><mi>n</mi><mn>2</mn></msup><mo>−</mo><mn>3</mn><mi>n</mi><mo>−</mo><mn>238</mn><mo>=</mo><mn>0</mn></mrow></math>. Wyróżnik <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>Δ</mi><mo>=</mo><mn>9</mn><mo>+</mo><mn>952</mn><mo>=</mo><mn>961</mn><mo>=</mo><msup><mn>31</mn><mn>2</mn></msup></mrow></math>, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>n</mi><mo>=</mo><mfrac><mrow><mn>3</mn><mo>+</mo><mn>31</mn></mrow><mn>2</mn></mfrac><mo>=</mo><mn>17</mn></mrow></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "podwój liczbę przekątnych i rozłóż wynik na dwa czynniki różniące się o 3",
   "czas_min": 2
