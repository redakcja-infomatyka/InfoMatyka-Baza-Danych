   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Z równania <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo lspace=\"0\" rspace=\"0\" stretchy=\"false\">|</mo><mi>x</mi><mo>−</mo><mn>1</mn><mo lspace=\"0\" rspace=\"0\" stretchy=\"false\">|</mo><mo>=</mo><mn>3</mn></mrow></math> otrzymujemy <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>x</mi><mo>=</mo><mn>4</mn></mrow></math> lub <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>x</mi><mo>=</mo><mo>−</mo><mn>2</mn></mrow></math>. Ich suma: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>4</mn><mo>+</mo><mo>(</mo><mo>−</mo><mn>2</mn><mo>)</mo><mo>=</mo><mn>2</mn></mrow></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "odizoluj wartość bezwzględną — rozwiązania będą dwa",
   "czas_min": 1,
   "haczyk": {
