   "tresc_html": "<p>Oblicz: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo>−</mo><mn>3</mn><msup><mrow><mo>(</mo><msup><mn>12</mn><mn>2</mn></msup><mo>−</mo><msup><mn>3</mn><mn>3</mn></msup><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></math></p>",
