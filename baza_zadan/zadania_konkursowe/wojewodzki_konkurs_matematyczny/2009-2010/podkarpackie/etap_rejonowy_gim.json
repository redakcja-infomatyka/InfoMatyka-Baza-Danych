    ],
    "opis": "Równanie z wartością bezwzględną ma dwa rozwiązania, a pytają o ich sumę"
   }
  },
  {
   "id": "rejonowy_2010_podkarpackie_gim_q14",
   "numer": 14,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "usuwanie niewymierności z mianownika",
    "wzory skróconego mnożenia"
   ],
   "tresc_html": "<p>Suma <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><msqrt><mn>6</mn></msqrt><mo>−</mo><msqrt><mn>5</mn></msqrt></mrow><mrow><msqrt><mn>6</mn></msqrt><mo>+</mo><msqrt><mn>5</mn></msqrt></mrow></mfrac><mo>+</mo><mfrac><mrow><msqrt><mn>6</mn></msqrt><mo>+</mo><msqrt><mn>5</mn></msqrt></mrow><mrow><msqrt><mn>6</mn></msqrt><mo>−</mo><msqrt><mn>5</mn></msqrt></mrow></mfrac></mrow></math> jest równa:</p>",
   "warianty": [
