   "typ": "otwarte",
   "punkty": 2,
   "tematy": [
    "wyrażenia algebraiczne"
   ],
   "tresc_html": "<p>Dla pewnych liczb <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math> wartość wyrażenia <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>a</mi><mo>−</mo><mn>1</mn></mrow><mi>b</mi></mfrac></math> jest równa 3. Jaka jest wartość, dla tych samych liczb <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math>, wyrażenia <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>2</mn><mo>·</mo><mfrac><mrow><mi>a</mi><mo>−</mo><mn>1</mn></mrow><mi>b</mi></mfrac><mo>+</mo><mn>3</mn><mo>·</mo><mfrac><mi>b</mi><mrow><mi>a</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mrow></math>?</p>",
   "warianty": [],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "7",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Niech <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mi>a</mi><mo>−</mo><mn>1</mn></mrow><mi>b</mi></mfrac><mo>=</mo><mn>3</mn></mrow></math>, wtedy <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mi>b</mi><mrow><mi>a</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo>=</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></math>. Wyrażenie = <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>2</mn><mo>·</mo><mn>3</mn><mo>+</mo><mn>3</mn><mo>·</mo><mfrac><mn>1</mn><mn>3</mn></mfrac><mo>=</mo><mn>6</mn><mo>+</mo><mn>1</mn><mo>=</mo><mn>7</mn></mrow></math>.</p>"
