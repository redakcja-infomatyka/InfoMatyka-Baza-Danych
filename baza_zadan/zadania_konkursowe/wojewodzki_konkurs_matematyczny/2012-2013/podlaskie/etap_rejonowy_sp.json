 "zadania": [
  {
   "id": "rejonowy_2012_podlaskie_sp_q1",
   "numer": 1,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "liczby rzymskie"
   ],
   "tresc_html": "<p>Ile znaków rzymskich należy użyć do zapisania liczby 16?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "2"
    },
    {
     "litera": "B",
     "html": "3"
    },
    {
     "litera": "C",
     "html": "4"
    },
    {
     "litera": "D",
     "html": "5"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>16 zapisujemy rzymsko jako <b>XVI</b> = X, V, I — trzy znaki.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "przypomnij rzymski zapis liczby 16",
   "czas_min": 1
  },
  {
   "id": "rejonowy_2012_podlaskie_sp_q2",
   "numer": 2,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "wyrażenia algebraiczne"
   ],
   "tresc_html": "<p>Liczby <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math> są liczbami przeciwnymi. Która zależność jest prawdziwa?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>a</mi><mo>+</mo><mi>b</mi><mo>=</mo><mn>1</mn></mrow></math>"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>a</mi><mo>·</mo><mi>b</mi><mo>=</mo><mn>1</mn></mrow></math>"
    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>a</mi><mo>+</mo><mi>b</mi><mo>=</mo><mn>0</mn></mrow></math>"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>a</mi><mo>·</mo><mi>b</mi><mo>=</mo><mn>0</mn></mrow></math>"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Liczby przeciwne spełniają <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>a</mi><mo>+</mo><mi>b</mi><mo>=</mo><mn>0</mn></mrow></math> (np. <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>b</mi><mo>=</mo><mo>−</mo><mi>a</mi></mrow></math>).</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "skorzystaj z definicji: liczby przeciwne to a i −a",
   "czas_min": 1
  },
  {
   "id": "rejonowy_2012_podlaskie_sp_q3",
   "numer": 3,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "kąty",
    "geometria"
   ],
   "tresc_html": "<p>Wskaż zdanie fałszywe:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "Przez 2 punkty przechodzi 1 prosta."
    },
    {
     "litera": "B",
     "html": "Każda ściana sześcianu jest kwadratem."
    },
    {
     "litera": "C",
     "html": "Każdy kwadrat jest prostokątem."
    },
    {
     "litera": "D",
     "html": "Kąty przyległe są zawsze równe."
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Kąty przyległe sumują się do 180°, więc nie są zawsze równe (równe tylko gdy oba po 90°). Zdania A, B, C są prawdziwe.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "przejdź po zdaniach po kolei i skonfrontuj każde z definicją",
   "czas_min": 2
  },
  {
   "id": "rejonowy_2012_podlaskie_sp_q4",
   "numer": 4,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "reszta z dzielenia"
   ],
   "tresc_html": "<p>Dzieląc pewną liczbę przez 34 otrzymano 33 i reszty 29. Jaka to liczba?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "1151"
    },
    {
     "litera": "B",
     "html": "1093"
    },
    {
     "litera": "C",
     "html": "1122"
    },
    {
     "litera": "D",
     "html": "1108"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>34</mn><mo>·</mo><mn>33</mn><mo>+</mo><mn>29</mn><mo>=</mo><mn>1122</mn><mo>+</mo><mn>29</mn><mo>=</mo><mn>1151</mn></mrow></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "dzielna = dzielnik · iloraz + reszta",
   "czas_min": 1
  },
  {
   "id": "rejonowy_2012_podlaskie_sp_q5",
   "numer": 5,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "wyrażenia algebraiczne",
    "pole i obwód"
   ],
   "tresc_html": "<p>Działka ma kształt prostokąta o bokach długości <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> metrów i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math> metrów. Cena jednego metra bieżącego ogrodzenia jest równa <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> złotych. Wskaż wyrażenie opisujące koszt ogrodzenia działki.</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>2</mn><mi>a</mi><mo>+</mo><mn>2</mn><mi>b</mi><mo>·</mo><mi>x</mi></mrow></math>"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>2</mn><mi>x</mi><mo>·</mo><mo>(</mo><mi>a</mi><mo>+</mo><mi>b</mi><mo>)</mo></mrow></math>"
    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>a</mi><mi>x</mi><mo>+</mo><mi>b</mi><mi>x</mi></mrow></math>"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>a</mi><mi>b</mi><mi>x</mi></mrow></math>"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Obwód działki <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo>=</mo><mn>2</mn><mo>(</mo><mi>a</mi><mo>+</mo><mi>b</mi><mo>)</mo></mrow></math>, koszt <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo>=</mo><mn>2</mn><mi>x</mi><mo>(</mo><mi>a</mi><mo>+</mo><mi>b</mi><mo>)</mo></mrow></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "koszt to obwód prostokąta razy cena jednego metra",
   "czas_min": 1,
   "haczyk": {
    "sila": 2,
    "rodzaje": [
     "konwencja"
    ],
    "opis": "Wariant bez nawiasu: 2a+2b·x mnoży przez x tylko jeden składnik, choć wygląda jak obwód razy cena"
   }
  },
  {
   "id": "rejonowy_2012_podlaskie_sp_q6",
   "numer": 6,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "równania z jedną zmienną",
    "ułamki"
   ],
   "tresc_html": "<p>Z naczynia wyparowało <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>2</mn><mn>5</mn></mfrac></math> wody. Ile wody było początkowo w naczyniu, jeśli pozostało w nim 36 litrów?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "40 litrów"
    },
    {
     "litera": "B",
     "html": "54 litry"
    },
    {
     "litera": "C",
     "html": "60 litrów"
    },
    {
     "litera": "D",
     "html": "90 litrów"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Pozostało <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>3</mn><mn>5</mn></mfrac></math> = 36 l, więc całość = <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>36</mn><mo>·</mo><mfrac><mn>5</mn><mn>3</mn></mfrac><mo>=</mo><mn>60</mn></mrow></math> litrów.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "zauważ, jaką częścią całości jest pozostałe 36 litrów",
   "czas_min": 1,
   "haczyk": {
    "sila": 2,
    "rodzaje": [
     "o-co-pytaja",
     "procent-podstawa"
    ],
    "opis": "36 litrów to część, która została, a nie ta, która wyparowała"
   }
  },
  {
   "id": "rejonowy_2012_podlaskie_sp_q7",
   "numer": 7,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "trójkąty",
    "kąty"
   ],
   "tresc_html": "<p>W trójkącie jeden bok ma długość 5 cm. Kąty leżące przy tym boku mają po 50°. Trójkąt ten jest:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "rozwartokątny równoramienny"
    },
    {
     "litera": "B",
     "html": "ostrokątny równoramienny"
    },
    {
     "litera": "C",
     "html": "równoboczny"
    },
    {
     "litera": "D",
     "html": "prostokątny równoramienny"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Dwa kąty przy boku po 50° dają trzeci kąt 80° — wszystkie ostre (ostrokątny) i dwa równe kąty przy podstawie ⇒ równoramienny.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "wyznacz trzeci kąt z sumy 180° i sprawdź, czy któryś jest prosty lub rozwarty",
   "czas_min": 2
  },
  {
   "id": "rejonowy_2012_podlaskie_sp_q8",
   "numer": 8,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "graniastosłupy",
    "zamiana jednostek"
   ],
   "tresc_html": "<p>Ile litrów wody zmieści się w sześciennym naczyniu o krawędzi 10 cm.</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "1 litr"
    },
    {
     "litera": "B",
     "html": "10 litrów"
    },
    {
     "litera": "C",
     "html": "0,1 litra"
    },
    {
     "litera": "D",
     "html": "0,01 litra"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><msup><mn>10</mn><mn>3</mn></msup><mo>=</mo><mn>1000</mn></mrow></math> cm³ = 1 dm³ = 1 litr.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "przelicz krawędź na decymetry, zanim policzysz objętość",
   "czas_min": 1
  },
  {
   "id": "rejonowy_2012_podlaskie_sp_q9",
   "numer": 9,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "graniastosłupy",
    "liczba krawędzi, ścian i wierzchołków"
   ],
   "tresc_html": "<p>Która z liczb określa liczbę wszystkich krawędzi pewnego graniastosłupa?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "18"
    },
    {
     "litera": "B",
     "html": "22"
    },
    {
     "litera": "C",
     "html": "32"
    },
    {
     "litera": "D",
     "html": "44"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Graniastosłup o podstawie n-kąta ma <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>3</mn><mi>n</mi></mrow></math> krawędzi — liczba podzielna przez 3. Spośród podanych tylko 18 = 3·6.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "policz krawędzie graniastosłupa o podstawie n-kąta i sprawdź podzielność",
   "czas_min": 2
  },
  {
   "id": "rejonowy_2012_podlaskie_sp_q10",
   "numer": 10,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "ułamki",
    "szacowanie (zamiast obliczania)"
   ],
   "tresc_html": "<p>Wskaż błędne przybliżenie liczby z dokładnością do części dziesiątych</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>11,066</mn><mo>≈</mo><mn>11,1</mn></mrow></math>"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>5,972</mn><mo>≈</mo><mn>5,9</mn></mrow></math>"
    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>0,99</mn><mo>≈</mo><mn>1</mn></mrow></math>"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>0,55</mn><mo>≈</mo><mn>0,6</mn></mrow></math>"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>5,972 zaokrąglone do dziesiątych to 6,0 (bo setne =7), a nie 5,9. Pozostałe zaokrąglenia są poprawne.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "przy każdej liczbie patrz tylko na cyfrę setnych",
   "czas_min": 2,
   "haczyk": {
    "sila": 2,
    "rodzaje": [
     "zaokraglenie"
    ],
    "opis": "Zapis 0,99≈1 wygląda na błędny, bo brak części dziesiątych; trzeba naprawdę zaokrąglić 5,972"
   }
  },
  {
   "id": "rejonowy_2012_podlaskie_sp_q11",
   "numer": 11,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "działania na potęgach"
   ],
   "tresc_html": "<p>Która z poniższych liczb jest dodatnia?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo>−</mo><msup><mn>1</mn><mn>6</mn></msup></mrow></math>"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mrow><mo>(</mo><mo>−</mo><mn>1</mn><mo>)</mo></mrow><mn>5</mn></msup></math>"
    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mrow><mo>(</mo><mo>−</mo><mn>1</mn><mo>)</mo></mrow><mn>10</mn></msup></math>"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo>−</mo><msup><mrow><mo>(</mo><mo>−</mo><mn>1</mn><mo>)</mo></mrow><mn>2</mn></msup></mrow></math>"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><msup><mrow><mo>(</mo><mo>−</mo><mn>1</mn><mo>)</mo></mrow><mn>10</mn></msup><mo>=</mo><mn>1</mn></mrow></math> (dodatnia). A = −1, B = −1, D = −1.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "sprawdź, czy minus stoi w nawiasie i czy wykładnik jest parzysty",
   "czas_min": 2,
   "haczyk": {
    "sila": 2,
    "rodzaje": [
     "znak"
    ],
    "opis": "−1⁶ to nie (−1)⁶: potęga wiąże mocniej niż minus"
   }
  },
  {
   "id": "rejonowy_2012_podlaskie_sp_q12",
   "numer": 12,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "zadania tekstowe na równania",
    "równania z jedną zmienną"
   ],
   "tresc_html": "<p>W klasie jest 28 uczniów. Ustawiono ich w rzędzie według wzrostu malejąco. Na którym miejscu stoi Basia, jeśli liczba uczniów wyższych od niej jest 2 razy mniejsza od liczby osób niższych.</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "14"
    },
    {
     "litera": "B",
     "html": "19"
    },
    {
     "litera": "C",
     "html": "8"
    },
    {
     "litera": "D",
     "html": "10"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Wyższych t, niższych s: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>t</mi><mo>=</mo><mfrac><mi>s</mi><mn>2</mn></mfrac></mrow></math> oraz <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>t</mi><mo>+</mo><mi>s</mi><mo>=</mo><mn>27</mn></mrow></math> ⇒ t=9, s=18. Basia stoi na miejscu 9+1 = 10.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "odlicz samą Basię, a pozostałych podziel w stosunku 1 : 2",
   "czas_min": 2,
   "haczyk": {
    "sila": 2,
    "rodzaje": [
     "kierunek-relacji"
    ],
    "opis": "Kto od kogo 2 razy mniej: wyższych jest mniej; miejsce liczone od najwyższego, Basia też się liczy"
   }
  },
  {
   "id": "rejonowy_2012_podlaskie_sp_q13",
   "numer": 13,
   "typ": "otwarte",
   "punkty": 2,
   "tematy": [
    "podobieństwo i skala"
   ],
   "tresc_html": "<p>Odcinek w skali <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>3</mn><mo>:</mo><mn>1</mn></mrow></math> ma długość 18 cm. Jaką długość ma ten odcinek w skali <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>1</mn><mo>:</mo><mn>3</mn></mrow></math>?</p>",
   "warianty": [],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "2 cm",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Skala 3:1 — rysunek 3× większy, więc rzeczywista długość = 18:3 = 6 cm. W skali 1:3 rysunek = 6:3 = 2 cm.</p>"
   },
   "w_pamieci": "wprost",
