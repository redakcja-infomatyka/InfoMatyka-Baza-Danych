    "rozwiazanie_ai_html": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>1</mn><mfrac><mn>3</mn><mn>5</mn></mfrac><mo>:</mo><mn>0,2</mn><mo>=</mo><mn>1,6</mn><mo>:</mo><mn>0,2</mn><mo>=</mo><mn>8</mn></mrow></math>; <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>8,6</mn><mo>−</mo><mn>8</mn><mo>=</mo><mn>0,6</mn></mrow></math>; 60% z 0,6 = 0,36.</p>"
