   ],
   "tresc_html": "<p>Ola i Zuzia dostały od babci 50 zł. Ola jest starsza, więc wzięła 70% otrzymanej kwoty. Następnego dnia oddała siostrze 35% swoich pieniędzy. Oblicz, która siostra ma teraz więcej pieniędzy i o ile.</p>",
   "warianty": [],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "Zuzia ma więcej o 4,50 zł",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Ola: 70% z 50 = 35 zł, Zuzia: 15 zł. Ola oddaje 35% z 35 = 12,25 zł. Ola: 35−12,25 = 22,75 zł; Zuzia: 15+12,25 = 27,25 zł. Zuzia ma więcej o 27,25−22,75 = 4,50 zł.</p>"
   },
