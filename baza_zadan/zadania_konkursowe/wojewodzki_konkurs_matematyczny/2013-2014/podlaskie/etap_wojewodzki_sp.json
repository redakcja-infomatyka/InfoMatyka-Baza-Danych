  {
   "id": "wojewodzki_2013_podlaskie_sp_q4",
   "numer": 4,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "ułamki"
   ],
   "tresc_html": "<p>Wartością wyrażenia <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>)</mo><mo>(</mo><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac><mo>)</mo><mo>(</mo><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mn>4</mn></mfrac><mo>)</mo><mo>…</mo><mo>(</mo><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mn>20</mn></mfrac><mo>)</mo></math> jest liczba:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>2</mn></mfrac></math>"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>20</mn></mfrac></math>"
    },
    {
