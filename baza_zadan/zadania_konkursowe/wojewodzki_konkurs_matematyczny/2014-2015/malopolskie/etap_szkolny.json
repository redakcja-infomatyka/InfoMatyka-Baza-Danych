   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Bok kwadratu: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><msqrt><mn>4 900</mn></msqrt><mo>=</mo><mn>70</mn></mrow></math> m. Obwód: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>4</mn><mo>·</mo><mn>70</mn><mo>=</mo><mn>280</mn></mrow></math> m.</p>"
