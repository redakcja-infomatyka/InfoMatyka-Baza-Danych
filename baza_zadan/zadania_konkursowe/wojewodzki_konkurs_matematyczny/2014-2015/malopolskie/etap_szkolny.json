    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Pojemność zbiornika: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>15</mn><mo>·</mo><mn>8</mn><mo>·</mo><mn>2</mn><mo>=</mo><mn>240</mn></mrow></math> m³. Woda sięga 0,9 głębokości, więc pusta pozostaje warstwa <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo>(</mo><mn>1</mn><mo>−</mo><mn>0,9</mn><mo>)</mo><mo>·</mo><mn>2</mn><mo>=</mo><mn>0,2</mn></mrow></math> m. Zmieści się jeszcze <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>15</mn><mo>·</mo><mn>8</mn><mo>·</mo><mn>0,2</mn><mo>=</mo><mn>24</mn></mrow></math> m³ wody.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "wolna jest 0,1 głębokości, czyli warstwa wysokości 0,2 m nad całym dnem",
