    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Liczby przeciwne sumują się do zera: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>11</mn><mo>−</mo><mi>k</mi><mo>)</mo><mo>+</mo><mo>(</mo><mn>19</mn><mo>−</mo><mi>k</mi><mo>)</mo><mo>=</mo><mn>0</mn></math>, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>30</mn><mo>−</mo><mn>2</mn><mi>k</mi><mo>=</mo><mn>0</mn></math>, stąd <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>k</mi><mo>=</mo><mn>15</mn></math>.</p>"
