 "zadania": [
  {
   "id": "rejonowy_2014_podlaskie_gim_q1",
   "numer": 1,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "okrąg wpisany i opisany",
    "pole i obwód"
   ],
   "tresc_html": "<p>Na kole o polu <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mi>π</mi></math> cm² opisano kwadrat. Pole tego kwadratu jest równe</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "3 cm²"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><msqrt><mn>3</mn></msqrt></math> cm²"
    },
    {
     "litera": "C",
     "html": "12 cm²"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>12</mn><mi>π</mi></math> cm²"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Z pola koła <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mi>π</mi></math> wynika <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>r</mi><mn>2</mn></msup><mo>=</mo><mn>3</mn></math>. Bok kwadratu opisanego na kole to średnica: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><msqrt><mn>3</mn></msqrt></math>. Pole kwadratu: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mrow><mo>(</mo><mn>2</mn><msqrt><mn>3</mn></msqrt><mo>)</mo></mrow><mn>2</mn></msup><mo>=</mo><mn>12</mn></math> cm².</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "bok kwadratu to 2r, więc pole liczysz z r² bez wyciągania pierwiastka",
   "czas_min": 2
  },
  {
   "id": "rejonowy_2014_podlaskie_gim_q2",
   "numer": 2,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "twierdzenie Pitagorasa",
    "trójkąty o kątach 30-60-90 i 45-45-90",
    "czworokąty",
    "trójkąty"
   ],
   "tresc_html": "<p>W trapezie równoramiennym ramię o długości <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><msqrt><mn>2</mn></msqrt></math> tworzy z podstawą o długości 17 cm kąt 45°. Przekątna tego trapezu ma długość</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><msqrt><mn>2</mn></msqrt></math> cm"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mn>74</mn></msqrt></math> cm"
    },
    {
     "litera": "C",
     "html": "13 cm"
    },
    {
     "litera": "D",
     "html": "16 cm"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Rzut ramienia na podstawę i wysokość trapezu są równe: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><msqrt><mn>2</mn></msqrt><mo>·</mo><mi>cos</mi><mn>45</mn>°<mo>=</mo><mn>5</mn></math>. Przekątna jest przeciwprostokątną trójkąta o przyprostokątnych <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>17</mn><mo>−</mo><mn>5</mn><mo>=</mo><mn>12</mn></math> i 5: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><msup><mn>12</mn><mn>2</mn></msup><mo>+</mo><msup><mn>5</mn><mn>2</mn></msup></msqrt><mo>=</mo><mn>13</mn></math> cm.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "przy kącie 45° wysokość i rzut ramienia są równe, potem Pitagoras dla przekątnej",
   "czas_min": 2
  },
  {
   "id": "rejonowy_2014_podlaskie_gim_q3",
   "numer": 3,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
