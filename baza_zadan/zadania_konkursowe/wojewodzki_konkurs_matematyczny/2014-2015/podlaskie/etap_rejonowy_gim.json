    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Z tw. Pitagorasa: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>c</mi><mn>2</mn></msup><mo>=</mo><msup><mrow><mo>(</mo><mn>5</mn><mo>+</mo><msqrt><mn>7</mn></msqrt><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mrow><mo>(</mo><mn>5</mn><mo>−</mo><msqrt><mn>7</mn></msqrt><mo>)</mo></mrow><mn>2</mn></msup><mo>=</mo><mn>64</mn></math>, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>c</mi><mo>=</mo><mn>8</mn></math>.</p>"
   },
   "w_pamieci": "pomysl",
   "wskazowka": "dodaj kwadraty obu przyprostokątnych — podwójne iloczyny się zniosą",
   "czas_min": 2
  },
  {
