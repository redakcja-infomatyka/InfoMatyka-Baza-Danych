   ],
   "tresc_html": "<p>Przeciwprostokątna trójkąta prostokątnego o przyprostokątnych <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><mo>+</mo><msqrt><mn>7</mn></msqrt></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><mo>−</mo><msqrt><mn>7</mn></msqrt></math> ma długość</p>",
   "warianty": [
