   "tresc_html": "<p>Suma <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>11</mn><mn>3</mn></msup><mo>+</mo><msup><mn>12</mn><mn>3</mn></msup><mo>+</mo><msup><mn>13</mn><mn>3</mn></msup><mo>+</mo><msup><mn>14</mn><mn>3</mn></msup></math> jest równa</p>",
   "warianty": [
