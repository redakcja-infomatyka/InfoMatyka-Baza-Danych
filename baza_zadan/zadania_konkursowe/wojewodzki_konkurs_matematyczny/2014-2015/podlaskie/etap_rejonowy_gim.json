    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Z równania <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>,</mo><mn>35</mn><mi>V</mi><mo>+</mo><mn>12</mn><mo>=</mo><mn>0</mn><mo>,</mo><mn>6</mn><mi>V</mi></math> wynika <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>,</mo><mn>25</mn><mi>V</mi><mo>=</mo><mn>12</mn></math>, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>V</mi><mo>=</mo><mn>48</mn></math> litrów.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "dolane 12 litrów odpowiada różnicy procentów napełnienia",
   "czas_min": 2
  },
  {
   "id": "rejonowy_2014_podlaskie_gim_q6",
   "numer": 6,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "potęgi i pierwiastki"
