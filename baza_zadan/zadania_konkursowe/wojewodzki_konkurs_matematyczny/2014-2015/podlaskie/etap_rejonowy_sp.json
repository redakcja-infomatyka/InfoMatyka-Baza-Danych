     "html": "900 zł"
    },
    {
     "litera": "D",
     "html": "1200 zł"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Brat: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>500</mn><mo>·</mo><mn>1,4</mn><mo>=</mo><mn>700</mn></mrow></math> zł. Razem: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>500</mn><mo>+</mo><mn>700</mn><mo>=</mo><mn>1200</mn></mrow></math> zł.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "najpierw policz, ile ma brat, dopiero potem dodaj obie kwoty",
