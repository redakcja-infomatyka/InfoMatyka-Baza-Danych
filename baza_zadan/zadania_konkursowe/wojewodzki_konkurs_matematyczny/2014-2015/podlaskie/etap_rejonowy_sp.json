   ],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Lewy trójkąt: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>180</mn><mo>°</mo><mo>−</mo><mn>90</mn><mo>°</mo><mo>−</mo><mn>25</mn><mo>°</mo><mo>=</mo><mn>65</mn><mo>°</mo></mrow></math> — to (kąt wierzchołkowy) kąt podstawy trójkąta z wierzchołkiem 60°. Drugi kąt podstawy: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>180</mn><mo>°</mo><mo>−</mo><mn>60</mn><mo>°</mo><mo>−</mo><mn>65</mn><mo>°</mo><mo>=</mo><mn>55</mn><mo>°</mo></mrow></math>, znów wierzchołkowy, jest kątem podstawy trójkąta z kątem 40°. Stąd <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>x</mi><mo>=</mo><mn>180</mn><mo>°</mo><mo>−</mo><mn>55</mn><mo>°</mo><mo>−</mo><mn>40</mn><mo>°</mo><mo>=</mo><mn>85</mn><mo>°</mo></mrow></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "idź trójkąt po trójkącie, a przez punkty przecięcia przenoś kąty wierzchołkowe",
   "czas_min": 2
  },
  {
   "id": "rejonowy_2014_podlaskie_sp_q5",
   "numer": 5,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "podobieństwo i skala"
   ],
   "tresc_html": "<p>Odległość z Dąbrowy do Lipnicy na mapie w skali 1:8000000 jest równa 15 mm. Jaka jest rzeczywista odległość między tymi miejscowościami?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "1,2 km"
    },
    {
     "litera": "B",
     "html": "12 km"
    },
    {
     "litera": "C",
     "html": "120 km"
    },
    {
     "litera": "D",
     "html": "1200 km"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Rzeczywista odległość: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>15</mn><mo>·</mo><mn>8000000</mn><mo>=</mo><mn>120000000</mn></mrow></math> mm, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>120000000</mn><mo>:</mo><mn>1000000</mn><mo>=</mo><mn>120</mn></mrow></math> km.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "pomnóż 15 mm przez skalę, a dopiero potem zamień milimetry na kilometry",
   "czas_min": 2
  },
  {
   "id": "rejonowy_2014_podlaskie_sp_q6",
   "numer": 6,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "kalendarz i czas"
   ],
   "tresc_html": "<p>Ania wyjechała na wakacje 26 lipca, a wróciła 18 sierpnia tego samego roku. Ile czasu nocowała poza domem?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "3 tygodnie i 2 dni."
    },
    {
     "litera": "B",
     "html": "3 tygodnie i 3 dni."
    },
    {
     "litera": "C",
     "html": "3 tygodnie i 4 dni."
    },
    {
     "litera": "D",
     "html": "3 tygodnie i 5 dni."
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Od 26 lipca do końca lipca: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>31</mn><mo>−</mo><mn>26</mn><mo>=</mo><mn>5</mn></mrow></math> nocy, plus 18 nocy sierpnia. Razem: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>5</mn><mo>+</mo><mn>18</mn><mo>=</mo><mn>23</mn></mrow></math> noce, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>23</mn><mo>=</mo><mn>3</mn><mo>·</mo><mn>7</mn><mo>+</mo><mn>2</mn></mrow></math> — 3 tygodnie i 2 dni.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "policz noce, nie dni — zacznij od tego, ile dni zostało do końca lipca",
   "czas_min": 2,
   "haczyk": {
    "sila": 2,
    "rodzaje": [
     "plot-i-slupki",
     "kalendarz-czas"
    ],
    "opis": "Pytanie o noce poza domem, a nie o dni pobytu liczone włącznie; lipiec ma 31 dni."
   }
  },
  {
