   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Bok 1 dm = 10 cm. Z pola rombu: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mn>10</mn><mo>·</mo><mi>d</mi></mrow><mn>2</mn></mfrac><mo>=</mo><mn>62</mn></mrow></math>, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>d</mi><mo>=</mo><mfrac><mrow><mn>2</mn><mo>·</mo><mn>62</mn></mrow><mn>10</mn></mfrac><mo>=</mo><mn>12,4</mn></mrow></math> cm.</p>"
   },
