   "punkty": 1,
   "tematy": [
    "bryły obrotowe"
   ],
   "tresc_html": "<p>Sznur korali składa się z osiemdziesięciu ściśle do siebie przylegających kulistych koralików. Pięćdziesiąt z nich ma promień 6 mm, a pozostałe są trzy razy mniejsze. Jaka jest długość tego sznura korali?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "36 cm"
    },
    {
     "litera": "B",
     "html": "72 cm"
    },
    {
     "litera": "C",
     "html": "82 cm"
    },
    {
     "litera": "D",
     "html": "90 cm"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Mniejsze koraliki mają promień <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>6</mn><mo>:</mo><mn>3</mn><mo>=</mo><mn>2</mn></mrow></math> mm, czyli średnicę 4 mm; większe mają średnicę 12 mm. Długość sznura: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>50</mn><mo>·</mo><mn>12</mn><mo>+</mo><mn>30</mn><mo>·</mo><mn>4</mn><mo>=</mo><mn>720</mn></mrow></math> mm, czyli 72 cm.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "liczy się średnica koralika, nie promień",
   "czas_min": 2,
   "haczyk": {
    "sila": 2,
    "rodzaje": [
     "inne:promien-a-srednica"
    ],
    "opis": "Podany jest promień koralika, a na długość sznura składają się średnice."
   }
  },
