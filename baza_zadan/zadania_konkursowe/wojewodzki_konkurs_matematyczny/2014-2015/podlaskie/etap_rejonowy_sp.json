    },
    {
     "litera": "B",
     "html": "66"
    },
    {
     "litera": "C",
     "html": "66,6"
    },
    {
     "litera": "D",
     "html": "96"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Różnica: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>7</mn><mo>−</mo><mn>4,8</mn><mo>=</mo><mn>2,2</mn></mrow></math>. Suma: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>12,4</mn><mo>+</mo><mn>17,6</mn><mo>=</mo><mn>30</mn></mrow></math>. Iloczyn: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>2,2</mn><mo>·</mo><mn>30</mn><mo>=</mo><mn>66</mn></mrow></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "zamień 17 3/5 na ułamek dziesiętny i najpierw dodaj to, co w nawiasie",
   "czas_min": 1
  },
