   "tresc_html": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtext>NWW</mtext><mo>(</mo><mn>36</mn><mo>,</mo><mn>45</mn><mo>,</mo><mn>27</mn><mo>)</mo></math> to:</p>",
