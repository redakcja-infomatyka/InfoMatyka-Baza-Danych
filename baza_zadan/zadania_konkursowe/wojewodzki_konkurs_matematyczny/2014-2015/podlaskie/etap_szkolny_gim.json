    "porównywanie potęg i pierwiastków"
   ],
   "tresc_html": "<p>Wśród liczb <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>2</mn><mn>600</mn></msup></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>3</mn><mn>500</mn></msup></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>4</mn><mn>400</mn></msup></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>7</mn><mn>100</mn></msup></math> największą jest</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>7</mn><mn>100</mn></msup></math>"
    },
    {
