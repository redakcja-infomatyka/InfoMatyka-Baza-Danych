   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Sprowadzam do wykładnika 100: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>2</mn><mn>600</mn></msup><mo>=</mo><msup><mn>64</mn><mn>100</mn></msup></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>3</mn><mn>500</mn></msup><mo>=</mo><msup><mn>243</mn><mn>100</mn></msup></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>4</mn><mn>400</mn></msup><mo>=</mo><msup><mn>256</mn><mn>100</mn></msup></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>7</mn><mn>100</mn></msup></math>. Największa podstawa 256, więc największa jest <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>4</mn><mn>400</mn></msup></math> (opcja C).</p>"
   },
   "w_pamieci": "pomysl",
   "wskazowka": "wszystkie wykładniki są wielokrotnościami 100 — sprowadź je do setnej potęgi i porównaj podstawy",
   "czas_min": 2
  },
