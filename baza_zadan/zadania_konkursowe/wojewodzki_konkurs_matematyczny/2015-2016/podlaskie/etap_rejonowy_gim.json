    "rozwiazanie_ai_html": "<p>Podnosząc sumę do kwadratu: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mrow><mo>(</mo><msqrt><mrow><mn>3</mn><mo>−</mo><msqrt><mn>5</mn></msqrt></mrow></msqrt><mo>+</mo><msqrt><mrow><mn>3</mn><mo>+</mo><msqrt><mn>5</mn></msqrt></mrow></msqrt><mo>)</mo></mrow><mn>2</mn></msup><mo>=</mo><mo>(</mo><mn>3</mn><mo>−</mo><msqrt><mn>5</mn></msqrt><mo>)</mo><mo>+</mo><mo>(</mo><mn>3</mn><mo>+</mo><msqrt><mn>5</mn></msqrt><mo>)</mo><mo>+</mo><mn>2</mn><msqrt><mrow><mo>(</mo><mn>3</mn><mo>−</mo><msqrt><mn>5</mn></msqrt><mo>)</mo><mo>(</mo><mn>3</mn><mo>+</mo><msqrt><mn>5</mn></msqrt><mo>)</mo></mrow></msqrt></math>.</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>6</mn><mo>+</mo><mn>2</mn><msqrt><mrow><mn>9</mn><mo>−</mo><mn>5</mn></mrow></msqrt><mo>=</mo><mn>6</mn><mo>+</mo><mn>4</mn><mo>=</mo><mn>10</mn></math>.</p>"
