    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Niech waga Izy to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math>. Wtedy Ola waży <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>x</mi></math>, a Ela <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mi>x</mi></math>. Suma: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>7</mn><mi>x</mi><mo>=</mo><mn>84</mn></math>, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mn>12</mn></math>.</p><p>Ela waży <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mo>·</mo><mn>12</mn><mo>=</mo><mn>48</mn></math> kg.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "przyjmij wagę Izy za jednostkę i policz, ile takich jednostek ważą razem",
