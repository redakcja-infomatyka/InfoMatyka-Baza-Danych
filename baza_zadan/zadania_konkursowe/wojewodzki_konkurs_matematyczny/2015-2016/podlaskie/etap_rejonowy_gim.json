   "tresc_html": "<p>Funkcję liniową, której wykres jest równoległy do wykresu funkcji <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><mo>−</mo><msqrt><mn>3</mn></msqrt><mi>x</mi><mo>+</mo><mn>1</mn></math> i przechodzi przez punkt <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>0</mn><mo>,</mo><mo>−</mo><mn>5</mn><mo>)</mo></math> określa wzór</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><mo>−</mo><mn>5</mn><mo>+</mo><msqrt><mn>3</mn></msqrt><mi>x</mi></math>"
    },
