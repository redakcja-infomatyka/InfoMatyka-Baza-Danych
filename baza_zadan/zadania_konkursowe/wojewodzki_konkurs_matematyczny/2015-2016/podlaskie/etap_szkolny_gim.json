   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Graniastosłup o n-kątnej podstawie ma 3n krawędzi (n na dole, n na górze, n bocznych) i 2n wierzchołków. Z <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mi>n</mi><mo>=</mo><mn>54</mn></math> mamy n=18, więc wierzchołków jest <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>·</mo><mn>18</mn><mo>=</mo><mn>36</mn></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "graniastosłup ma 3 razy tyle krawędzi, co boków podstawy",
   "czas_min": 1,
