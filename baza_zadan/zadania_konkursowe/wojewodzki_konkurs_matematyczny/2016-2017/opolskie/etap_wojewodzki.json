  {
   "id": "wojewodzki_2017_opolskie_q9",
   "numer": 9,
   "typ": "otwarte",
   "punkty": 5,
   "tematy": [
    "prędkość / droga / czas",
    "układy równań"
   ],
   "tresc_html": "<p>Pociąg mija obserwatora w czasie 8 sekund. Ten sam pociąg jadąc z taką samą prędkością mija peron o długości 400 m w czasie 48 sekund. Oblicz długość pociągu i prędkość, z jaką mijał stację. Prędkość wyraź w kilometrach na godzinę.</p>",
   "warianty": [],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "długość 80 m, prędkość 36 km/h",
    "zrodlo": "klucz",
    "rozwiazanie_html": "<p>Niech <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>v</mi></math> (w m/s) oznacza prędkość pociągu, a <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>L</mi></math> jego długość. Mijając obserwatora pociąg pokonuje własną długość: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>L</mi><mo>=</mo><mn>8</mn><mi>v</mi></mrow></math>. Mijając peron pokonuje drogę <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>L</mi><mo>+</mo><mn>400</mn></mrow></math> w 48 s: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>L</mi><mo>+</mo><mn>400</mn><mo>=</mo><mn>48</mn><mi>v</mi></mrow></math>. Odejmując równania stronami: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>400</mn><mo>=</mo><mn>40</mn><mi>v</mi></mrow></math>, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>v</mi><mo>=</mo><mn>10</mn></mrow></math> m/s <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo></math> 36 km/h, a <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>L</mi><mo>=</mo><mn>8</mn><mo>·</mo><mn>10</mn><mo>=</mo><mn>80</mn></mrow></math> m.</p>"
   },
   "w_pamieci": "pomysl",
   "wskazowka": "porównaj oba czasy — nadwyżka czasu przypada dokładnie na przejechanie peronu",
