  {
   "id": "szkolny_2016_podlaskie_q14",
   "numer": 14,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "koła / okręgi"
   ],
   "tresc_html": "<p>Suma długości średnic dwóch okręgów jest równa 120 cm. Promień jednego z tych okręgów jest równy średnicy drugiego. Długość średnicy mniejszego okręgu jest równa</p>",
   "warianty": [
    {
