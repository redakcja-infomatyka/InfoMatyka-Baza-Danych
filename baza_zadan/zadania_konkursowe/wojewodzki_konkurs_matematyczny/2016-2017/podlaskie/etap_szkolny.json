  {
   "id": "szkolny_2016_podlaskie_q5",
   "numer": 5,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "zadania tekstowe na równania",
    "równania z jedną zmienną"
   ],
   "tresc_html": "<p>Na tablicy narysowano rozłączne figury w kształcie kwadratów oraz trójkątów. Łączna liczba wierzchołków wszystkich figur jest równa 17. Ile trójkątów narysowano na tablicy?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "1"
    },
    {
     "litera": "B",
     "html": "2"
    },
    {
     "litera": "C",
     "html": "3"
    },
    {
     "litera": "D",
     "html": "4"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Niech <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>s</mi></math> to liczba kwadratów, a <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>t</mi></math> — trójkątów: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>4</mn><mi>s</mi><mo>+</mo><mn>3</mn><mi>t</mi><mo>=</mo><mn>17</mn></mrow></math>.</p><p>Sprawdzając <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>t</mi><mo>=</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mo>…</mo><mo>,</mo><mn>5</mn></mrow></math>, tylko <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>t</mi><mo>=</mo><mn>3</mn></mrow></math> daje całkowite <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>s</mi><mo>=</mo><mn>2</mn></mrow></math>, więc narysowano 3 trójkąty.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "kwadrat daje 4 wierzchołki, trójkąt 3 — sprawdzaj kolejne liczby kwadratów",
   "czas_min": 2
  },
  {
