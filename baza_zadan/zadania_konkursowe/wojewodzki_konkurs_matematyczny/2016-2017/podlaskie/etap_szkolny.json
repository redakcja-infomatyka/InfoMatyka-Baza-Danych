     "litera": "C",
     "html": "siedmiokąt."
    },
    {
     "litera": "D",
     "html": "ośmiokąt."
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Dla n-kąta liczba boków i przekątnych to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>n</mi><mo>+</mo><mfrac><mrow><mi>n</mi><mrow><mo>(</mo><mi>n</mi><mo>−</mo><mn>3</mn><mo>)</mo></mrow></mrow><mn>2</mn></mfrac></mrow></math>.</p><p>Dla sześciokąta (<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>n</mi><mo>=</mo><mn>6</mn></mrow></math>): <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>6</mn><mo>+</mo><mfrac><mrow><mn>6</mn><mo>·</mo><mn>3</mn></mrow><mn>2</mn></mfrac><mo>=</mo><mn>6</mn><mo>+</mo><mn>9</mn><mo>=</mo><mn>15</mn></mrow></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "boki i przekątne razem to wszystkie odcinki łączące pary wierzchołków",
   "czas_min": 2
  },
  {
