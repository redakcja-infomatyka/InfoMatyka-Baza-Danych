    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Szerokość <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>w</mi></math>, długość <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>3</mn><mi>w</mi></mrow></math>: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>w</mi><mo>·</mo><mn>3</mn><mi>w</mi><mo>=</mo><mn>48</mn></mrow></math>, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><msup><mi>w</mi><mn>2</mn></msup><mo>=</mo><mn>16</mn></mrow></math>.</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>w</mi><mo>=</mo><mn>4</mn></mrow></math> cm.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "podziel pole przez 3 — zostanie kwadrat krótszego boku",
   "czas_min": 1
