    },
    {
     "litera": "B",
     "html": "5 cm"
    },
    {
     "litera": "C",
     "html": "6 cm"
    },
    {
     "litera": "D",
     "html": "7 cm"
    }
   ],
   "rysunki": [
    "rysunki/szkolny_2016_podlaskie_q3_fig1.svg"
   ],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Obwód trójkąta: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>3</mn><mo>·</mo><mn>12</mn><mo>=</mo><mn>36</mn></mrow></math> cm — taki sam ma prostokąt.</p><p>Bok prostokąta wspólny z bokiem trójkąta ma 12 cm, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>2</mn><mo>·</mo><mrow><mo>(</mo><mn>12</mn><mo>+</mo><mi>b</mi><mo>)</mo></mrow><mo>=</mo><mn>36</mn></mrow></math>, skąd <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>b</mi><mo>=</mo><mn>6</mn></mrow></math> cm.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "obwód trójkąta policz z boku 12 cm, a dłuższy bok prostokąta odczytaj z rysunku",
   "czas_min": 2
  },
  {
