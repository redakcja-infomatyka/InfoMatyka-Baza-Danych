   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>9999</mn><mo>:</mo><mn>36</mn><mo>≈</mo><mn>277,75</mn></mrow></math>, więc sprawdzamy <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>277</mn><mo>·</mo><mn>36</mn><mo>=</mo><mn>9972</mn></mrow></math> — to szukana liczba.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "podziel 9999 przez 36 i odrzuć resztę",
   "czas_min": 2
