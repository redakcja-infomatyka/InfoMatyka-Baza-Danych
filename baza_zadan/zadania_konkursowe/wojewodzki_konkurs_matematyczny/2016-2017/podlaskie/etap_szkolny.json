    },
    {
     "litera": "B",
     "html": "11:52"
    },
    {
     "litera": "C",
     "html": "23:52"
    },
    {
     "litera": "D",
     "html": "23:53"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>W ciągu doby zegar spóźni się <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>24</mn><mo>·</mo><mn>20</mn><mo>=</mo><mn>480</mn></mrow></math> s, czyli 8 minut.</p><p>Po upływie doby prawdziwy czas to znów 12:00, więc zegar pokazuje 8 minut mniej, czyli 11:52.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "policz, ile sekund spóźnienia zbiera się przez 24 godziny, i zamień je na minuty",
   "czas_min": 1,
   "haczyk": {
    "sila": 2,
    "rodzaje": [
     "kalendarz-czas"
    ],
    "opis": "Doba liczona od południa kończy się znów w południe, nie o północy; warianty kuszą godziną wieczorną"
   }
  },
  {
