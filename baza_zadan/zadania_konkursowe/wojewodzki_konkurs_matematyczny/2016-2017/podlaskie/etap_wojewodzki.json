    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Prostokąt złożony z dwóch kwadratów o boku <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> ma wymiary <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>a</mi></math> na <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math>, a obwód <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>(</mo><mn>2</mn><mi>a</mi><mo>+</mo><mi>a</mi><mo>)</mo><mo>=</mo><mn>6</mn><mi>a</mi><mo>=</mo><mn>66</mn></math> cm, skąd <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mn>11</mn></math> cm. Pole: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>a</mi><mo>·</mo><mi>a</mi><mo>=</mo><mn>2</mn><mo>·</mo><mn>121</mn><mo>=</mo><mn>242</mn></math> cm².</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "obwód tego prostokąta to sześć boków kwadratu",
   "czas_min": 1
  },
  {
   "id": "wojewodzki_2016_podlaskie_q9",
