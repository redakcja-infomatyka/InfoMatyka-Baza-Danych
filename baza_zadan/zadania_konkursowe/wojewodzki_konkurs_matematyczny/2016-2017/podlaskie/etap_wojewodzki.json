  {
   "id": "wojewodzki_2016_podlaskie_q20",
   "numer": 20,
   "typ": "otwarte",
   "punkty": 3,
   "tematy": [
    "zadania tekstowe na równania",
    "równania z jedną zmienną"
   ],
   "tresc_html": "<p>Cena biletu do muzeum dla osoby dorosłej jest równa 12 zł, a dla dziecka 8 zł. Pewnego dnia muzeum zwiedziło 80 osób, płacąc za bilety 720 zł. Ile dzieci było tego dnia w tym muzeum?</p>",
   "warianty": [],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "60 dzieci",
    "zrodlo": "klucz",
    "rozwiazanie_html": "<p>Niech <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> oznacza liczbę dzieci, wtedy dorosłych było <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>80</mn><mo>−</mo><mi>x</mi></math>. Z warunku dotyczącego zapłaty za bilety: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>12</mn><mo>(</mo><mn>80</mn><mo>−</mo><mi>x</mi><mo>)</mo><mo>+</mo><mn>8</mn><mi>x</mi><mo>=</mo><mn>720</mn></math>, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>960</mn><mo>−</mo><mn>4</mn><mi>x</mi><mo>=</mo><mn>720</mn></math>, skąd <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mi>x</mi><mo>=</mo><mn>240</mn></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mn>60</mn></math>. Odpowiedź: bilety kupiło 60 dzieci.</p>"
   },
   "w_pamieci": "pomysl",
   "wskazowka": "policz, ile kosztowałyby bilety, gdyby wszyscy byli dorośli, i zobacz różnicę",
   "czas_min": 5
  },
  {
