     "html": "250 m"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Bok kwadratu w rysunku: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mn>100</mn></msqrt><mo>=</mo><mn>10</mn></math> cm. W skali 1:50 odpowiada to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><mo>·</mo><mn>50</mn><mo>=</mo><mn>500</mn></math> cm, czyli 5 m. Obwód kwadratu rzeczywistego: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mo>·</mo><mn>5</mn><mo>=</mo><mn>20</mn></math> m.</p>"
