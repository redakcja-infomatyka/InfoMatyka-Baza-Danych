    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Wystarczy wybrać trójkę spośród 5 osób — pozostała dwójka tworzy drugi zespół. Liczba sposobów: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>5</mn><mo>·</mo><mn>4</mn><mo>·</mo><mn>3</mn></mrow><mrow><mn>3</mn><mo>·</mo><mn>2</mn><mo>·</mo><mn>1</mn></mrow></mfrac><mo>=</mo><mn>10</mn></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "wystarczy wybrać zespół dwuosobowy — reszta tworzy drugi",
   "czas_min": 2
