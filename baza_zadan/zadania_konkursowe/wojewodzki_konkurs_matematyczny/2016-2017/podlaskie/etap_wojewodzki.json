   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "podobieństwo i skala",
    "pole i obwód"
   ],
   "tresc_html": "<p>Pole kwadratu narysowanego w skali 1:50 jest równe 100 cm². Obwód tego kwadratu w skali 1:1 jest równy</p>",
   "warianty": [
