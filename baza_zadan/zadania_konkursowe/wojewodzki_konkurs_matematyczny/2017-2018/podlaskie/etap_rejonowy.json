   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Suma części stosunku: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>+</mo><mn>5</mn><mo>+</mo><mn>6</mn><mo>=</mo><mn>12</mn></math>. Jedna część: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>180</mn><mo>:</mo><mn>12</mn><mo>=</mo><mn>15</mn></math>°, więc kąty mają 15°, 75° i 90°. Kąt 90° oznacza trójkąt prostokątny.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "1+5+6 to liczba części, na które dzielisz 180°",
   "czas_min": 2
