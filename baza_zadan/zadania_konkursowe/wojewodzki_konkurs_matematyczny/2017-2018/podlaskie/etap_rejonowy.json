    "rozwiazanie_ai_html": "<p>Szukamy <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi></math> takiego, że <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mi>n</mi><mo>=</mo><msup><mn>6</mn><mn>3</mn></msup><mo>=</mo><mn>216</mn></math>. Stąd <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi><mo>=</mo><mn>216</mn><mo>:</mo><mn>6</mn><mo>=</mo><mn>36</mn></math>.</p>"
   },
