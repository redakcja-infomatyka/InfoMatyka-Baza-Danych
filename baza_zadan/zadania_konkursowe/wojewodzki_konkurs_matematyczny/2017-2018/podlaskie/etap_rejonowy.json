   "numer": 2,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "ułamki"
   ],
   "tresc_html": "<p>Suma różnicy liczb <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4,2</mn></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>2</mn><mn>3</mn></mfrac></math> oraz iloczynu tych liczb jest równa</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>11</mn><mn>15</mn></mfrac></math>"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mfrac><mn>1</mn><mn>3</mn></mfrac></math>"
    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mfrac><mn>13</mn><mn>15</mn></mfrac></math>"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>15</mn><mfrac><mn>13</mn><mn>15</mn></mfrac></math>"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Różnica: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4,2</mn><mo>−</mo><mfrac><mn>2</mn><mn>3</mn></mfrac><mo>=</mo><mfrac><mn>53</mn><mn>15</mn></mfrac></math>. Iloczyn: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4,2</mn><mo>·</mo><mfrac><mn>2</mn><mn>3</mn></mfrac><mo>=</mo><mn>2,8</mn></math>. Suma: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>53</mn><mn>15</mn></mfrac><mo>+</mo><mn>2,8</mn><mo>=</mo><mfrac><mn>95</mn><mn>15</mn></mfrac><mo>=</mo><mn>6</mn><mfrac><mn>1</mn><mn>3</mn></mfrac></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "policz osobno różnicę i iloczyn; 4,2 to 21/5, więc wygodny mianownik to 15",
   "czas_min": 2
  },
  {
