   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Niech <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>k</mi></math> oznacza wiek Kasi. <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>k</mi><mo>+</mo><mo>(</mo><mi>k</mi><mo>+</mo><mn>15</mn><mo>)</mo><mo>=</mo><mn>55</mn></mrow></math>, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>2</mn><mi>k</mi><mo>=</mo><mn>40</mn></mrow></math>, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>k</mi><mo>=</mo><mn>20</mn></mrow></math> lat.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "odejmij różnicę wieku od sumy — zostaną dwa równe wieki",
   "czas_min": 1,
