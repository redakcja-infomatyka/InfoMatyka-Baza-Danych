   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "inne"
   ],
   "tresc_html": "<p>Wynik działania <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>12</mn><mo>−</mo><mn>16</mn><mo>+</mo><mn>58</mn><mo>−</mo><mn>34</mn></mrow></math> jest równy</p>",
   "warianty": [
