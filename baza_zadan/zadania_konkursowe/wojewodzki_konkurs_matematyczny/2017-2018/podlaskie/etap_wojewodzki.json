  {
   "id": "wojewodzki_2017_podlaskie_q10",
   "numer": 10,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "wędrówka kąta",
    "kąty",
    "trójkąty"
   ],
   "tresc_html": "<p>Kąt <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>BAC</mi></math> trójkąta <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>ABC</mi></math> ma miarę 120°, a kąt <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>ABC</mi></math> ma 20°. Punkt <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>M</mi></math> leży na boku <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>AB</mi></math> tego trójkąta tak, że odcinki <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>BM</mi></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>MC</mi></math> mają równą długość. Największy kąt trójkąta <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>MBC</mi></math> ma</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "90°"
    },
    {
     "litera": "B",
