    },
    {
     "litera": "C",
     "html": "120°"
    },
    {
     "litera": "D",
     "html": "140°"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Kąt ACB = 180°−120°−20° = 40°. Ponieważ M leży na AB, kąt MBC = kąt ABC = 20°. Trójkąt MBC ma BM = MC, więc jest równoramienny i kąt MCB = kąt MBC = 20°. Stąd kąt BMC = 180°−20°−20° = 140° — to kąt największy.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "trójkąt MBC jest równoramienny, więc kąty przy boku BC są równe",
   "czas_min": 2
