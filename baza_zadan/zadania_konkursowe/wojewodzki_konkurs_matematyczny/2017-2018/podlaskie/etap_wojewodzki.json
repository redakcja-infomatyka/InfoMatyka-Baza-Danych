     "html": "4 m i 12 m"
    },
    {
     "litera": "C",
     "html": "40 m i 120 m"
    },
    {
     "litera": "D",
     "html": "600 m i 1800 m"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Powierzchnia 0,48 ha = 4800 m². Niech szerokość = w, długość = 3w: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><msup><mi>w</mi><mn>2</mn></msup><mo>=</mo><mn>4800</mn></math>, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>w</mi><mn>2</mn></msup><mo>=</mo><mn>1600</mn></math>, w = 40 m, długość = 120 m.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "1 ha to 10000 m² — potem szerokość razy jej trzykrotność daje pole",
   "czas_min": 2,
   "haczyk": {
    "sila": 2,
    "rodzaje": [
     "jednostki"
    ],
    "opis": "Pole podane w hektarach, wymiary w metrach: trzeba pamiętać, ile m² ma hektar"
   }
  },
  {
   "id": "wojewodzki_2017_podlaskie_q15",
   "numer": 15,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
