    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Ponieważ <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>32</mn><mo>=</mo><mn>3,2</mn><mo>·</mo><mn>10</mn></math>, mamy <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>32</mn><mn>3</mn></msup><mo>=</mo><msup><mrow><mo>(</mo><mn>3,2</mn><mo>·</mo><mn>10</mn><mo>)</mo></mrow><mn>3</mn></msup><mo>=</mo><msup><mrow><mo>(</mo><mn>3,2</mn><mo>)</mo></mrow><mn>3</mn></msup><mo>·</mo><msup><mn>10</mn><mn>3</mn></msup></math>. Zatem <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mrow><mo>(</mo><mn>3,2</mn><mo>)</mo></mrow><mn>3</mn></msup></math> jest <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>10</mn><mn>3</mn></msup></math> razy mniejsza od <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>32</mn><mn>3</mn></msup></math>.</p>"
   },
   "w_pamieci": "pomysl",
   "wskazowka": "nie licz sześcianów — porównaj same podstawy i ich iloraz podnieś do trzeciej",
