     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>(</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo>)</mo></math>"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>(</mo><mi>n</mi><mo>+</mo><mn>2</mn><mo>)</mo></math>"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Graniastosłup ma <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>k</mi></math>-kątne podstawy i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>k</mi></math> ścian bocznych, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi><mo>=</mo><mi>k</mi><mo>+</mo><mn>2</mn></math>, stąd <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>k</mi><mo>=</mo><mi>n</mi><mo>&#8722;</mo><mn>2</mn></math>. Wierzchołków jest <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>k</mi><mo>=</mo><mn>2</mn><mo>(</mo><mi>n</mi><mo>&#8722;</mo><mn>2</mn><mo>)</mo></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "ścian bocznych jest tyle, ile boków ma podstawa",
