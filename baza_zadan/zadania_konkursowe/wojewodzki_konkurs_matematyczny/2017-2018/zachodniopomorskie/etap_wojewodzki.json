    "działania na potęgach"
   ],
   "tresc_html": "<p>Liczba <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> jest liczbą odwrotną do <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>2</mn></mfrac></math>, natomiast <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math> liczbą przeciwną do <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>2</mn></mfrac></math>. Iloraz potęg <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>a</mi><mn>3</mn></msup></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>b</mi><mn>3</mn></msup></math> jest równy:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo>−</mo><mn>64</mn></mrow></math>"
    },
    {
     "litera": "B",
     "html": "64"
    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo>−</mo><mfrac><mn>1</mn><mn>64</mn></mfrac></mrow></math>"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>64</mn></mfrac></math>"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Odwrotność <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>2</mn></mfrac></math> to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mn>2</mn></math>, liczba przeciwna to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi><mo>=</mo><mo>&#8722;</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></math>. Iloraz: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>2</mn><mn>3</mn></msup><mo>:</mo><msup><mrow><mo>(</mo><mo>&#8722;</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>)</mo></mrow><mn>3</mn></msup><mo>=</mo><mn>8</mn><mo>:</mo><mo>(</mo><mo>&#8722;</mo><mfrac><mn>1</mn><mn>8</mn></mfrac><mo>)</mo><mo>=</mo><mo>&#8722;</mo><mn>64</mn></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "ustal a i b z definicji, a potem podnieś ich iloraz do sześcianu",
   "czas_min": 1
  },
  {
