  {
   "id": "szkolny_2019_kujawsko-pomorskie_q8",
   "numer": 8,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "zmiany procentowe"
   ],
   "tresc_html": "<p>Jabłka są o 20% tańsze od wiśni, natomiast czereśnie są o 40% droższe od wiśni. O ile procent czereśnie są droższe od jabłek?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "50%"
