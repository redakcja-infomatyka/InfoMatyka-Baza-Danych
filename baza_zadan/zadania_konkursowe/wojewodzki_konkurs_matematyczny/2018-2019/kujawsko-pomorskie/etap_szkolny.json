   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Odcinki oznaczone <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> tworzą dwa trójkąty równoramienne o wspólnym wierzchołku w punkcie przecięcia prostych. Kąt przy tym punkcie w dolnym trójkącie: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>180</mn><mo>°</mo><mo>−</mo><mn>2</mn><mo>·</mo><mn>52</mn><mo>°</mo><mo>=</mo><mn>76</mn><mo>°</mo></math> — to kąt wierzchołkowy do kąta przy tym punkcie w górnym trójkącie. Zatem <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>α</mi><mo>=</mo><mn>180</mn><mo>°</mo><mo>−</mo><mn>2</mn><mo>·</mo><mn>76</mn><mo>°</mo><mo>=</mo><mn>28</mn><mo>°</mo></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "wszystkie odcinki a są równe — użyj trójkątów równoramiennych i kątów wierzchołkowych",
   "czas_min": 2,
   "haczyk": {
    "sila": 2,
    "rodzaje": [
     "rysunek"
    ],
    "opis": "Trzeba odczytać, w którym wierzchołku spotykają się równe odcinki a w każdym trójkącie"
   }
