     "html": "60%"
    },
    {
     "litera": "D",
     "html": "80%"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Niech wiśnie kosztują 100 zł. Jabłka: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0,8</mn><mo>·</mo><mn>100</mn><mo>=</mo><mn>80</mn></math> zł, czereśnie: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1,4</mn><mo>·</mo><mn>100</mn><mo>=</mo><mn>140</mn></math> zł. Czereśnie są droższe od jabłek o <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>140</mn><mo>−</mo><mn>80</mn><mo>=</mo><mn>60</mn></math> zł, czyli o <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>60</mn><mo>:</mo><mn>80</mn><mo>=</mo><mn>0,75</mn></math>, czyli 75%.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "przyjmij, że wiśnie kosztują 100 zł, i porównaj dwie pozostałe ceny",
   "czas_min": 2,
   "haczyk": {
    "sila": 2,
    "rodzaje": [
     "procent-podstawa"
    ],
    "opis": "Ceny wiśni są punktem odniesienia w danych, ale procent w pytaniu liczymy względem ceny jabłek"
   }
  },
  {
