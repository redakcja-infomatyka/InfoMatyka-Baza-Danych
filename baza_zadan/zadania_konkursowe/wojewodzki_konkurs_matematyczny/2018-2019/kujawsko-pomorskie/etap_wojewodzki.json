   "tresc_html": "<p>Ile metrów kwadratowych zajmuje w rzeczywistości prostokątny dywanik, który na planie w skali 1 : 20 ma wymiary 75 mm i 50 mm?</p>",
   "warianty": [],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "P = 1,5 m²",
    "zrodlo": "klucz",
    "rozwiazanie_html": "<p>Rzeczywiste wymiary: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>75</mn><mtext> mm</mtext><mo>·</mo><mn>20</mn><mo>=</mo><mn>1500</mn><mtext> mm</mtext><mo>=</mo><mn>1,5</mn><mtext> m</mtext></mrow></math> oraz <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>50</mn><mtext> mm</mtext><mo>·</mo><mn>20</mn><mo>=</mo><mn>1000</mn><mtext> mm</mtext><mo>=</mo><mn>1</mn><mtext> m</mtext></mrow></math>.</p><p>Pole: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>P</mi><mo>=</mo><mn>1,5</mn><mtext> m</mtext><mo>·</mo><mn>1</mn><mtext> m</mtext><mo>=</mo><mn>1,5</mn></mrow></math> <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mtext>m</mtext><mn>2</mn></msup></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "pomnóż wymiary z planu przez 20 i zamień milimetry na metry przed liczeniem pola",
