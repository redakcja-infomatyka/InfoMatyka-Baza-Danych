     "litera": "C",
     "html": "108°"
    },
    {
     "litera": "D",
     "html": "36°"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Kąt zewnętrzny wielokąta foremnego = <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>360</mn><mo>°</mo><mo>/</mo><mn>5</mn><mo>=</mo><mn>72</mn><mo>°</mo></mrow></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "kąty zewnętrzne dowolnego wielokąta sumują się do 360°",
   "czas_min": 1,
