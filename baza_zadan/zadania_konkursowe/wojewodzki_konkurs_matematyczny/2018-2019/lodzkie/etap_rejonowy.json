   "tematy": [
    "wielokąty",
    "kąty"
   ],
   "tresc_html": "<p>Kąt zewnętrzny pięciokąta foremnego wynosi:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "144°"
    },
    {
