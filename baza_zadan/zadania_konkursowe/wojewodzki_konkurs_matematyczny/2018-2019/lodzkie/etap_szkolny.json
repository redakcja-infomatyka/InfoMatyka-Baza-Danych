 "zrodlo_pdf": "https://github.com/stanislawosinski/wojewodzki-konkurs-matematyczny-sp-archiwum-zadan/blob/main/pdfs/szkolny/2019_lodzkie.pdf",
 "zadania": [
  {
   "id": "szkolny_2019_lodzkie_q1",
   "numer": 1,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "liczby rzymskie"
   ],
   "tresc_html": "<p>Pewien matematyk urodził się w roku MDCXLIII a zmarł w roku MDCCXXVII. Ile lat żył?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "74"
    },
    {
     "litera": "B",
     "html": "84"
    },
    {
     "litera": "C",
     "html": "68"
    },
    {
     "litera": "D",
     "html": "72"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>MDCXLIII = 1643, MDCCXXVII = 1727 (Newton).</p><p>1727 − 1643 = 84 lata.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "obie liczby rzymskie mają wspólny początek MDC — porównaj tylko dalsze części",
   "czas_min": 1
  },
  {
   "id": "szkolny_2019_lodzkie_q2",
   "numer": 2,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "ułamki okresowe / rozwinięcia dziesiętne",
    "reszta z dzielenia"
   ],
   "tresc_html": "<p>Jaka cyfra stoi na 55 miejscu po przecinku w ułamku dziesiętnym powstałym z podzielenia 6 przez 7?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "2"
    },
    {
     "litera": "B",
     "html": "8"
    },
    {
     "litera": "C",
     "html": "5"
    },
    {
     "litera": "D",
     "html": "7"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>6 : 7 = 0,(857142) — okres 6 cyfr.</p><p>55 = 6·9 + 1, więc szukana cyfra to 1. pozycja okresu = 8.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "rozwinięcie 6/7 jest okresowe — podziel 55 przez długość okresu i weź resztę",
   "czas_min": 2
  },
  {
   "id": "szkolny_2019_lodzkie_q3",
   "numer": 3,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "NWW / NWD",
    "podzielność"
   ],
   "tresc_html": "<p>Liczba podzielna przez 14 i przez 4 dzieli się przez 56:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "Prawda"
    },
    {
     "litera": "B",
     "html": "Fałsz"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>NWW(14, 4) = 28, nie 56.</p><p>Kontrprzykład: 28 dzieli się przez 14 i przez 4, ale nie przez 56. Zdanie fałszywe.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "policz najmniejszą wspólną wielokrotność 14 i 4",
   "czas_min": 1,
   "haczyk": {
    "sila": 2,
    "rodzaje": [
     "pozorna-wlasnosc"
    ],
    "opis": "Podzielność przez 14 i 4 nie daje podzielności przez iloczyn 56, bo 14 i 4 mają wspólny dzielnik"
   }
  },
  {
   "id": "szkolny_2019_lodzkie_q4",
   "numer": 4,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "wielokąty"
   ],
   "tresc_html": "<p>Suma miar kątów wewnętrznych siedmiokąta wypukłego wynosi:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "720°"
    },
    {
     "litera": "B",
     "html": "1080°"
    },
    {
     "litera": "C",
     "html": "900°"
    },
    {
     "litera": "D",
     "html": "1260°"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>(7 − 2)·180° = 5·180° = 900°.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "podziel siedmiokąt na trójkąty albo użyj wzoru (n−2)·180°",
   "czas_min": 1
  },
  {
   "id": "szkolny_2019_lodzkie_q5",
   "numer": 5,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "ułamki"
   ],
   "tresc_html": "<p>Liczba <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> spełnia warunek <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mn>3</mn><mn>7</mn></mfrac><mo>&lt;</mo><mi>x</mi><mo>&lt;</mo><mfrac><mn>4</mn><mn>7</mn></mfrac></mrow></math>. Liczba <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> jest równa:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "0,57143"
    },
    {
     "litera": "B",
     "html": "0,42856"
    },
    {
     "litera": "C",
     "html": "0,57139"
    },
    {
     "litera": "D",
     "html": "0,41999"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>3</mn><mn>7</mn></mfrac></math> ≈ 0,428571, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>4</mn><mn>7</mn></mfrac></math> ≈ 0,571428.</p><p>Tylko 0,57139 leży w przedziale (0,42857; 0,57143) — pozostałe są poza nim.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "zamień 3/7 i 4/7 na ułamki dziesiętne i porównuj cyfra po cyfrze",
   "czas_min": 2,
   "haczyk": {
    "sila": 2,
    "rodzaje": [
     "zaokraglenie"
    ],
    "opis": "Wariant wyglądający jak zaokrąglone 4/7 leży powyżej 4/7; trzeba porównać dokładne rozwinięcie"
   }
  },
  {
   "id": "szkolny_2019_lodzkie_q6",
   "numer": 6,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "proporcjonalność prosta"
   ],
   "tresc_html": "<p>Kwotę 32 000 zł podzielono na trzy osoby w stosunku: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>3</mn><mo>:</mo><mn>5</mn><mo>:</mo><mn>8</mn></mrow></math>. Najmniejsza z otrzymanych kwot to:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "10 000 zł"
    },
    {
     "litera": "B",
     "html": "2 000 zł"
    },
    {
     "litera": "C",
     "html": "6 000 zł"
    },
    {
     "litera": "D",
     "html": "16 000 zł"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>3 + 5 + 8 = 16 części; 32000 : 16 = 2000 zł na część.</p><p>Najmniejsza kwota: 3·2000 = 6000 zł.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "podziel kwotę na 3+5+8 równych części",
   "czas_min": 1
  },
  {
   "id": "szkolny_2019_lodzkie_q7",
   "numer": 7,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "graniastosłupy",
    "liczba krawędzi, ścian i wierzchołków"
   ],
   "tresc_html": "<p>Suma liczby krawędzi i wierzchołków pewnego graniastosłupa wynosi 35. Liczba ścian tego graniastosłupa wynosi:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "11"
    },
    {
     "litera": "B",
     "html": "6"
    },
    {
     "litera": "C",
     "html": "7"
    },
    {
     "litera": "D",
     "html": "9"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Graniastosłup o podstawie n-kąta: krawędzie = 3n, wierzchołki = 2n.</p><p>3n + 2n = 5n = 35 ⇒ n = 7. Ściany = n + 2 = 9.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "graniastosłup o podstawie n-kąta ma 3n krawędzi i 2n wierzchołków",
   "czas_min": 2
  },
  {
   "id": "szkolny_2019_lodzkie_q8",
   "numer": 8,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "podzielność"
   ],
   "tresc_html": "<p>Litera <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> oznacza cyfrę dziesiątek w liczbie 1975<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math>2. Dla jakiego <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> liczba ta dzieli się przez 36.</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "5"
    },
    {
     "litera": "B",
     "html": "7"
    },
    {
     "litera": "C",
     "html": "1"
    },
    {
     "litera": "D",
     "html": "3"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>36 = 4·9. Podzielność przez 4: końcówka x2 ⇒ x nieparzyste.</p><p>Podzielność przez 9: 1+9+7+5+x+2 = 24+x dzieli się przez 9 ⇒ x = 3.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "rozłóż 36 na 4·9 i połącz cechę podzielności przez 9 z cechą przez 4",
   "czas_min": 2
  },
  {
   "id": "szkolny_2019_lodzkie_q9",
   "numer": 9,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "procenty"
   ],
   "tresc_html": "<p>Cena brutto towaru wynosi 492 zł przy 23% stawce VAT. Kwota podatku wynosi:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "450 zł"
    },
    {
     "litera": "B",
     "html": "400 zł"
    },
    {
     "litera": "C",
     "html": "113,16 zł"
    },
    {
     "litera": "D",
     "html": "92 zł"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Cena netto = 492 : 1,23 = 400 zł.</p><p>VAT = 492 − 400 = 92 zł.</p>"
   },
   "w_pamieci": "pomysl",
   "wskazowka": "podatek liczy się od ceny netto, nie od brutto — sprawdź, ile razy 123 mieści się w 492",
   "czas_min": 1,
   "haczyk": {
    "sila": 2,
    "rodzaje": [
     "procent-podstawa",
     "o-co-pytaja"
    ],
    "opis": "VAT liczony od ceny netto, a podana jest cena brutto; pytają o podatek, nie o cenę netto"
   }
  },
  {
   "id": "szkolny_2019_lodzkie_q10",
   "numer": 10,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "okrąg wpisany i opisany",
    "pole i obwód"
   ],
   "tresc_html": "<p>Wierzchołki kwadratu leżą na okręgu o promieniu 5. Pole tego kwadratu wynosi:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "25"
    },
    {
     "litera": "B",
     "html": "50"
    },
    {
     "litera": "C",
     "html": "100"
    },
    {
     "litera": "D",
     "html": "75"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Przekątna kwadratu = średnica = 2·5 = 10.</p><p>Pole = d²/2 = 100/2 = 50.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "przekątna kwadratu jest średnicą okręgu",
   "czas_min": 1
  },
  {
   "id": "szkolny_2019_lodzkie_q11",
   "numer": 11,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "wzrost wykładniczy"
   ],
   "tresc_html": "<p>Rzęsa wodna w pewnych warunkach temperatury podwaja swoją powierzchnię w ciągu 72 godzin. Po 20 dobach zarosła cały staw. Po ilu dobach zajmowała <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>4</mn></mfrac></math> powierzchni stawu?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "5"
    },
    {
     "litera": "B",
     "html": "6"
    },
    {
     "litera": "C",
     "html": "19"
    },
    {
     "litera": "D",
     "html": "14"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Podwojenie co 72 h = 3 doby. Pełny staw w 20. dobie.</p><p>1/2 w dobie 17, 1/4 w dobie 14.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "zamień 72 godziny na doby i cofaj się od pełnego stawu, za każdym razem połowiąc powierzchnię",
   "czas_min": 2,
   "haczyk": {
    "sila": 2,
    "rodzaje": [
     "pozorna-wlasnosc",
     "o-co-pytaja"
    ],
    "opis": "Wzrost przez podwajanie, nie proporcjonalny; okres podwojenia podany w godzinach, pytanie w dobach"
   }
  },
  {
   "id": "szkolny_2019_lodzkie_q12",
   "numer": 12,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "statystyka opisowa",
    "równania z jedną zmienną"
   ],
   "tresc_html": "<p>Średnia arytmetyczna wieku trzech kolegów wynosi 14 lat. Gdyby najmłodszy był 2 razy starszy średnia wynosiłaby 18 lat. Ile lat ma najmłodszy z nich?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "10"
    },
    {
     "litera": "B",
     "html": "16"
    },
    {
     "litera": "C",
     "html": "14"
    },
    {
     "litera": "D",
     "html": "12"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Suma wieku = 3·14 = 42. Po podwojeniu najmłodszego suma = 3·18 = 54.</p><p>Przyrost 54 − 42 = 12 równy wiekowi najmłodszego ⇒ 12 lat.</p>"
   },
   "w_pamieci": "pomysl",
   "wskazowka": "porównaj sumy wieku przed zmianą i po niej",
   "czas_min": 2
  },
  {
   "id": "szkolny_2019_lodzkie_q13",
   "numer": 13,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "reszta z dzielenia",
    "podzielność"
   ],
   "tresc_html": "<p>Liczba <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi></math> przy dzieleniu przez 7 daje resztę 5. Liczba podzielna przez 7 to:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>n</mi><mo>−</mo><mn>3</mn></mrow></math>"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>n</mi><mo>+</mo><mn>23</mn></mrow></math>"
    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>n</mi><mo>−</mo><mn>11</mn></mrow></math>"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>n</mi><mo>+</mo><mn>35</mn></mrow></math>"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>n ≡ 5 (mod 7). Dla n+23: 23 ≡ 2 (mod 7), więc 5+2 = 7 ≡ 0.</p><p>Zatem n + 23 dzieli się przez 7.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "sprawdzaj tylko reszty z dzielenia przez 7 dodawanych i odejmowanych liczb",
   "czas_min": 2
  },
  {
   "id": "szkolny_2019_lodzkie_q14",
   "numer": 14,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "trójkąty"
   ],
   "tresc_html": "<p>Trójkąt można zbudować z odcinków:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "7 dm, 9 dm, 2 m"
    },
    {
     "litera": "B",
     "html": "10 m, 10 m, 1 cm"
    },
    {
     "litera": "C",
     "html": "3 km, 350 m, 264 000 cm"
    },
    {
     "litera": "D",
     "html": "8 m, 370 cm, 370 cm"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Sprawdzamy nierówność trójkąta (suma dwóch najkrótszych > najdłuższy).</p><p>B: 10 m, 10 m, 1 cm — 10 + 0,01 > 10 ✓. Pozostałe zawodzą.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "zamień wszystko na te same jednostki i sprawdź nierówność trójkąta",
   "czas_min": 2,
   "haczyk": {
    "sila": 2,
    "rodzaje": [
     "jednostki",
     "pozorna-wlasnosc"
    ],
    "opis": "Boki w różnych jednostkach; bardzo 'płaski' trójkąt 10 m, 10 m, 1 cm wygląda na niemożliwy, a istnieje"
   }
  },
  {
   "id": "szkolny_2019_lodzkie_q15",
   "numer": 15,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "stężenie procentowe / mieszaniny"
   ],
   "tresc_html": "<p>200 kg marchwi zawiera 95% wody. Po pewnym czasie przechowywania woda stanowiła 90% całej masy. Ile wtedy ważyła marchew?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "180 kg"
    },
    {
     "litera": "B",
     "html": "220 kg"
    },
    {
     "litera": "C",
     "html": "100 kg"
    },
    {
     "litera": "D",
     "html": "250 kg"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Sucha masa = 5% z 200 kg = 10 kg (stała).</p><p>Po suszeniu stanowi 10% ⇒ całość = 10 : 0,10 = 100 kg.</p>"
   },
   "w_pamieci": "pomysl",
   "wskazowka": "sucha masa marchwi się nie zmienia — od niej zacznij",
   "czas_min": 2,
   "haczyk": {
    "sila": 3,
    "rodzaje": [
     "procent-podstawa",
     "pozorna-wlasnosc"
    ],
    "opis": "Stała pozostaje sucha masa, a nie woda; spadek procentu wody o 5 punktów nie oznacza utraty kilku procent masy"
   }
  },
  {
