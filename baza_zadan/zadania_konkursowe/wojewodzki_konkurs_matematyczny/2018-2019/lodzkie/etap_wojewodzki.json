 "zadania": [
  {
   "id": "wojewodzki_2019_lodzkie_q1",
   "numer": 1,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "ułamki"
   ],
   "tresc_html": "<p>Każdy ułamek dziesiętny można zamienić na ułamek zwykły:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "Prawda"
    },
    {
     "litera": "B",
     "html": "Fałsz"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Ułamek dziesiętny (skończony lub okresowy) zawsze można zapisać jako iloraz dwóch liczb całkowitych, np. 0,25 = 25/100 = 1/4. To definicja ułamka zwykłego równoważnego dziesiętnemu.</p><p>Odpowiedź: Prawda.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "przypomnij sobie, jak zapisać 0,25 albo 0,(3) jako iloraz liczb całkowitych",
   "czas_min": 1
  },
  {
   "id": "wojewodzki_2019_lodzkie_q2",
   "numer": 2,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "wielokąty"
   ],
   "tresc_html": "<p>Ilość przekątnych ośmiokąta wypukłego wynosi:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "36"
    },
    {
     "litera": "B",
     "html": "16"
    },
    {
     "litera": "C",
     "html": "40"
    },
    {
     "litera": "D",
     "html": "20"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Liczba przekątnych n-kąta wypukłego: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>n</mi><mo>(</mo><mi>n</mi><mo>−</mo><mn>3</mn><mo>)</mo></mrow><mn>2</mn></mfrac></math>. Dla n=8: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>8</mn><mo>·</mo><mn>5</mn></mrow><mn>2</mn></mfrac><mo>=</mo><mn>20</mn></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "policz przekątne wychodzące z jednego wierzchołka i uważaj, by żadnej nie liczyć dwa razy",
   "czas_min": 1
  },
  {
   "id": "wojewodzki_2019_lodzkie_q3",
   "numer": 3,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "ostatnia cyfra / cykliczność potęg",
    "reszta z dzielenia"
   ],
   "tresc_html": "<p>Cyfrą jedności liczby <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>5</mn><mn>7</mn></msup><mo>+</mo><msup><mn>7</mn><mn>5</mn></msup><mo>+</mo><msup><mn>3</mn><mn>9</mn></msup></math> jest:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "9"
    },
    {
     "litera": "B",
     "html": "7"
    },
    {
     "litera": "C",
     "html": "5"
    },
    {
     "litera": "D",
     "html": "1"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Cyfra jedności: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>5</mn><mn>7</mn></msup></math>→5; potęgi 7 mają cykl 7,9,3,1, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>7</mn><mn>5</mn></msup></math>→7; potęgi 3 cykl 3,9,7,1, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>3</mn><mn>9</mn></msup></math>→3. Suma jedności 5+7+3=15 → cyfra 5.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "licz tylko cyfry jedności — powtarzają się one w cyklu co 4 potęgi",
   "czas_min": 2
  },
  {
   "id": "wojewodzki_2019_lodzkie_q4",
   "numer": 4,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "zmiany procentowe"
   ],
   "tresc_html": "<p>Marek ma o 40% mniej pieniędzy niż Wojtek. O ile procent Wojtek ma więcej pieniędzy niż Marek?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "60%"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>66</mn><mfrac><mn>2</mn><mn>3</mn></mfrac><mo>%</mo></math>"
    },
    {
     "litera": "C",
     "html": "40%"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>33</mn><mfrac><mn>1</mn><mn>3</mn></mfrac><mo>%</mo></math>"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Niech Wojtek = W, Marek = 0,6W. Wojtek ma więcej o <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>W</mi><mo>−</mo><mn>0,6</mn><mi>W</mi></mrow><mrow><mn>0,6</mn><mi>W</mi></mrow></mfrac><mo>=</mo><mfrac><mn>0,4</mn><mn>0,6</mn></mfrac><mo>=</mo><mfrac><mn>2</mn><mn>3</mn></mfrac></math> = 66⅔%.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "przyjmij, że Wojtek ma 100 zł, i odnieś różnicę do pieniędzy Marka, nie Wojtka",
   "czas_min": 2,
   "haczyk": {
    "sila": 3,
    "rodzaje": [
     "procent-podstawa",
     "kierunek-relacji"
    ],
    "opis": "Odwrócenie relacji procentowej: podstawą jest teraz kwota Marka, a nie Wojtka"
   }
  },
  {
   "id": "wojewodzki_2019_lodzkie_q5",
   "numer": 5,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "zliczanie / metody zliczania"
   ],
   "tresc_html": "<p>Liczb trzycyfrowych, których suma cyfr wynosi 4 jest:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "10"
    },
    {
     "litera": "B",
     "html": "8"
    },
    {
     "litera": "C",
     "html": "7"
    },
    {
     "litera": "D",
     "html": "9"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Cyfra setek a≥1, a+b+c=4. Liczba rozwiązań nieujemnych a'+b+c=3 to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mfrac linethickness=\"0\"><mn>5</mn><mn>2</mn></mfrac><mo>)</mo><mo>=</mo><mn>10</mn></math>. (103,112,121,130,202,211,220,301,310,400).</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "ustal cyfrę setek: 1, 2, 3 albo 4, i licz, na ile sposobów rozłożysz resztę",
   "czas_min": 2
  },
  {
   "id": "wojewodzki_2019_lodzkie_q6",
   "numer": 6,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "zliczanie / metody zliczania"
   ],
   "tresc_html": "<p>Pewna grupa szachistów rozegrała turniej szachowy, w którym rozgrywano po dwie partie „każdy z każdym”. Rozegrano 30 partii. Szachistów było:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "4"
    },
    {
     "litera": "B",
     "html": "5"
    },
    {
     "litera": "C",
     "html": "6"
    },
    {
     "litera": "D",
     "html": "8"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Po dwie partie „każdy z każdym”: liczba partii = n(n−1). n(n−1)=30 → n=6 (6·5=30).</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "każda para gra dwa razy, więc liczba partii to n·(n−1)",
   "czas_min": 2
  },
  {
   "id": "wojewodzki_2019_lodzkie_q7",
   "numer": 7,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "proporcjonalność prosta"
   ],
   "tresc_html": "<p>Długości boków trójkąta są w stosunku: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mo>:</mo><mn>7</mn><mo>:</mo><mn>11</mn></math>, a obwód wynosi 96. Najdłuższy bok ma:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "24"
    },
    {
     "litera": "B",
     "html": "28"
    },
    {
     "litera": "C",
     "html": "44"
    },
    {
     "litera": "D",
     "html": "48"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Suma części stosunku 6+7+11=24. Obwód 96 → jednostka 96/24=4. Najdłuższy bok 11·4=44.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "podziel obwód przez sumę części stosunku, żeby poznać jedną część",
   "czas_min": 1
  },
  {
   "id": "wojewodzki_2019_lodzkie_q8",
   "numer": 8,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "stężenie procentowe / mieszaniny"
   ],
   "tresc_html": "<p>Do 10 kg 2% roztworu soli dosypano 20 dag soli i dolano 10 kg wody. Stężenie roztworu:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "nie zmieniło się"
    },
    {
     "litera": "B",
     "html": "wzrosło"
    },
    {
     "litera": "C",
     "html": "zmalało"
    },
    {
     "litera": "D",
     "html": "nie da się określić"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Sól początkowo 2%·10 kg=0,2 kg. Dodano 20 dag=0,2 kg soli i 10 kg wody. Nowa sól 0,4 kg, masa 20,2 kg. Stężenie 0,4/20,2≈1,98% &lt; 2% → zmalało.</p>"
   },
   "w_pamieci": "pomysl",
   "wskazowka": "soli jest teraz dwa razy więcej — sprawdź, czy masa całego roztworu też urosła dwukrotnie",
   "czas_min": 2,
   "haczyk": {
    "sila": 2,
    "rodzaje": [
     "pozorna-wlasnosc"
    ],
    "opis": "Sól podwojona i dolano tyle, ile ważył roztwór, ale dosypana sól też zwiększa masę roztworu; dag i kg"
   }
  },
  {
   "id": "wojewodzki_2019_lodzkie_q9",
   "numer": 9,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "ostrosłupy",
    "liczba krawędzi, ścian i wierzchołków"
   ],
   "tresc_html": "<p>Ile wierzchołków ma ostrosłup, w którym suma ilości ścian i krawędzi wynosi 40:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "9"
    },
    {
     "litera": "B",
     "html": "11"
    },
    {
     "litera": "C",
     "html": "12"
    },
    {
     "litera": "D",
     "html": "14"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Ostrosłup o podstawie n-kąta: ścian n+1, krawędzi 2n. (n+1)+2n=3n+1=40 → n=13. Wierzchołków n+1=14.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "ostrosłup o n-kącie w podstawie ma n+1 ścian i 2n krawędzi",
   "czas_min": 2
  },
  {
   "id": "wojewodzki_2019_lodzkie_q10",
   "numer": 10,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "liczby wymierne i niewymierne",
    "działania na pierwiastkach"
   ],
   "tresc_html": "<p>Liczbą <u>niewymierną</u> jest:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mroot><mrow><mo>−</mo><mn>729</mn></mrow><mn>3</mn></mroot></math>"
    },
    {
     "litera": "B",
     "html": "2,(573)"
    },
    {
     "litera": "C",
     "html": "0,101001000100001…(itd.)"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mn>8</mn></msqrt><mo>:</mo><msqrt><mn>2</mn></msqrt></math>"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>A: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mroot><mrow><mo>−</mo><mn>729</mn></mrow><mn>3</mn></mroot></math>=−9 (wymierna). B: 2,(573) okresowa → wymierna. D: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mn>8</mn></msqrt><mo>:</mo><msqrt><mn>2</mn></msqrt><mo>=</mo><msqrt><mn>4</mn></msqrt><mo>=</mo><mn>2</mn></math>. C: nieskończone nieokresowe → niewymierna.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "najpierw oblicz pierwiastki, potem sprawdź, które rozwinięcie nie jest okresowe",
   "czas_min": 2
  },
  {
   "id": "wojewodzki_2019_lodzkie_q11",
   "numer": 11,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "trójkąty o kątach 30-60-90 i 45-45-90",
    "trójkąty",
    "pole i obwód"
   ],
   "tresc_html": "<p>Pole trójkąta prostokątnego równoramiennego wynosi 18. Obwód tego trójkąta wynosi:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>18</mn><msqrt><mn>2</mn></msqrt></math>"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>12</mn><mo>+</mo><mn>6</mn><msqrt><mn>2</mn></msqrt></math>"
    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>8</mn><mo>+</mo><mn>8</mn><msqrt><mn>2</mn></msqrt></math>"
    },
    {
     "litera": "D",
     "html": "20"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Przyprostokątne równe a. Pole a²/2=18 → a=6. Przeciwprostokątna 6√2. Obwód 6+6+6√2 = 12+6√2.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "z pola wyznacz przyprostokątną, przeciwprostokątna jest od niej √2 razy dłuższa",
   "czas_min": 2
  },
  {
   "id": "wojewodzki_2019_lodzkie_q12",
   "numer": 12,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "układ współrzędnych",
    "czworokąty",
    "pole i obwód"
   ],
   "tresc_html": "<p>Kwadrat <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>ABCD</mi></math> umieszczono w układzie współrzędnych. Końce przekątnej <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>AC</mi></math> mają współrzędne: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>=</mo><mo>(</mo><mo>−</mo><mn>3</mn><mo>;</mo><mn>2</mn><mo>)</mo></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>C</mi><mo>=</mo><mo>(</mo><mn>1</mn><mo>;</mo><mn>5</mn><mo>)</mo></math>. Obwód kwadratu wynosi:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><msqrt><mn>2</mn></msqrt></math>"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><msqrt><mn>2</mn></msqrt></math>"
    },
    {
     "litera": "C",
     "html": "20"
    },
    {
     "litera": "D",
     "html": "10"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Przekątna AC: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mrow><msup><mn>4</mn><mn>2</mn></msup><mo>+</mo><msup><mn>3</mn><mn>2</mn></msup></mrow></msqrt><mo>=</mo><mn>5</mn></math>. Bok a=5/√2. Obwód 4a=20/√2=10√2.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "przekątną odczytaj z trójkąta o przyprostokątnych 4 i 3, potem podziel ją przez √2",
   "czas_min": 2
  },
  {
   "id": "wojewodzki_2019_lodzkie_q13",
   "numer": 13,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "NWW / NWD"
   ],
   "tresc_html": "<p>Jaka jest NWW dwóch liczb, których NWD wynosi 35, a iloczyn 229 075?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "13 475"
    },
    {
     "litera": "B",
     "html": "20 825"
    },
    {
     "litera": "C",
     "html": "385"
    },
    {
     "litera": "D",
     "html": "6545"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>NWW·NWD = iloczyn liczb. NWW = 229075/35 = 6545.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "NWD·NWW = iloczyn liczb, a dzielenie przez 35 rozbij na dzielenie przez 5 i przez 7",
   "czas_min": 1
  },
  {
   "id": "wojewodzki_2019_lodzkie_q14",
   "numer": 14,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "ułamki"
   ],
   "tresc_html": "<p>Licznik i mianownik dodatniego ułamka właściwego zwiększono o taką samą liczbę dodatnią. Ułamek ten:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "zwiększył się"
    },
    {
     "litera": "B",
     "html": "zmniejszył się"
    },
    {
     "litera": "C",
     "html": "nie zmienił się"
    },
    {
     "litera": "D",
     "html": "w zależności od liczby mógł zmaleć lub wzrosnąć"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p>Dla ułamka właściwego a/b (a&lt;b): <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>a</mi><mo>+</mo><mi>k</mi></mrow><mrow><mi>b</mi><mo>+</mo><mi>k</mi></mrow></mfrac><mo>−</mo><mfrac><mi>a</mi><mi>b</mi></mfrac><mo>=</mo><mfrac><mrow><mi>k</mi><mo>(</mo><mi>b</mi><mo>−</mo><mi>a</mi><mo>)</mo></mrow><mrow><mi>b</mi><mo>(</mo><mi>b</mi><mo>+</mo><mi>k</mi><mo>)</mo></mrow></mfrac><mo>&gt;</mo><mn>0</mn></math> → zwiększył się.</p>"
