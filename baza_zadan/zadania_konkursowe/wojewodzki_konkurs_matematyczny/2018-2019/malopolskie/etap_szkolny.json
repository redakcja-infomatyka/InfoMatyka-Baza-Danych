    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>108</mn><mo>·</mo><mn>16</mn><mo>=</mo><mn>1728</mn></mrow></math>, a <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mroot><mn>1728</mn><mn>3</mn></mroot></math> = 12, bo <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><msup><mn>12</mn><mn>3</mn></msup><mo>=</mo><mn>1728</mn></mrow></math>. <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>7,5</mn><mo>%</mo></mrow></math> z 12 to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>0,075</mn><mo>·</mo><mn>12</mn><mo>=</mo><mn>0,9</mn></mrow></math>. Szukamy liczby o wartości bezwzględnej 0,9 — to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>9</mn><mn>10</mn></mfrac></math>.</p>"
   },
   "w_pamieci": "pomysl",
   "wskazowka": "rozbij 108·16 na 27·64 i pierwiastkuj czynniki osobno",
   "czas_min": 2
  },
  {
   "id": "szkolny_2018-2019_malopolskie_q13",
   "numer": 13,
   "typ": "zamkniete",
