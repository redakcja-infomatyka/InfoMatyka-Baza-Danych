 "zadania": [
  {
   "id": "rejonowy_2018_podlaskie_q1",
   "numer": 1,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "podzielność"
   ],
   "tresc_html": "<p>Ile zer ma na końcu liczba powstała z iloczynu 15 kolejnych liczb naturalnych, jeżeli najmniejsza z tych liczb jest równa 1?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "Trzy zera."
    },
    {
     "litera": "B",
     "html": "Dwa zera."
    },
    {
     "litera": "C",
     "html": "Jedno zero."
    },
    {
     "litera": "D",
     "html": "Nie ma zera."
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Iloczyn 1·2·…·15 to 15!. Liczba zer na końcu to liczba czynników 5 w jego rozkładzie (dwójek jest znacznie więcej). Wielokrotności 5 nie większe niż 15 to 5, 10, 15 — trzy liczby, każda daje jedną piątkę (15 = 3·5, nie ma 25). Iloczyn ma więc trzy zera na końcu.</p>"
   },
   "w_pamieci": "pomysl",
   "wskazowka": "nie mnóż — policz, ile czynników 5 kryje się w tym iloczynie",
   "czas_min": 1
  },
  {
   "id": "rejonowy_2018_podlaskie_q2",
   "numer": 2,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "zmiany procentowe",
    "wyrażenia algebraiczne"
   ],
   "tresc_html": "<p>Fabryka produkuje tygodniowo <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi></math> rowerów. Ile rowerów tygodniowo będzie produkować fabryka, jeśli jej produkcja wzrośnie o <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>p</mi><mo>%</mo></mrow></math>?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>m</mi><mi>p</mi></mrow><mn>100</mn></mfrac></math>"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mi>p</mi><mn>100</mn></mfrac><mo>+</mo><mi>m</mi></mrow></math>"
    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>m</mi><mo>+</mo><mfrac><mrow><mi>m</mi><mi>p</mi></mrow><mn>100</mn></mfrac></mrow></math>"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>m</mi><mo>+</mo><mi>m</mi><mi>p</mi></mrow><mn>100</mn></mfrac></math>"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Wzrost o <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>p</mi><mo>%</mo></mrow></math> z <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi></math> to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>m</mi><mi>p</mi></mrow><mn>100</mn></mfrac></math> rowerów. Nowa produkcja to stara plus przyrost: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>m</mi><mo>+</mo><mfrac><mrow><mi>m</mi><mi>p</mi></mrow><mn>100</mn></mfrac></mrow></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "podstaw konkretne liczby, np. m = 100 i p = 10, i sprawdź, który wzór pasuje",
   "czas_min": 1
  },
  {
   "id": "rejonowy_2018_podlaskie_q3",
   "numer": 3,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "wyłączanie czynnika przed znak pierwiastka",
    "czworokąty",
    "pole i obwód"
   ],
   "tresc_html": "<p>Dany jest kwadrat o polu 16 cm². Bok kwadratu o polu 3 razy większym ma długość</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mn>3</mn></msqrt></math> cm"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>4</mn><msqrt><mn>3</mn></msqrt></mfrac></math> cm"
    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>4</mn><msqrt><mn>3</mn></msqrt></mrow></math> cm"
    },
    {
     "litera": "D",
     "html": "12 cm"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Bok kwadratu o polu 16 cm² ma długość 4 cm. Pole trzy razy większe to 48 cm², więc szukany bok spełnia <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><msup><mi>a</mi><mn>2</mn></msup><mo>=</mo><mn>48</mn></mrow></math>, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>a</mi><mo>=</mo><msqrt><mn>48</mn></msqrt><mo>=</mo><mn>4</mn><msqrt><mn>3</mn></msqrt></mrow></math> cm.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "policz pole większego kwadratu i wyłącz czynnik przed pierwiastek",
   "czas_min": 2
  },
  {
   "id": "rejonowy_2018_podlaskie_q4",
   "numer": 4,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "inne"
   ],
   "tresc_html": "<p>Dane są dwie różne liczby całkowite. Jeżeli ich suma jest dodatnia, to</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "obie są dodatnie."
    },
    {
     "litera": "B",
     "html": "obie są różnych znaków."
    },
    {
     "litera": "C",
     "html": "suma ich odwrotności jest zawsze liczbą dodatnią."
    },
    {
     "litera": "D",
     "html": "iloczyn ich jest dodatni lub ujemny lub równy zero."
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Przykłady liczb całkowitych o sumie dodatniej: 5 i 1 (iloczyn 5, dodatni), −2 i 5 (iloczyn −10, ujemny), 0 i 5 (iloczyn 0). Dodatnia suma nie przesądza więc znaku iloczynu — może on być dodatni, ujemny albo równy zero.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "poszukaj odpowiedzi prawdziwej dla dowolnych takich liczb, a do pozostałych znajdź kontrprzykład",
   "czas_min": 2
