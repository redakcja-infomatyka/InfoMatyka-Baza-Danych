   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "symetrie",
    "czworokąty",
    "pole i obwód"
   ],
   "tresc_html": "<p>Prostokąt o bokach 9 cm i 12 cm przekształcono symetrycznie względem prostej zawierającej środki sąsiednich boków. Pole figury będącej częścią wspólną figur wzajemnie symetrycznych jest równe</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "189 cm²"
    },
    {
     "litera": "B",
     "html": "81 cm²"
    },
    {
     "litera": "C",
