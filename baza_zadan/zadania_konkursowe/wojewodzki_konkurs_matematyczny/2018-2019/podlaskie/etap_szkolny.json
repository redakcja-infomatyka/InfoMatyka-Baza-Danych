   ],
   "tresc_html": "<p>Baton ma masę 62,5 g. Ile batonów ma łączną masę 10 kg?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "170"
    },
    {
     "litera": "B",
     "html": "160"
    },
    {
