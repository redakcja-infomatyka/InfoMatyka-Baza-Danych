   "tematy": [
    "ułamki"
   ],
   "tresc_html": "<p>Jeżeli do podwojonego iloczynu liczb <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mfrac><mn>3</mn><mn>8</mn></mfrac></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>−</mo><mn>0,75</mn></math> dodano ich iloraz, to otrzymano</p>",
   "warianty": [
    {
