    },
    {
     "litera": "D",
     "html": "16"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>10 kg to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10000</mn></math> g. Liczba batonów: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10000</mn><mo>:</mo><mn>62,5</mn><mo>=</mo><mn>160</mn></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "zamień 10 kg na gramy, zanim zaczniesz dzielić",
   "czas_min": 1
  },
  {
   "id": "szkolny_2018_podlaskie_q3",
   "numer": 3,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "trójkąty"
   ],
   "tresc_html": "<p>Boki trójkąta mają odpowiednio długości <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>7</mn><mfrac><mn>1</mn><mn>2</mn></mfrac></math> cm, 11 cm i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> cm, gdzie <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> jest liczbą naturalną. Jaką najmniejszą liczbą naturalną może być <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math>?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "4"
    },
    {
     "litera": "B",
     "html": "3"
    },
    {
     "litera": "C",
     "html": "2"
    },
    {
     "litera": "D",
     "html": "1"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Z nierówności trójkąta: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>&gt;</mo><mn>11</mn><mo>−</mo><mn>7</mn><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>=</mo><mn>3</mn><mfrac><mn>1</mn><mn>2</mn></mfrac></math>. Najmniejsza liczba naturalna spełniająca ten warunek to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "warunek trójkąta: suma dwóch krótszych boków musi być większa od najdłuższego",
   "czas_min": 1,
   "haczyk": {
    "sila": 2,
    "rodzaje": [
     "warunek-istnienia"
    ],
    "opis": "Warunek z nierówności trójkąta daje granicę niecałkowitą i ostrą; łatwo zaokrąglić w złą stronę"
   }
  },
  {
