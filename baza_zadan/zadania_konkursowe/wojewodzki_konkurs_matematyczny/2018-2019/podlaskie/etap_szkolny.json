    "rozwiazanie_ai_html": "<p>Z rysunku odczytujemy: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>=</mo><mn>1,7</mn></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi><mo>=</mo><mn>2,2</mn></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>C</mi><mo>=</mo><mn>2,4</mn></math>. Średnia: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>1,7</mn><mo>+</mo><mn>2,2</mn><mo>+</mo><mn>2,4</mn><mo>)</mo><mo>:</mo><mn>3</mn><mo>=</mo><mn>6,3</mn><mo>:</mo><mn>3</mn><mo>=</mo><mn>2,1</mn></math>.</p>"
