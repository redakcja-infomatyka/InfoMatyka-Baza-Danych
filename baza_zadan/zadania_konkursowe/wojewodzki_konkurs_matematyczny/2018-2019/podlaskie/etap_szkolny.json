    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Niech <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> to krawędź krótsza. Różnica pól: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><msup><mrow><mo>(</mo><mi>a</mi><mo>+</mo><mn>2</mn><mo>)</mo></mrow><mn>2</mn></msup><mo>−</mo><mn>6</mn><msup><mi>a</mi><mn>2</mn></msup><mo>=</mo><mn>96</mn></math>, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>24</mn><mi>a</mi><mo>+</mo><mn>24</mn><mo>=</mo><mn>96</mn></math>, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mn>3</mn></math>. Krawędzie: 3 cm i 5 cm.</p>"
   },
   "w_pamieci": "pomysl",
   "wskazowka": "podziel 96 przez 6, a różnicę kwadratów rozłóż na (b−a)(b+a)",
   "czas_min": 2
  },
