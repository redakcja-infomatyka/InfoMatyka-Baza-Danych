    "proporcjonalność prosta"
   ],
   "tresc_html": "<p>Pewien zegarek śpieszy się cztery minuty na godzinę. Jeżeli został właściwie nastawiony o godzinie 7 rano, to tego samego dnia o godzinie 15.45 wskazywał</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "15.10"
    },
    {
     "litera": "B",
     "html": "15.13"
    },
    {
     "litera": "C",
     "html": "16.00"
    },
    {
     "litera": "D",
     "html": "16.20"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Od 7.00 do 15.45 minęły 8 godzin 45 minut, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>8</mn><mfrac><mn>3</mn><mn>4</mn></mfrac></math> h. Zegarek spieszy się 4 min na każdą godzinę, więc łącznie zyskał <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>8</mn><mfrac><mn>3</mn><mn>4</mn></mfrac><mo>·</mo><mn>4</mn><mo>=</mo><mn>35</mn></math> minut. Wskazywał więc 15.45 + 35 min = 16.20.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "policz, ile minut zegarek zyskuje przez 8 godzin i 45 minut",
   "czas_min": 2,
   "haczyk": {
    "sila": 2,
    "rodzaje": [
     "kierunek-relacji"
    ],
    "opis": "Zegarek się śpieszy, więc pokazuje więcej niż rzeczywista godzina; łatwo odjąć zamiast dodać"
   }
  },
  {
