   "tematy": [
    "wartość bezwzględna"
   ],
   "tresc_html": "<p>Liczba <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo lspace=\"0\" rspace=\"0\" stretchy=\"false\">|</mo><mn>9</mn><mo>−</mo><mn>2</mn><mo lspace=\"0\" rspace=\"0\" stretchy=\"false\">|</mo><mo>−</mo><mo lspace=\"0\" rspace=\"0\" stretchy=\"false\">|</mo><mn>4</mn><mo>−</mo><mn>7</mn><mo lspace=\"0\" rspace=\"0\" stretchy=\"false\">|</mo></math> jest równa</p>",
