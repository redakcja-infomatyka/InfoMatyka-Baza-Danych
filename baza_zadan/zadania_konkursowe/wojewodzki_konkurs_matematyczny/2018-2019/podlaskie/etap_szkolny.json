   "tematy": [
    "trójkąty",
    "pole i obwód"
   ],
   "tresc_html": "<p>Jeden z boków trójkąta równoramiennego ma długość 8 cm, a drugi 3 cm. Jaki jest obwód tego trójkąta?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "14 cm"
    },
    {
     "litera": "B",
     "html": "12 cm"
    },
    {
     "litera": "C",
     "html": "24 cm"
    },
    {
     "litera": "D",
     "html": "19 cm"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Gdyby ramiona miały po 3 cm, byłoby <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>+</mo><mn>3</mn><mo>&lt;</mo><mn>8</mn></math>, więc taki trójkąt nie istnieje. Ramiona mają więc po 8 cm, podstawa 3 cm. Obwód: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>8</mn><mo>+</mo><mn>8</mn><mo>+</mo><mn>3</mn><mo>=</mo><mn>19</mn></math> cm.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "sprawdź, który układ boków w ogóle tworzy trójkąt",
   "czas_min": 2,
