   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Figurę można podzielić na 8 kwadratów o boku <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math>. Z pola: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>8</mn><msup><mi>a</mi><mn>2</mn></msup><mo>=</mo><mn>200</mn></math> mamy <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mn>5</mn></math> cm, a bok dłuższy to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn></math> cm. Obwód: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>8</mn><mo>·</mo><mn>5</mn><mo>+</mo><mn>4</mn><mo>·</mo><mn>10</mn><mo>=</mo><mn>80</mn></math> cm.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "podziel figurę na jednakowe kwadraty o boku równym krótszemu bokowi",
   "czas_min": 2
