    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Rozwinięcie <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>2</mn><mn>7</mn></mfrac></math> jest okresowe z okresem długości 6: 2, 8, 5, 7, 1, 4. Ponieważ <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>135</mn><mo>=</mo><mn>6</mn><mo>·</mo><mn>22</mn><mo>+</mo><mn>3</mn></mrow></math>, 135. cyfra po przecinku to 3. cyfra okresu, czyli 5 — odpowiedź C.</p>"
   },
