   "tematy": [
    "symetrie"
   ],
   "tresc_html": "<p>Które z figur oznaczonych symbolami I, II, III, IV mają dokładnie dwie osie symetrii, jeżeli:</p><ul><li>I – trójkąt równoramienny,</li><li>II – dwie proste przecinające się;</li><li>III – okrąg;</li><li>IV – romb, który nie jest kwadratem?</li></ul>",
   "warianty": [
    {
     "litera": "A",
     "html": "I i II"
    },
    {
     "litera": "B",
     "html": "II i IV"
    },
    {
     "litera": "C",
     "html": "II i III"
    },
    {
     "litera": "D",
     "html": "III i IV"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>I — trójkąt równoramienny (nierównoboczny): 1 oś symetrii. II — dwie przecinające się proste: 2 osie (dwusieczne kątów między nimi). III — okrąg: nieskończenie wiele osi. IV — romb niebędący kwadratem: 2 osie (przekątne). Dokładnie dwie osie mają figury II i IV — odpowiedź B.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "przejdź po kolei przez cztery figury i policz osie każdej z nich",
   "czas_min": 2
  },
  {
   "id": "wojewodzki_2018_podlaskie_q20",
