   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Prawa strona: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo>−</mo><mn>2</mn><mfrac><mn>2</mn><mn>5</mn></mfrac><mo>+</mo><mn>1,6</mn><mo>=</mo><mo>−</mo><mn>2,4</mn><mo>+</mo><mn>1,6</mn><mo>=</mo><mo>−</mo><mn>0,8</mn></mrow></math>, więc równanie to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo lspace=\"0\" rspace=\"0\" stretchy=\"false\">|</mo><mi>m</mi><mo>−</mo><mn>3,4</mn><mo lspace=\"0\" rspace=\"0\" stretchy=\"false\">|</mo><mo>=</mo><mn>0,8</mn></mrow></math>. Stąd <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>m</mi><mo>=</mo><mn>4,2</mn></mrow></math> lub <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>m</mi><mo>=</mo><mn>2,6</mn></mrow></math>, a <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>4,2</mn><mo>=</mo><mn>4</mn><mfrac><mn>1</mn><mn>5</mn></mfrac></mrow></math> — odpowiedź A.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "prawa strona to zwykła liczba — potem odłóż ją od 3,4 w obie strony",
   "czas_min": 2
