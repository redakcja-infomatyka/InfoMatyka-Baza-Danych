   "tresc_html": "<p>Rozwiązaniem równania <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo lspace=\"0\" rspace=\"0\" stretchy=\"false\">|</mo><mi>m</mi><mo>−</mo><mn>3,4</mn><mo lspace=\"0\" rspace=\"0\" stretchy=\"false\">|</mo><mo>=</mo><mo lspace=\"0\" rspace=\"0\" stretchy=\"false\">|</mo><mo>−</mo><mn>2</mn><mfrac><mn>2</mn><mn>5</mn></mfrac><mo>+</mo><mn>1,6</mn><mo lspace=\"0\" rspace=\"0\" stretchy=\"false\">|</mo></mrow></math> jest</p>",
   "warianty": [
    {
