   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Rozwijając ułamki: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0,</mn><mo>(</mo><mn>465</mn><mo>)</mo><mo>=</mo><mn>0,465465…</mn></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0,4</mn><mo>(</mo><mn>65</mn><mo>)</mo><mo>=</mo><mn>0,465656…</mn></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0,46</mn><mo>(</mo><mn>5</mn><mo>)</mo><mo>=</mo><mn>0,465555…</mn></math>. Po trzech pierwszych cyfrach (465) kolejna cyfra jest największa (6) w liczbie 0,4(65).</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "rozpisz każdą liczbę na cztery cyfry po przecinku i porównaj miejscami",
   "czas_min": 2
  },
  {
   "id": "wojewodzki_2018-2019_warminsko-mazurskie_q11",
