   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Bok sześciokąta: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>24</mn><mo>:</mo><mn>6</mn><mo>=</mo><mn>4</mn></math>. Sześciokąt foremny to 6 trójkątów równobocznych o boku 4, każdy o polu <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><msqrt><mn>3</mn></msqrt></math>. Pole całości: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mo>·</mo><mn>4</mn><msqrt><mn>3</mn></msqrt><mo>=</mo><mn>24</mn><msqrt><mn>3</mn></msqrt></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "sześciokąt foremny to sześć trójkątów równobocznych o boku równym bokowi sześciokąta",
   "czas_min": 2
