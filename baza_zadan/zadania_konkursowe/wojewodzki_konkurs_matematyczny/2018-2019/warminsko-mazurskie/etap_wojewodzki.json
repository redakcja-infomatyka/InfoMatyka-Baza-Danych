    "pole i obwód"
   ],
   "tresc_html": "<p>Dany jest sześciokąt foremny o obwodzie 24. Pole tego sześciokąta wynosi</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "12"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>12</mn><msqrt><mn>3</mn></msqrt></math>"
    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>24</mn><msqrt><mn>3</mn></msqrt></math>"
