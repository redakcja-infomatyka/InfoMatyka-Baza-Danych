   "tresc_html": "<p>Suma miar kątów α i β zaznaczonych na rysunku wynosi</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "180°"
    },
    {
     "litera": "B",
     "html": "150°"
    },
