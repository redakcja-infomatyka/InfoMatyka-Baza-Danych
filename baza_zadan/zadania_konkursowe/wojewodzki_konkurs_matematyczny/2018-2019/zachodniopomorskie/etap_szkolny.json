   "tematy": [
    "inne"
   ],
   "tresc_html": "<p>Który z poniższych iloczynów jest najmniejszy?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>44</mn><mo>·</mo><mn>777</mn></mrow></math>"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>55</mn><mo>·</mo><mn>666</mn></mrow></math>"
    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>66</mn><mo>·</mo><mn>555</mn></mrow></math>"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>77</mn><mo>·</mo><mn>444</mn></mrow></math>"
    },
    {
     "litera": "E",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>88</mn><mo>·</mo><mn>333</mn></mrow></math>"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "E",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Każdy iloczyn ma postać <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>11</mn><mi>a</mi><mo>·</mo><mn>111</mn><mi>b</mi></mrow></math>, gdzie <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>a</mi><mo>+</mo><mi>b</mi><mo>=</mo><mn>11</mn></mrow></math>: pary <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo>(</mo><mn>4</mn><mo>,</mo><mn>7</mn><mo>)</mo></mrow></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo>(</mo><mn>5</mn><mo>,</mo><mn>6</mn><mo>)</mo></mrow></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo>(</mo><mn>6</mn><mo>,</mo><mn>5</mn><mo>)</mo></mrow></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo>(</mo><mn>7</mn><mo>,</mo><mn>4</mn><mo>)</mo></mrow></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo>(</mo><mn>8</mn><mo>,</mo><mn>3</mn><mo>)</mo></mrow></math>. Iloczyn <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>a</mi><mo>·</mo><mi>b</mi></mrow></math> jest najmniejszy, gdy liczby najbardziej się różnią, czyli dla <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>8</mn><mo>·</mo><mn>3</mn><mo>=</mo><mn>24</mn></mrow></math> — to daje iloczyn <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>88</mn><mo>·</mo><mn>333</mn></mrow></math>.</p>"
   },
   "w_pamieci": "pomysl",
   "wskazowka": "w każdym iloczynie wyłącz 11 i 111, porównaj tylko iloczyny cyfr",
   "czas_min": 2
  },
