   ],
   "tresc_html": "<p>Ile może być liczb podzielnych przez 3 wśród dziesięciu kolejnych liczb naturalnych?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "trzy"
    },
    {
     "litera": "B",
     "html": "cztery"
    },
    {
     "litera": "C",
     "html": "pięć"
    },
    {
     "litera": "D",
     "html": "trzy lub cztery"
    },
    {
     "litera": "E",
     "html": "cztery lub pięć"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Dziesięć kolejnych liczb naturalnych to trzy pełne trójki kolejnych liczb (9 liczb) i jedna dodatkowa. W każdej trójce kolejnych liczb dokładnie jedna jest podzielna przez 3, więc wśród pierwszych dziewięciu jest ich dokładnie <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn></math>. Dziesiąta liczba, zależnie od punktu startowego, może być podzielna przez 3 (wtedy razem <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn></math>) albo nie (wtedy razem <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn></math>).</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "sprawdź dwa przypadki: gdy pierwsza z dziesięciu liczb dzieli się przez 3 i gdy nie",
   "czas_min": 1,
   "haczyk": {
    "sila": 2,
    "rodzaje": [
     "wszystkie-przypadki",
     "kwantyfikator"
    ],
    "opis": "„Ile MOŻE być” – wynik zależy od liczby, od której się zaczyna; trzeba podać oba przypadki"
   }
  },
  {
