    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Kąty przy boku równoległoboku są dopełniające: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>α</mi><mo>+</mo><mi>β</mi><mo>=</mo><mn>180</mn><mo>°</mo></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>γ</mi><mo>+</mo><mi>δ</mi><mo>=</mo><mn>180</mn><mo>°</mo></math>. Z <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>α</mi><mo>−</mo><mi>β</mi><mo>=</mo><mn>44</mn><mo>°</mo></math> mamy <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>α</mi><mo>=</mo><mn>112</mn><mo>°</mo></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>β</mi><mo>=</mo><mn>68</mn><mo>°</mo></math>, a z <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>α</mi><mo>−</mo><mi>γ</mi><mo>=</mo><mn>11</mn><mo>°</mo></math> mamy <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>γ</mi><mo>=</mo><mn>101</mn><mo>°</mo></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>δ</mi><mo>=</mo><mn>79</mn><mo>°</mo></math>. Stąd <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>α</mi><mo>−</mo><mi>δ</mi><mo>=</mo><mn>33</mn><mo>°</mo></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>γ</mi><mo>−</mo><mi>β</mi><mo>=</mo><mn>33</mn><mo>°</mo></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>γ</mi><mo>−</mo><mi>δ</mi><mo>=</mo><mn>22</mn><mo>°</mo></math>.</p>"
   },
   "w_pamieci": "wprost",
