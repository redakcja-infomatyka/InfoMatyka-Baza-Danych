    },
    {
     "litera": "B",
     "html": "3"
    },
    {
     "litera": "C",
     "html": "5"
    },
    {
     "litera": "D",
     "html": "7"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Porównujemy liczby cyfra po cyfrze, oznaczając szukaną cyfrę literą x. Z x864 &lt; 8x64 wynika x &lt; 8. Z 8x64 &lt; 864x wynika x &lt; 6. Z 864x &lt; 86x4 wynika 4 &lt; x. Jedyna cyfra spełniająca wszystkie warunki to 5.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "porównuj cyfra po cyfrze — dwie skrajne nierówności ograniczają gwiazdkę z dołu i z góry",
   "czas_min": 2
  },
