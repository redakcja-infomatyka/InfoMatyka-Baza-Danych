    "kąty"
   ],
   "tresc_html": "<p>Trapez <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>ACDG</mi></math> podzielono na 5 trójkątów równobocznych. Wskaż zdanie prawdziwe.</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "Proste <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>AC</mi></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>BF</mi></math> są prostopadłe."
    },
    {
     "litera": "B",
     "html": "Proste <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>BG</mi></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>CF</mi></math> są równoległe."
    },
    {
     "litera": "C",
     "html": "Proste <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>CF</mi></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>AG</mi></math> są równoległe."
    },
    {
     "litera": "D",
     "html": "Proste <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>GF</mi></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>CD</mi></math> są prostopadłe."
