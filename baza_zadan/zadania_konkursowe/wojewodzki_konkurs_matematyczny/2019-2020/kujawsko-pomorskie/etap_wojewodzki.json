    "proporcjonalność prosta"
   ],
   "tresc_html": "<p>Samochód zużywa 5 litrów paliwa na przejechanie 100 km. Litr paliwa kosztuje <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5,10</mn></math> zł.</p><p>Oceń prawdziwość zdań. Zaznacz PRAWDA, jeśli zdanie jest prawdziwe, lub FAŁSZ – jeśli jest fałszywe.</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "Koszt paliwa potrzebnego do przejechania 200 km tym samochodem wynosi 51 zł."
    },
    {
     "litera": "B",
     "html": "Na przejechanie 300 km tym samochodem wystarczy 15 litrów paliwa."
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "PP",
    "zrodlo": "klucz",
    "rozwiazanie_html": "<p><strong>A. PRAWDA</strong> — na 200 km potrzeba <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>2</mn><mo>·</mo><mn>5</mn><mo>=</mo><mn>10</mn></mrow></math> litrów, co kosztuje <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>10</mn><mo>·</mo><mn>5,10</mn><mtext> zł</mtext><mo>=</mo><mn>51</mn><mtext> zł</mtext></mrow></math>.</p><p><strong>B. PRAWDA</strong> — na 300 km potrzeba <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>3</mn><mo>·</mo><mn>5</mn><mo>=</mo><mn>15</mn></mrow></math> litrów, więc 15 litrów wystarczy.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "policz najpierw, ile litrów potrzeba na 200 i na 300 km",
   "czas_min": 2
  },
  {
