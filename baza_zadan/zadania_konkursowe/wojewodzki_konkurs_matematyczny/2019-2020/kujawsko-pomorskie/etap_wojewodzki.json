   "tematy": [
    "wyrażenia algebraiczne"
   ],
   "tresc_html": "<p>Czy dla każdej liczby trzycyfrowej prawdziwe są zdania?</p><p>Zaznacz PRAWDA, jeśli zdanie jest prawdziwe, lub FAŁSZ – jeśli jest fałszywe.</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "Jeżeli uczeń dopisze 0 po cyfrze jedności tej liczby, to otrzymana liczba będzie 10 razy większa od wyjściowej liczby."
    },
    {
     "litera": "B",
     "html": "Jeżeli uczeń wpisze cyfrę 5 między cyfry dziesiątek i jedności tej liczby, to otrzymana liczba będzie 50 razy większa od wyjściowej liczby."
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "PF",
    "zrodlo": "klucz",
    "rozwiazanie_html": "<p><strong>A. PRAWDA</strong> — dopisanie 0 na końcu liczby oznacza pomnożenie jej przez 10.</p><p><strong>B. FAŁSZ</strong> — dla liczby o cyfrach setek <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>s</mi></math>, dziesiątek <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>d</mi></math> i jedności <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>j</mi></math> liczba wyjściowa to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>100</mn><mi>s</mi><mo>+</mo><mn>10</mn><mi>d</mi><mo>+</mo><mi>j</mi></mrow></math>, a po wstawieniu 5 między cyfry dziesiątek i jedności otrzymamy <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>1000</mn><mi>s</mi><mo>+</mo><mn>100</mn><mi>d</mi><mo>+</mo><mn>50</mn><mo>+</mo><mi>j</mi></mrow></math>, co nie jest 50 razy większe od liczby wyjściowej (np. dla 100 otrzymamy 1050, a nie 5000).</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "drugie zdanie sprawdź na najprostszej liczbie trzycyfrowej, np. 100",
   "czas_min": 2
  },
