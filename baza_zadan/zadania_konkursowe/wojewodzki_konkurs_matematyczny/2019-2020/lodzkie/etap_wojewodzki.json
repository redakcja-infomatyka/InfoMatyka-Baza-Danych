    "rozwiazanie_ai_html": "<p>Wysokość = pionowa składowa przekątnej: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>h</mi><mo>=</mo><mn>24</mn><mo>sin</mo><mn>45</mn><mo>°</mo><mo>=</mo><mn>12</mn><msqrt><mn>2</mn></msqrt></math>. Pole = <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mn>2</mn></mfrac><mo>·</mo><mi>h</mi><mo>=</mo><msup><mi>h</mi><mn>2</mn></msup><mo>=</mo><mn>288</mn></math>.</p>"
   },
