    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mo>−</mo><mn>1</mn><mo>,</mo><mo>−</mo><mn>5</mn><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>)</mo></math>"
