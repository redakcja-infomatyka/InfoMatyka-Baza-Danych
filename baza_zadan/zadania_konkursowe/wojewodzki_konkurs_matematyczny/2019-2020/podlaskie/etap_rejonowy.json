     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>3</mn><mo>(</mo><mi>x</mi><mo>−</mo><mn>6</mn><mo>)</mo></mrow></math>"
    }
   ],
   "rysunki": [],
