   "punkty": 1,
   "tematy": [
    "ułamki"
   ],
   "tresc_html": "<p>Którą z podanych czterech liczb: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>1</mn><mfrac><mn>7</mn><mn>20</mn></mfrac></mrow></math>; <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3,9</mn></math>; <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4,0</mn></math>; <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>4</mn><mfrac><mn>3</mn><mn>4</mn></mfrac></mrow></math> należy wykreślić, aby suma trzech pozostałych była równa 10?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>1</mn><mfrac><mn>7</mn><mn>20</mn></mfrac></mrow></math>"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3,9</mn></math>"
    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4,0</mn></math>"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>4</mn><mfrac><mn>3</mn><mn>4</mn></mfrac></mrow></math>"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Suma czterech liczb: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mfrac><mn>7</mn><mn>20</mn></mfrac><mo>+</mo><mn>3,9</mn><mo>+</mo><mn>4,0</mn><mo>+</mo><mn>4</mn><mfrac><mn>3</mn><mn>4</mn></mfrac><mo>=</mo><mn>14</mn></math>. Aby pozostałe trzy dały 10, trzeba wykreślić <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>14</mn><mo>−</mo><mn>10</mn><mo>=</mo><mn>4</mn></math>, czyli liczbę 4,0.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "zsumuj wszystkie cztery liczby i porównaj sumę z 10",
   "czas_min": 2
  },
