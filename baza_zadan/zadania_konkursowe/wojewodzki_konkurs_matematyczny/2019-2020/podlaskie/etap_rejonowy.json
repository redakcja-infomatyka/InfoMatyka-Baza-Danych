    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Ułamek ma skończone rozwinięcie, gdy po skróceniu mianownik ma tylko czynniki 2 i 5 — tak jest dla <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>9</mn><mn>6</mn></mfrac></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>7</mn><mn>8</mn></mfrac></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>3</mn><mn>15</mn></mfrac></math>. Mianownik ułamka <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>2</mn><mn>15</mn></mfrac></math> to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>15</mn><mo>=</mo><mn>3</mn><mo>·</mo><mn>5</mn></math>, więc jego rozwinięcie jest nieskończone.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "skróć ułamki i sprawdź, czy w mianowniku zostaje coś poza dwójkami i piątkami",
   "czas_min": 2,
   "haczyk": {
    "sila": 2,
    "rodzaje": [
     "pozorna-wlasnosc"
    ],
    "opis": "Mianownik 15 wygląda na rozwinięcie nieskończone, ale ułamek trzeba najpierw skrócić"
   }
  },
