    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Wiek Rafała 6 lat temu: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>−</mo><mn>6</mn></math>. Olek ma dziś trzy razy tyle lat: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>(</mo><mi>x</mi><mo>−</mo><mn>6</mn><mo>)</mo></math>.</p>"
   },
