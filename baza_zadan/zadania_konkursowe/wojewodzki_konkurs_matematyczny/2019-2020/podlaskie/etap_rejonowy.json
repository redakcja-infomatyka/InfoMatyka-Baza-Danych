    {
     "litera": "C",
     "html": "Piątek."
    },
    {
     "litera": "D",
     "html": "Niedzielę."
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Obie ćwiczą razem co <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtext>NWW</mtext><mo>(</mo><mn>4</mn><mo>,</mo><mn>3</mn><mo>)</mo><mo>=</mo><mn>12</mn></math> dni. Ponieważ <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>12</mn><mo>=</mo><mn>7</mn><mo>+</mo><mn>5</mn></math>, licząc od środy przesuwamy się o 5 dni: wypada poniedziałek.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "policz NWW obu odstępów, a potem resztę z dzielenia przez 7",
   "czas_min": 2
