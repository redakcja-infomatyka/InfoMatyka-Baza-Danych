     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>3</mn><mn>11</mn></mfrac></math>"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>25</mn><mn>121</mn></mfrac></math>"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Wśród liczb 11–21 jest 6 nieparzystych (11,13,15,17,19,21) i 5 parzystych. Iloczyn dwóch liczb jest nieparzysty tylko, gdy obie wylosowane liczby są nieparzyste: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi><mo>=</mo><mfrac><mn>6</mn><mn>11</mn></mfrac><mo>·</mo><mfrac><mn>5</mn><mn>10</mn></mfrac><mo>=</mo><mfrac><mn>30</mn><mn>110</mn></mfrac><mo>=</mo><mfrac><mn>3</mn><mn>11</mn></mfrac></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "iloczyn wyjdzie nieparzysty tylko wtedy, gdy obie kule mają nieparzyste numery",
   "czas_min": 2
