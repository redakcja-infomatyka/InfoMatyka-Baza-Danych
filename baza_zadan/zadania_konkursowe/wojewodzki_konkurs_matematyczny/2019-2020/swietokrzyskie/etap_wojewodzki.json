   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Ostrosłup o podstawie <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi></math>-kąta ma <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi><mo>=</mo><mi>n</mi><mo>+</mo><mn>1</mn></math> ścian (n bocznych i 1 podstawa), więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi><mo>=</mo><mi>m</mi><mo>−</mo><mn>1</mn></math>. Krawędzi jest <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>n</mi></math> (n podstawy i n bocznych), czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>(</mo><mi>m</mi><mo>−</mo><mn>1</mn><mo>)</mo><mo>=</mo><mn>2</mn><mi>m</mi><mo>−</mo><mn>2</mn></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "zacznij od tego, ile boków ma podstawa takiego ostrosłupa",
   "czas_min": 1,
