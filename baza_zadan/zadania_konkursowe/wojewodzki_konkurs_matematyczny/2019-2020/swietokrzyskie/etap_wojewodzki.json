   ],
   "tresc_html": "<p>Która z liczb: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mn>3</mn><msqrt><mn>33</mn></msqrt></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi><mo>=</mo><mn>4</mn><mroot><mn>44</mn><mn>3</mn></mroot></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>c</mi><mo>=</mo><mn>5</mn><msqrt><mn>5</mn></msqrt></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>d</mi><mo>=</mo><mn>7</mn><mroot><mn>7</mn><mn>3</mn></mroot></math> jest największa? Wybierz odpowiedź spośród podanych.</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "Liczba <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math>."
