     "html": "21"
    },
    {
     "litera": "D",
     "html": "16"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Suma wieku 18 gości: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>18</mn><mo>·</mo><mn>26</mn><mo>=</mo><mn>468</mn></math> lat. Po dołączeniu bliźniaków (20 osób) suma wynosi <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>20</mn><mo>·</mo><mn>25</mn><mo>=</mo><mn>500</mn></math> lat.</p><p>Wiek obu bliźniaków razem: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>500</mn><mo>−</mo><mn>468</mn><mo>=</mo><mn>32</mn></math>, więc każdy ma <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>32</mn><mo>:</mo><mn>2</mn><mo>=</mo><mn>16</mn></math> lat.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "porównaj sumy wieku wszystkich osób przed i po dołączeniu bliźniaków",
   "czas_min": 2
  },
