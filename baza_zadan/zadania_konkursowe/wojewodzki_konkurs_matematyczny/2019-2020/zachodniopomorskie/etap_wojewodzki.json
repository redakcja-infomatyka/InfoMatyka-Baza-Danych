   "tematy": [
    "nierówności",
    "procenty"
   ],
   "tresc_html": "<p>W partii 40 000 żarówek 3% stanowią żarówki uszkodzone. Ile uszkodzonych żarówek należy usunąć, aby w pozostałych żarówkach było mniej niż 2% żarówek uszkodzonych?</p>",
   "warianty": [],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "co najmniej 409 żarówek",
    "zrodlo": "klucz",
    "rozwiazanie_html": "<p>Niech <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> oznacza liczbę uszkodzonych żarówek, które trzeba usunąć. 3% z 40 000 to 1200 uszkodzonych żarówek, więc po usunięciu jest <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>1200</mn><mo>−</mo><mi>x</mi><mo>)</mo></math> uszkodzonych na <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>40000</mn><mo>−</mo><mi>x</mi><mo>)</mo></math> wszystkich żarówek. Warunek: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1200</mn><mo>−</mo><mi>x</mi><mo>&lt;</mo><mn>0,02</mn><mo>(</mo><mn>40000</mn><mo>−</mo><mi>x</mi><mo>)</mo></math>, stąd <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>&gt;</mo><mn>408</mn><mfrac><mn>8</mn><mn>49</mn></mfrac></math>. Należy zatem usunąć co najmniej 409 uszkodzonych żarówek.</p>"
   },
   "czas_min": 5,
   "haczyk": {
    "sila": 3,
    "rodzaje": [
     "procent-podstawa"
    ],
    "opis": "Po usunięciu żarówek zmienia się podstawa procentu – 2% liczy się od pozostałej partii, nie od 40 000"
   }
