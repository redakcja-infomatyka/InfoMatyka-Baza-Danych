    "równania z jedną zmienną"
   ],
   "tresc_html": "<p>W poniedziałek cenę pewnego towaru zwiększono o 10%, w środę zmniejszono o 20%, a w piątek zmniejszono jeszcze o 30%. Oblicz początkową cenę towaru, jeśli ostatecznie po zmianach wynosiła 1232 zł.</p>",
   "warianty": [],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "2000 zł",
    "zrodlo": "klucz",
    "rozwiazanie_html": "<p>Niech <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> oznacza cenę towaru na początku. Z warunków zadania <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>110</mn><mo>%</mo><mo>·</mo><mn>80</mn><mo>%</mo><mo>·</mo><mn>70</mn><mo>%</mo><mo>·</mo><mi>x</mi><mo>=</mo><mn>1232</mn></math>, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0,616</mn><mi>x</mi><mo>=</mo><mn>1232</mn></math>, stąd <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mn>2000</mn></math> zł.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "cofaj zmiany po kolei: podziel przez 0,7, potem przez 0,8, na końcu przez 1,1",
   "czas_min": 5
  },
  {
   "id": "wojewodzki_2019-2020_zachodniopomorskie_q11",
