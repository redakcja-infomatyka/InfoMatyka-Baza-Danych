    "graniastosłupy"
   ],
   "tresc_html": "<p>Objętość pewnego sześcianu ma tyle centymetrów sześciennych, ile centymetrów ma suma długości wszystkich krawędzi tej bryły. Ile centymetrów kwadratowych ma pole powierzchni tej bryły?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "60"
    },
    {
     "litera": "B",
     "html": "72"
    },
    {
     "litera": "C",
     "html": "84"
    },
    {
     "litera": "D",
     "html": "96"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Niech <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> — długość krawędzi sześcianu. Z warunku <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>a</mi><mn>3</mn></msup><mo>=</mo><mn>12</mn><mi>a</mi></math> wynika <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>a</mi><mn>2</mn></msup><mo>=</mo><mn>12</mn></math>.</p><p>Pole powierzchni: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><msup><mi>a</mi><mn>2</mn></msup><mo>=</mo><mn>6</mn><mo>·</mo><mn>12</mn><mo>=</mo><mn>72</mn></math> cm² — opcja B.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "ułóż równanie a³ = 12a — do pola potrzebujesz tylko a², nie samego a",
   "czas_min": 2
  },
  {
