   ],
   "tresc_html": "<p>Klawiatura fortepianu składa się z 88 klawiszy, z czego 36 jest czarnych, a pozostałe są białe. Stosunek liczby czarnych do liczby białych klawiszy można zapisać w postaci:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "4 : 9"
    },
    {
     "litera": "B",
     "html": "9 : 13"
    },
    {
     "litera": "C",
     "html": "9 : 22"
    },
    {
     "litera": "D",
     "html": "13 : 22"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Liczba białych klawiszy: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>88</mn><mo>−</mo><mn>36</mn><mo>=</mo><mn>52</mn></math>.</p><p>Stosunek: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>36</mn><mo>:</mo><mn>52</mn><mo>=</mo><mn>9</mn><mo>:</mo><mn>13</mn></math> (dzielimy przez 4) — opcja B.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "policz najpierw, ile jest białych klawiszy, i skróć otrzymany stosunek",
   "czas_min": 1,
   "haczyk": {
    "sila": 2,
    "rodzaje": [
     "o-co-pytaja"
    ],
    "opis": "Stosunek czarnych do białych, a nie do wszystkich 88 klawiszy"
   }
