    "ułamki"
   ],
   "tresc_html": "<p>W ciągu trzech lat wiek Asi zwiększył się o <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>5</mn></mfrac></math>, a wiek Wojtka o <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>4</mn></mfrac></math>. Średnia arytmetyczna wieku obu tych osób zwiększyła się w tym czasie o</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>3</mn></mfrac></math>"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>2</mn><mn>9</mn></mfrac></math>"
    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>18</mn></mfrac></math>"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>9</mn><mn>40</mn></mfrac></math>"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Wzrost o 3 lata to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>5</mn></mfrac></math> wieku Asi, więc miała 15 lat; wzrost o 3 lata to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>4</mn></mfrac></math> wieku Wojtka, więc miał 12 lat.</p><p>Średnia wieku wynosiła <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>15</mn><mo>+</mo><mn>12</mn></mrow><mn>2</mn></mfrac><mo>=</mo><mn>13,5</mn></math>, a wzrosła o 3, czyli o <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>3</mn><mn>13,5</mn></mfrac><mo>=</mo><mfrac><mn>2</mn><mn>9</mn></mfrac></math> — opcja B.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "3 lata to 1/5 wieku Asi i 1/4 wieku Wojtka — stąd poznasz oba wieki",
   "czas_min": 2,
   "haczyk": {
    "sila": 3,
    "rodzaje": [
     "pozorna-wlasnosc",
     "procent-podstawa"
    ],
    "opis": "Względny wzrost średniej to nie średnia względnych wzrostów; trzeba wyliczyć wiek"
   }
