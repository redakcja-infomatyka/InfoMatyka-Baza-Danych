  {
   "id": "rejonowy_2021_dolnoslaskie_q7",
   "numer": 7,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "procenty",
    "wyrażenia algebraiczne"
   ],
   "tresc_html": "<p>Liczby <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math> są różne i dodatnie oraz <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>p</mi><mo>%</mo></math> liczby <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> jest równe <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>q</mi><mo>%</mo></math> liczby <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math> jest równe <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math>. Wskaż związek, jaki zachodzi między liczbami <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>p</mi></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>q</mi></math>.</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>q</mi><mo>=</mo><mfrac><mn>1</mn><mi>p</mi></mfrac></math>"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>100</mn><mo>−</mo><mi>p</mi><mo>=</mo><mi>q</mi><mo>−</mo><mn>100</mn></math>"
    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>p</mi><mi>q</mi><mo>=</mo><mn>10000</mn></math>"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>p</mi><mo>+</mo><mi>q</mi><mo>=</mo><mn>200</mn></math>"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Z warunków: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi><mo>=</mo><mi>a</mi><mo>·</mo><mfrac><mi>p</mi><mn>100</mn></mfrac></math> oraz <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mi>b</mi><mo>·</mo><mfrac><mi>q</mi><mn>100</mn></mfrac></math>.</p><p>Podstawiając pierwsze do drugiego: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mi>a</mi><mo>·</mo><mfrac><mrow><mi>p</mi><mi>q</mi></mrow><mn>10000</mn></mfrac></math>, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>p</mi><mi>q</mi><mo>=</mo><mn>10000</mn></math> — opcja C.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "zapisz p i q wzorami z a i b, a potem pomnóż je przez siebie",
   "czas_min": 2,
   "haczyk": {
    "sila": 2,
    "rodzaje": [
     "procent-podstawa",
     "pozorna-wlasnosc"
    ],
    "opis": "Procent od a i procent od b mają różne podstawy, więc nie dopełniają się do 200"
   }
