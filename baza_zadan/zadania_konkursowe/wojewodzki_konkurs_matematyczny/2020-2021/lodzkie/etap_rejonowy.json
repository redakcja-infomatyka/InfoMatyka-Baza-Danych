     "litera": "C",
     "html": "jest dwa i pół razy większa od <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math>"
    },
    {
     "litera": "D",
     "html": "jest dwa razy mniejsza od <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math>"
    },
    {
     "litera": "E",
     "html": "jest trzy razy mniejsza od <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math>"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "AI",
    "rozwiazanie_ai_html": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mn>2</mn></mfrac><mo>=</mo><mfrac><mrow><mn>3</mn><mi>b</mi></mrow><mn>4</mn></mfrac><mo>⇒</mo><mi>a</mi><mo>+</mo><mi>b</mi><mo>=</mo><mfrac><mrow><mn>3</mn><mi>b</mi></mrow><mn>2</mn></mfrac><mo>⇒</mo><mi>a</mi><mo>=</mo><mfrac><mi>b</mi><mn>2</mn></mfrac></math>.</p><p>a jest dwa razy mniejsza od b.</p>"
