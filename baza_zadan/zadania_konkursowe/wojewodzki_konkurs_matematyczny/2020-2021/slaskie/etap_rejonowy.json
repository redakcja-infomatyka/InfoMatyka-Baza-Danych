   ],
   "tresc_html": "<p>Różnica liczb <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math> jest mniejsza od 0, a ich iloczyn jest większy od 0.</p>",
   "warianty": [
