    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>&gt;</mo><mi>b</mi><mo>&gt;</mo><mi>c</mi></math>"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>c</mi><mo>&gt;</mo><mi>b</mi><mo>&gt;</mo><mi>a</mi></math>"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi><mo>=</mo><msqrt><mn>48</mn></msqrt><mo>=</mo><msqrt><mrow><mn>16</mn><mo>·</mo><mn>3</mn></mrow></msqrt><mo>=</mo><mn>4</mn><msqrt><mn>3</mn></msqrt></math>, a <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mn>2</mn><msqrt><mn>3</mn></msqrt></math>, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi><mo>&gt;</mo><mi>a</mi></math>. Przybliżamy: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mn>3</mn></msqrt><mo>≈</mo><mn>1,73</mn></math>, stąd <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>≈</mo><mn>3,46</mn></math>; <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mroot><mn>3</mn><mn>3</mn></mroot><mo>≈</mo><mn>1,44</mn></math>, stąd <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>c</mi><mo>≈</mo><mn>2,88</mn></math>. Zatem <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi><mo>&gt;</mo><mi>a</mi><mo>&gt;</mo><mi>c</mi></math>.</p>"
   },
