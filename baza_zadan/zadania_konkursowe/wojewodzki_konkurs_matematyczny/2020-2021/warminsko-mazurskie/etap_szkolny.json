   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Pięć najmniejszych liczb pierwszych: 2, 3, 5, 7, 11. Suma: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>2</mn><mo>+</mo><mn>3</mn><mo>+</mo><mn>5</mn><mo>+</mo><mn>7</mn><mo>+</mo><mn>11</mn><mo>=</mo><mn>28</mn></mrow></math>. Średnia: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>28</mn><mo>:</mo><mn>5</mn><mo>=</mo><mn>5,6</mn></mrow></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "pamiętaj, że 1 nie jest liczbą pierwszą — lista zaczyna się od 2",
   "czas_min": 1,
