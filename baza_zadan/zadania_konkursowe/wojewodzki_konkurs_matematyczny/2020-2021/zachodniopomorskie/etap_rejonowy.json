   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Na miejscu dziesiątek może stać dowolna z 5 cyfr, na miejscu jedności — jedna z pozostałych 4. Liczb jest <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><mo>·</mo><mn>4</mn><mo>=</mo><mn>20</mn></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "5 możliwości na pierwszą cyfrę, o jedną mniej na drugą",
   "czas_min": 2
  },
