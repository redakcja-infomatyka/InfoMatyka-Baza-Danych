    {
     "litera": "A",
     "html": "4 g"
    },
    {
     "litera": "B",
     "html": "5 g"
    },
    {
     "litera": "C",
     "html": "8 g"
    },
    {
     "litera": "D",
     "html": "9 g"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Niech <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>w</mi></math> to waga pierścienia w gramach. Zysk: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><mi>w</mi><mo>−</mo><mo>(</mo><mn>3</mn><mi>w</mi><mo>+</mo><mn>8</mn><mo>)</mo><mo>=</mo><mn>10</mn></math>, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>w</mi><mo>=</mo><mn>18</mn></math>, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>w</mi><mo>=</mo><mn>9</mn></math> g.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "policz, ile antykwariusz zarabia na jednym gramie, i dolicz koszt czyszczenia",
   "czas_min": 2
  },
