   "tematy": [
    "wartość bezwzględna",
    "wyrażenia algebraiczne"
   ],
   "tresc_html": "<p>Wiadomo, że liczba <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> spełnia warunek <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>&lt;</mo><mi>a</mi><mo>&lt;</mo><mn>10</mn></math>. Wówczas wyrażenie <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo lspace=\"0\" rspace=\"0\" stretchy=\"false\">|</mo><mi>a</mi><mo>−</mo><mn>10</mn><mo lspace=\"0\" rspace=\"0\" stretchy=\"false\">|</mo><mo>−</mo><mo lspace=\"0\" rspace=\"0\" stretchy=\"false\">|</mo><mi>a</mi><mo>+</mo><mn>10</mn><mo lspace=\"0\" rspace=\"0\" stretchy=\"false\">|</mo></math> przyjmuje wartość:</p>",
   "warianty": [
