    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Sprowadzamy ułamki do wspólnego mianownika 60: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>w</mi><mo>=</mo><mfrac><mn>1</mn><mn>60</mn></mfrac></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mfrac><mn>11</mn><mn>60</mn></mfrac></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><mfrac><mn>2</mn><mn>60</mn></mfrac></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>z</mi><mo>=</mo><mfrac><mn>9</mn><mn>60</mn></mfrac></math>.</p><p>Wtedy <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>+</mo><mi>z</mi><mo>=</mo><mfrac><mn>2</mn><mn>60</mn></mfrac><mo>+</mo><mfrac><mn>9</mn><mn>60</mn></mfrac><mo>=</mo><mfrac><mn>11</mn><mn>60</mn></mfrac><mo>=</mo><mi>x</mi></math>, więc prawdziwa jest równość <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mi>y</mi><mo>+</mo><mi>z</mi></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "sprowadź wszystkie cztery liczby do sześćdziesiątych i porównuj same liczniki",
