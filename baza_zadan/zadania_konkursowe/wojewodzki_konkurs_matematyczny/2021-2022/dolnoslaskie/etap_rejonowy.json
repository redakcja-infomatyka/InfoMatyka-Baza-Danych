   ],
   "tresc_html": "<p>Liczby <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math> spełniają warunki: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>−</mo><mn>4</mn><mo>&lt;</mo><mi>a</mi><mo>&lt;</mo><mo>−</mo><mn>2</mn></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>&lt;</mo><mi>b</mi><mo>&lt;</mo><mn>4</mn></math>. Wskaż wyrażenie, które ma największą wartość.</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi><mo>−</mo><mi>a</mi></math>"
