   "id": "rejonowy_2022_lodzkie_q11",
   "numer": 11,
   "typ": "zamkniete",
   "punkty": 3,
   "tematy": [
    "podobieństwo i skala",
    "zamiana jednostek"
   ],
   "tresc_html": "<p>Staw o powierzchni 20 arów ma na planie powierzchnię 5 cm². Plan ten został narysowany w skali:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "1 : 40 000"
    },
    {
     "litera": "B",
     "html": "1 : 4 000"
    },
    {
     "litera": "C",
     "html": "1 : 4 000 000"
    },
    {
     "litera": "D",
     "html": "1 : 2000"
    },
    {
     "litera": "E",
     "html": "1 : 200"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Pole stawu: 20 arów = 2000 m² = 20 000 000 cm². Skala pól: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><mo>:</mo><mn>20000000</mn><mo>=</mo><mn>1</mn><mo>:</mo><mn>4000000</mn></math>. Skala liniowa to pierwiastek ze skali pól: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mn>4000000</mn></msqrt><mo>=</mo><mn>2000</mn></math>, czyli 1 : 2000.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "skala pól to kwadrat skali długości — zamień 20 arów na cm² i podziel przez 5",
   "czas_min": 2,
   "haczyk": {
    "sila": 3,
    "rodzaje": [
     "pozorna-wlasnosc",
     "jednostki"
    ],
    "opis": "Dane są polami, a skala dotyczy długości; do tego trzeba zamienić ary"
   }
