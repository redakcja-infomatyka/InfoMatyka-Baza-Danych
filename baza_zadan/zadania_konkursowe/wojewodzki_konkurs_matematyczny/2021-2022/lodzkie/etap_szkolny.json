     "html": "53"
    },
    {
     "litera": "E",
     "html": "73"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>MDCCCXCII to 1892, a MCMXLV to 1945. <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1945</mn><mo>−</mo><mn>1892</mn><mo>=</mo><mn>53</mn></math> lata.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "rozłóż obie liczby rzymskie na tysiące, setki i dziesiątki, dopiero potem odejmij",
   "czas_min": 1
  },
  {
