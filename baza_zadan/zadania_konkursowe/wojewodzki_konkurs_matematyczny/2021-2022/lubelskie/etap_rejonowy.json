     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>216</mn></math> cm²"
    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>180</mn></math> cm²"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>360</mn></math> cm²"
    }
   ],
