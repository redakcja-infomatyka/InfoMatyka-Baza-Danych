    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Pole powierzchni całkowitej: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi><mo>=</mo><mn>2</mn><mo>·</mo><mo>(</mo><mn>3</mn><mo>·</mo><mn>6</mn><mo>+</mo><mn>6</mn><mo>·</mo><mn>10</mn><mo>+</mo><mn>3</mn><mo>·</mo><mn>10</mn><mo>)</mo><mo>=</mo><mn>2</mn><mo>·</mo><mn>108</mn><mo>=</mo><mn>216</mn></math> cm².</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "pole całkowite to podwojona suma pól trzech różnych ścian",
   "czas_min": 1
