   "punkty": 1,
   "tematy": [
    "wyrażenia algebraiczne"
   ],
   "tresc_html": "<p>Którą ze wskazanych wielkości <u>wyznaczono błędnie</u> z równania: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mi>c</mi><mi>x</mi><mo>+</mo><mi>y</mi></math>?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><mi>a</mi><mo>−</mo><mi>c</mi><mi>x</mi></math>"
