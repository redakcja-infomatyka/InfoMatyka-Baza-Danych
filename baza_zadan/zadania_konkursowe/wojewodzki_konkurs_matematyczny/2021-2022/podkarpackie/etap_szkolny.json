   ],
   "tresc_html": "<p>Ile razy liczba <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mrow><mo>(</mo><mn>99</mn><mo>+</mo><mn>26</mn><mo>)</mo></mrow><mn>3</mn></msup></math> jest większa od liczby <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mrow><mo>(</mo><mn>0,27</mn><mo>+</mo><mn>0,98</mn><mo>)</mo></mrow><mn>3</mn></msup></math>:</p>",
