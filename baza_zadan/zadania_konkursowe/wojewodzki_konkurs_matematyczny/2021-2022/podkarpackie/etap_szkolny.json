    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Liczby złożone mniejsze od 15 to 4, 6, 8, 9, 10, 12, 14. Ich suma: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mo>+</mo><mn>6</mn><mo>+</mo><mn>8</mn><mo>+</mo><mn>9</mn><mo>+</mo><mn>10</mn><mo>+</mo><mn>12</mn><mo>+</mo><mn>14</mn><mo>=</mo><mn>63</mn></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "wypisz liczby złożone do 15 — 1 nie jest ani pierwsza, ani złożona",
   "czas_min": 2,
   "haczyk": {
    "sila": 2,
    "rodzaje": [
     "pozorna-wlasnosc",
     "zbior-liczb"
    ],
    "opis": "Liczba 1 nie jest ani pierwsza, ani złożona; nie wolno jej dodać do liczb złożonych"
   }
  },
  {
   "id": "szkolny_2022_podkarpackie_q4",
   "numer": 4,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "wyrażenia algebraiczne"
   ],
   "tresc_html": "<p>Liczba <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> jest liczbą przeciwną do liczby odwrotnej do <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math>. Ile jest równy iloczyn liczb <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math>?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "1"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>−</mo><mfrac><mn>1</mn><mrow><mi>a</mi><mi>b</mi></mrow></mfrac></math>"
    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>−</mo><mi>a</mi><mi>b</mi></math>"
    },
    {
     "litera": "D",
     "html": "−1"
    },
    {
     "litera": "E",
     "html": "0"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Liczba odwrotna do <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math> to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mi>b</mi></mfrac></math>, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mo>−</mo><mfrac><mn>1</mn><mi>b</mi></mfrac></math>. Wtedy <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>·</mo><mi>b</mi><mo>=</mo><mo>−</mo><mfrac><mn>1</mn><mi>b</mi></mfrac><mo>·</mo><mi>b</mi><mo>=</mo><mo>−</mo><mn>1</mn></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "przetłumacz treść na wzór krok po kroku: najpierw odwrotność b, potem liczba przeciwna",
   "czas_min": 1,
