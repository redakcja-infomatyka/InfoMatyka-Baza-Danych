   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Sumy: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>99</mn><mo>+</mo><mn>26</mn><mo>=</mo><mn>125</mn></math> oraz <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0,27</mn><mo>+</mo><mn>0,98</mn><mo>=</mo><mn>1,25</mn></math>. Ponieważ <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>125</mn><mo>:</mo><mn>1,25</mn><mo>=</mo><mn>100</mn></math>, szukana liczba to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>100</mn><mn>3</mn></msup><mo>=</mo><mn>1 000 000</mn></math>.</p>"
   },
   "w_pamieci": "pomysl",
   "wskazowka": "zsumuj oba nawiasy i porównaj same podstawy, zanim cokolwiek podniesiesz do sześcianu",
   "czas_min": 2
  },
  {
