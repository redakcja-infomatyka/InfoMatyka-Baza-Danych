    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>c</mi><mo>=</mo><mfrac><mi>a</mi><mi>x</mi></mfrac><mo>−</mo><mfrac><mi>y</mi><mi>x</mi></mfrac></math>"
    },
    {
     "litera": "E",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mfrac><mrow><mi>a</mi><mo>−</mo><mi>y</mi></mrow><mi>c</mi></mfrac></math>"
    }
