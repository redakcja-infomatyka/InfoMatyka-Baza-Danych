    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Niech pierwszy etap ma <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> km, drugi <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>−</mo><mn>15</mn></math>, trzeci <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>−</mo><mn>30</mn></math>. <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mi>x</mi><mo>−</mo><mn>45</mn><mo>=</mo><mn>480</mn></math>, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mn>175</mn></math>. Najkrótszy (trzeci) etap: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>175</mn><mo>−</mo><mn>30</mn><mo>=</mo><mn>145</mn></math> km.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "oznacz pierwszy etap i zapisz pozostałe jako krótsze o 15 i o 30 km",
