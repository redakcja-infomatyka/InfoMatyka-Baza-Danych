   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "liczby pierwsze"
   ],
   "tresc_html": "<p>Suma wszystkich liczb złożonych mniejszych od 15 jest równa:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "63"
