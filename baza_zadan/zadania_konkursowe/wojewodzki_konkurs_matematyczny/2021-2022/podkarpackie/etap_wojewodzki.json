   "tresc_html": "<p>Sześcian oraz ostrosłup prawidłowy czworokątny o krawędzi podstawy równej 3 cm i wysokości trzykrotnie dłuższej mają równe objętości. Ile wynosi pole powierzchni sześcianu?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "54 cm²"
    },
    {
     "litera": "B",
     "html": "52 cm²"
    },
    {
     "litera": "C",
     "html": "36 cm²"
    },
    {
     "litera": "D",
     "html": "30 cm²"
    },
    {
     "litera": "E",
     "html": "27 cm²"
    }
   ],
