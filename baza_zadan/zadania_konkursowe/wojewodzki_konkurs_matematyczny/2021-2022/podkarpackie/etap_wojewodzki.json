     "html": "9"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "E",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Odwrotność <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>2</mn><mfrac><mn>5</mn><mn>6</mn></mfrac></mrow></math>, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>17</mn><mn>6</mn></mfrac></math>, to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>6</mn><mn>17</mn></mfrac></math>, a jej kwadrat to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>36</mn><mn>289</mn></mfrac></math>. Odwrotność <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>2</mn><mn>17</mn></mfrac></math> to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>17</mn><mn>2</mn></mfrac></math>, a jej kwadrat to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>289</mn><mn>4</mn></mfrac></math>. Iloczyn: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mn>36</mn><mn>289</mn></mfrac><mo>·</mo><mfrac><mn>289</mn><mn>4</mn></mfrac><mo>=</mo><mn>9</mn></mrow></math>.</p>"
   },
   "w_pamieci": "wprost",
