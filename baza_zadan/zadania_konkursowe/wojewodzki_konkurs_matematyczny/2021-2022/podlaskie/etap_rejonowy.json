   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Liczby mają postać <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>5</mn><mi>k</mi></mrow></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>8</mn><mi>k</mi></mrow></math>. Różnica: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>8</mn><mi>k</mi><mo>−</mo><mn>5</mn><mi>k</mi><mo>=</mo><mn>3</mn><mi>k</mi><mo>=</mo><mn>36</mn></mrow></math>, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>k</mi><mo>=</mo><mn>12</mn></mrow></math>. Szukane liczby to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>60</mn></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>96</mn></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "różnica to 3 części stosunku — policz najpierw, ile wynosi jedna część",
   "czas_min": 1
