   ],
   "tresc_html": "<p>Liczba <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mo>−</mo><msup><mn>2</mn><mn>2</mn></msup></math> jest rozwiązaniem równania</p>",
