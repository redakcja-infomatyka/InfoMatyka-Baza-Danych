    "równania z jedną zmienną"
   ],
   "tresc_html": "<p>W dwóch słoikach różnej pojemności jest 1,75 kg miodu. W jednym słoiku jest o 85 dag miodu mniej niż w drugim. Ile gramów miodu jest w mniejszym słoiku?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "45 g"
    },
    {
     "litera": "B",
     "html": "130 g"
    },
    {
     "litera": "C",
     "html": "450 g"
    },
    {
     "litera": "D",
     "html": "1 300 g"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Łącznie miodu jest <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1750</mn></math> g (bo 1,75 kg), a różnica wynosi <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>85</mn></math> dag, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>850</mn></math> g. Niech <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> oznacza ilość miodu w mniejszym słoiku: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>x</mi><mo>+</mo><mn>850</mn><mo>=</mo><mn>1750</mn></math>, skąd <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mn>450</mn></math> g.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "przelicz kilogramy i dekagramy na gramy, potem odejmij różnicę i podziel resztę na pół",
   "czas_min": 2,
   "haczyk": {
    "sila": 2,
    "rodzaje": [
     "jednostki"
    ],
    "opis": "Dane w kg i dag, odpowiedź w gramach; wynik w dekagramach kusi wariantem z tą samą liczbą"
   }
  },
