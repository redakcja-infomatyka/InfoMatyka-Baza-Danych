   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Wskazówka minutowa robi pełny obrót 360° w 60 minut, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn></math>° na minutę, więc 60° odpowiada <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>60</mn><mo>:</mo><mn>6</mn><mo>=</mo><mn>10</mn></math> minutom. Wskazówka godzinowa robi pełny obrót w 12 h, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0,5</mn></math>° na minutę, więc w 10 minut obraca się o <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><mo>·</mo><mn>0,5</mn><mo>=</mo><mn>5</mn></math>°.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "wskazówka godzinowa obraca się 12 razy wolniej niż minutowa",
   "czas_min": 1
  },
