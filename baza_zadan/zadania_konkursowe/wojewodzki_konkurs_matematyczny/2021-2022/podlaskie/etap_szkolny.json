    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Czerwonych hulajnóg jest <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>13</mn><mo>−</mo><mn>5</mn><mo>=</mo><mn>8</mn></math> (bo czerwonych rowerów jest 5, a czerwonych pojazdów łącznie 13). Wszystkich hulajnóg jest zatem <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>8</mn><mo>+</mo><mn>7</mn><mo>=</mo><mn>15</mn></math> (bo 7 ma inny kolor). Rowerów jest <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>30</mn><mo>−</mo><mn>15</mn><mo>=</mo><mn>15</mn></math>.</p>"
   },
