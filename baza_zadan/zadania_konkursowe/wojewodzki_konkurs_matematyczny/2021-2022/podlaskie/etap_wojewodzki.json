    },
    {
     "litera": "C",
     "html": "45°, 60°, 75°."
    },
    {
     "litera": "D",
     "html": "30°, 60°, 90°."
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Dwusieczna kąta 60° dzieli go na dwa kąty po 30°. W trójkącie o kątach 30°, 60°, 90° dwusieczna z wierzchołka kąta 60° odcina trójkąt o kątach 30°, 30°, 120° — jest on równoramienny. Drugi z powstałych trójkątów ma wtedy kąty 30°, 60°, 90°.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "sprawdź, przy którym kącie połowa po dwusiecznej zrówna się z innym kątem trójkąta",
