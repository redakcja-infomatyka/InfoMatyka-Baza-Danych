     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mo>,</mo><mo>(</mo><mn>3</mn><mo>)</mo><mo>−</mo><mn>4</mn><mfrac><mn>1</mn><mn>9</mn></mfrac><mo>&lt;</mo><mn>2</mn></math>"
