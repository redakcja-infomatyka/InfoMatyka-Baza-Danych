   "punkty": 1,
   "tematy": [
    "zadania tekstowe na równania",
    "stężenie procentowe / mieszaniny",
    "równania z jedną zmienną"
   ],
   "tresc_html": "<p>Wybierz równanie, za pomocą którego można rozwiązać zadanie: „Ile kilogramów kwasu siarkowego 10-procentowego i kilogramów kwasu siarkowego 20-procentowego należy zmieszać, aby otrzymać 20 kg 18-procentowego kwasu siarkowego? Przez <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> oznaczono liczbę kilogramów 10-procentowego kwasu siarkowego.</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><mo>%</mo><mo>·</mo><mi>x</mi><mo>+</mo><mn>20</mn><mo>%</mo><mo>·</mo><mo>(</mo><mn>20</mn><mo>−</mo><mi>x</mi><mo>)</mo><mo>=</mo><mn>18</mn><mo>%</mo><mo>·</mo><mn>20</mn></math>"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><mo>%</mo><mo>·</mo><mi>x</mi><mo>+</mo><mn>20</mn><mo>%</mo><mo>·</mo><mo>(</mo><mn>20</mn><mo>+</mo><mi>x</mi><mo>)</mo><mo>=</mo><mn>18</mn><mo>%</mo><mo>·</mo><mn>20</mn></math>"
    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0,10</mn><mo>·</mo><mi>x</mi><mo>+</mo><mn>0,20</mn><mo>·</mo><mi>x</mi><mo>=</mo><mn>0,18</mn><mo>·</mo><mn>20</mn></math>"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0,10</mn><mo>·</mo><mi>x</mi><mo>+</mo><mn>0,20</mn><mo>·</mo><mo>(</mo><mn>20</mn><mo>−</mo><mi>x</mi><mo>)</mo><mo>=</mo><mn>20</mn></math>"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Masa czystego kwasu przed zmieszaniem musi być równa masie po zmieszaniu, a kwasu 20-procentowego jest <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>20</mn><mo>−</mo><mi>x</mi></math> kg: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><mo>%</mo><mo>·</mo><mi>x</mi><mo>+</mo><mn>20</mn><mo>%</mo><mo>·</mo><mo>(</mo><mn>20</mn><mo>−</mo><mi>x</mi><mo>)</mo><mo>=</mo><mn>18</mn><mo>%</mo><mo>·</mo><mn>20</mn></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "drugiego kwasu jest 20 − x kg; po obu stronach musi zgadzać się masa czystego kwasu",
   "czas_min": 2
  },
  {
