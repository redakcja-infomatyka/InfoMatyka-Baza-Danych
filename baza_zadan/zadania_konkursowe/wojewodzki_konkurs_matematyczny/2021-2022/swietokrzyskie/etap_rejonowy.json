    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Skoro <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>9</mn><mo>&lt;</mo><mn>10</mn></math>, to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mn>10</mn></msqrt><mo>&gt;</mo><mn>3</mn></math>, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><msqrt><mn>10</mn></msqrt><mo>&gt;</mo><mn>9</mn></math>, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>3</mn><msqrt><mn>10</mn></msqrt></mrow><mn>2</mn></mfrac><mo>&gt;</mo><mn>4,5</mn></math>.</p>"
