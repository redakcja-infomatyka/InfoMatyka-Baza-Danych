    "układ współrzędnych"
   ],
   "tresc_html": "<p>Na osi liczbowej zaznaczono liczbę <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> oraz dwie liczby <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>c</mi></math>, leżące w jednakowej odległości od liczby <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math>, takie, że <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi><mo>&lt;</mo><mi>a</mi></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>&lt;</mo><mi>c</mi></math>. Która z poniższych równości jest prawdziwa?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mfrac><mrow><mi>b</mi><mo>−</mo><mi>c</mi></mrow><mn>2</mn></mfrac></math>"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mfrac><mrow><mi>c</mi><mo>−</mo><mi>b</mi></mrow><mn>2</mn></mfrac></math>"
    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mfrac><mrow><mi>b</mi><mo>+</mo><mi>c</mi></mrow><mn>2</mn></mfrac></math>"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mfrac><mrow><mo>−</mo><mi>b</mi><mo>−</mo><mi>c</mi></mrow><mn>2</mn></mfrac></math>"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Liczby <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>c</mi></math> leżą w jednakowej odległości od <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math>, po jej przeciwnych stronach, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> jest środkiem odcinka <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi><mi>c</mi></math>: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mfrac><mrow><mi>b</mi><mo>+</mo><mi>c</mi></mrow><mn>2</mn></mfrac></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "podstaw konkretne liczby, np. b = 1, c = 5, i sprawdź, który wzór daje właściwe a",
   "czas_min": 1
  },
  {
   "id": "rejonowy_2021-2022_swietokrzyskie_q3",
   "numer": 3,
   "typ": "prawda_falsz",
