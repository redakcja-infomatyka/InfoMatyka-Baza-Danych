   "tematy": [
    "działania na pierwiastkach",
    "wyłączanie czynnika przed znak pierwiastka"
   ],
   "tresc_html": "<p>Dane są liczby <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><msqrt><mn>48</mn></msqrt></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi><mo>=</mo><msqrt><mn>135</mn></msqrt></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>c</mi><mo>=</mo><msqrt><mn>192</mn></msqrt></math></p><p>Oceń, czy poniższe zdania są prawdziwe. Zaznacz P, jeśli zdanie jest prawdziwe, lub F – jeśli jest fałszywe.</p>",
   "warianty": [
    {
     "litera": "1",
     "html": "Suma liczb <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>c</mi></math> jest mniejsza niż 20."
    },
    {
     "litera": "2",
     "html": "Różnica liczb <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>c</mi></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> jest liczbą naturalną."
    },
    {
     "litera": "3",
     "html": "Iloczyn liczb <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math> jest równy <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>36</mn><msqrt><mn>5</mn></msqrt></math>."
    },
    {
     "litera": "4",
     "html": "Iloraz liczb <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>c</mi></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> jest równy 2."
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "FFPP",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><msqrt><mn>48</mn></msqrt><mo>=</mo><mn>4</mn><msqrt><mn>3</mn></msqrt><mo>,</mo><mi>b</mi><mo>=</mo><msqrt><mn>135</mn></msqrt><mo>=</mo><mn>3</mn><msqrt><mn>15</mn></msqrt><mo>,</mo><mi>c</mi><mo>=</mo><msqrt><mn>192</mn></msqrt><mo>=</mo><mn>8</mn><msqrt><mn>3</mn></msqrt></math>.</p><ul><li><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi><mo>+</mo><mi>c</mi><mo>≈</mo><mn>25,5</mn></math> — F.</li><li><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>c</mi><mo>−</mo><mi>a</mi><mo>=</mo><mn>4</mn><msqrt><mn>3</mn></msqrt></math>, liczba niewymierna — F.</li><li><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>·</mo><mi>b</mi><mo>=</mo><mn>36</mn><msqrt><mn>5</mn></msqrt></math> — P.</li><li><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>c</mi><mo>:</mo><mi>a</mi><mo>=</mo><mn>2</mn></math> — P.</li></ul>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "wyłącz czynniki przed pierwiastki: √48 = 4√3, i tak samo z pozostałymi",
   "czas_min": 5
