    },
    {
     "litera": "B",
     "html": "20 kg"
    },
    {
     "litera": "C",
     "html": "15 kg"
    },
    {
     "litera": "D",
     "html": "10 kg"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Niech Julia waży <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> kg. Ariel waży <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>x</mi></math>, Paweł <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mi>x</mi></math>. Suma: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mi>x</mi><mo>=</mo><mn>60</mn></math>, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mn>10</mn></math> kg.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "wyraź wagi Pawła i Ariela w wagach Julii",
   "czas_min": 1
  },
  {
