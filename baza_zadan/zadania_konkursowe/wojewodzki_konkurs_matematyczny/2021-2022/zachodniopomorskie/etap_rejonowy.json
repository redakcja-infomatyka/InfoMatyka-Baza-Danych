   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Największa liczba to 4321, najmniejsza to 1234. Różnica wynosi <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4321</mn><mo>−</mo><mn>1234</mn><mo>=</mo><mn>3087</mn></math>.</p>"
