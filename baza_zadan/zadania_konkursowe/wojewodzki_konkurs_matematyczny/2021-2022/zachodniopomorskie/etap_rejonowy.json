     "html": "25"
    },
    {
     "litera": "D",
     "html": "40"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>+</mo><mi>d</mi><mo>=</mo><mn>50</mn></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>+</mo><mn>0,5</mn><mi>d</mi><mo>=</mo><mn>35</mn></math>, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>a</mi><mo>+</mo><mi>d</mi><mo>=</mo><mn>70</mn></math>. Odejmując: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mn>20</mn></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "załóż, że wszyscy kupili bilety ulgowe, i zobacz, ile złotówek brakuje",
   "czas_min": 2
  },
  {
