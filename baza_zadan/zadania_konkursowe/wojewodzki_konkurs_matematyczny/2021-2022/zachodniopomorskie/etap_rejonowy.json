   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Ostrosłup o <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi></math>-kątnej podstawie ma łącznie <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mi>n</mi><mo>+</mo><mn>2</mn></math> ścian, krawędzi i wierzchołków. Tylko dla 30 wychodzi całkowite <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi><mo>=</mo><mn>7</mn></math> (podstawa siedmiokątna).</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "zapisz liczbę ścian, krawędzi i wierzchołków ostrosłupa o podstawie n-kąta",
