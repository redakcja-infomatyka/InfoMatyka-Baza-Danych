    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>20 litrów to 20000 cm³. Wysokość = objętość : pole podstawy: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>20000</mn><mo>:</mo><mo>(</mo><mn>50</mn><mo>·</mo><mn>16</mn><mo>)</mo><mo>=</mo><mn>25</mn></math> cm.</p>"
