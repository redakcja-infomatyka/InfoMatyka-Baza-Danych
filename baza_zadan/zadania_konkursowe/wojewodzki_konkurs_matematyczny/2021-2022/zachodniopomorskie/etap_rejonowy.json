    {
     "litera": "C",
     "html": "jednego"
    },
    {
     "litera": "D",
     "html": "siedemdziesięciu siedmiu"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>7 uczniów rozwiązuje 7 zadań w 7 minut, więc 1 uczeń rozwiązuje 1 zadanie w 7 minut, czyli w 77 minutach 11 zadań. Do 77 zadań w 77 minut potrzeba <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>77</mn><mo>:</mo><mn>11</mn><mo>=</mo><mn>7</mn></math> uczniów.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "sprawdź najpierw, ile zadań robi jeden uczeń w 7 minut",
