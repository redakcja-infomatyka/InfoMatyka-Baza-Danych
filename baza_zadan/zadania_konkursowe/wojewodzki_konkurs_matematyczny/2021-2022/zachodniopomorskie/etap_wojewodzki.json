   ],
   "tresc_html": "<p>Dane są liczby: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mn>3</mn></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><mn>1</mn></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>z</mi><mo>=</mo><mn>2</mn></math> czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mi>y</mi><mo>+</mo><mi>z</mi></math>. Na którym etapie poniższego rachunku popełniono błąd:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>(</mo><mi>x</mi><mo>−</mo><mi>y</mi><mo>)</mo><mo>=</mo><mo>(</mo><mi>y</mi><mo>+</mo><mi>z</mi><mo>)</mo><mo>(</mo><mi>x</mi><mo>−</mo><mi>y</mi><mo>)</mo></math>"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>x</mi><mn>2</mn></msup><mo>−</mo><mi>x</mi><mi>y</mi><mo>−</mo><mi>z</mi><mi>x</mi><mo>=</mo><mi>x</mi><mi>y</mi><mo>−</mo><msup><mi>y</mi><mn>2</mn></msup><mo>−</mo><mi>y</mi><mi>z</mi></math>"
    },
    {
     "litera": "C",
     "html": "dalej: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>(</mo><mi>x</mi><mo>−</mo><mi>y</mi><mo>−</mo><mi>z</mi><mo>)</mo><mo>=</mo><mi>y</mi><mo>(</mo><mi>x</mi><mo>−</mo><mi>y</mi><mo>−</mo><mi>z</mi><mo>)</mo></math>"
    },
