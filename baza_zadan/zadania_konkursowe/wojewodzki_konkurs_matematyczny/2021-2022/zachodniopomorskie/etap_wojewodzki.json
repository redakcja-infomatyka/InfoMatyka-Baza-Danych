   ],
   "tresc_html": "<p>Prostokątną kartkę papieru o przekątnej długości 280 cm zginamy na cztery równe części wzdłuż jednej krawędzi oraz na trzy równe części wzdłuż drugiej krawędzi. Otrzymujemy kwadrat. Jaką długość ma krótszy bok kartki?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "84 cm"
    },
    {
     "litera": "B",
     "html": "224 cm"
    },
    {
     "litera": "C",
     "html": "126 cm"
    },
    {
     "litera": "D",
     "html": "168 cm"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Bok zginany na 4 części ma długość <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math>, na 3 części — <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math>. Złożona część jest kwadratem, gdy <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mfrac><mn>4</mn><mn>3</mn></mfrac><mi>b</mi></math>. Z tw. Pitagorasa <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>a</mi><mn>2</mn></msup><mo>+</mo><msup><mi>b</mi><mn>2</mn></msup><mo>=</mo><msup><mn>280</mn><mn>2</mn></msup></math>, po podstawieniu <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi><mo>=</mo><mn>168</mn></math> — to krótszy bok kartki.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "zagięcia dają stosunek boków 4 : 3, więc przekątna jest jak w trójkącie 3-4-5",
   "czas_min": 2
  },
  {
