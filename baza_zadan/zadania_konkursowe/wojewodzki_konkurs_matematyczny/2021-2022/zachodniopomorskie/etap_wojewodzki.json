    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><msqrt><mn>2</mn></msqrt></mfrac></math>"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Niech bok mniejszego kwadratu ma długość <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math>. Jego przekątna, czyli bok większego kwadratu, wynosi <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><msqrt><mn>2</mn></msqrt></math>, więc pole większego kwadratu to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><msup><mi>a</mi><mn>2</mn></msup></math>. Stosunek pól: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msup><mi>a</mi><mn>2</mn></msup><mrow><mn>2</mn><msup><mi>a</mi><mn>2</mn></msup></mrow></mfrac><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "przyjmij bok mniejszego kwadratu za 1 i policz oba pola",
   "czas_min": 2
  },
