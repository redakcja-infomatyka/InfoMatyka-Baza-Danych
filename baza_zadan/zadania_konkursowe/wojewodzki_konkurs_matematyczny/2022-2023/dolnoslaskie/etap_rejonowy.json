    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Suma liczb 1, 2, 3, 4, 5 to 15 i nie zmienia się po dopisaniu zer. Po dopisaniu <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi></math> zer jest <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><mo>+</mo><mi>n</mi></math> liczb, więc średnia to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>15</mn><mrow><mn>5</mn><mo>+</mo><mi>n</mi></mrow></mfrac></math>. Z warunku <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>15</mn><mrow><mn>5</mn><mo>+</mo><mi>n</mi></mrow></mfrac><mo>&lt;</mo><mn>1</mn></math> wynika <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi><mo>&gt;</mo><mn>10</mn></math>, więc najmniejsze to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi><mo>=</mo><mn>11</mn></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "suma zestawu się nie zmienia — pytaj tylko, ilu elementów trzeba, by średnia spadła poniżej 1",
