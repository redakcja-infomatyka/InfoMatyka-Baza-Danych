   "tematy": [
    "prawdopodobieństwo"
   ],
   "tresc_html": "<p>Samorząd szkolny podczas zabawy karnawałowej przeprowadził loterię. W tym celu przygotował 50 losów. Ile losów wygrywających jest wśród wszystkich losów, jeżeli wiadomo, że prawdopodobieństwo wygrania na tej loterii wynosi <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>10</mn></mfrac></math>?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "1"
    },
    {
     "litera": "B",
     "html": "10"
    },
    {
     "litera": "C",
     "html": "5"
    },
    {
     "litera": "D",
     "html": "15"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Liczba losów wygrywających: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>50</mn><mo>·</mo><mfrac><mn>1</mn><mn>10</mn></mfrac><mo>=</mo><mn>5</mn></mrow></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "liczba losów wygrywających to prawdopodobieństwo razy liczba wszystkich losów",
