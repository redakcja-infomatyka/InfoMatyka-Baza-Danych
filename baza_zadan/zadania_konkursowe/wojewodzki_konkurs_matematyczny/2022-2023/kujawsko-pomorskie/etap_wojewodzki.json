   "tresc_html": "<p>Najmniejszy z kątów trójkąta <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>XYZ</mi></math> jest o 30° mniejszy od drugiego kąta i cztery razy mniejszy od trzeciego kąta. Ile wynosi miara najmniejszego kąta trójkąta <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>XYZ</mi></math>?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "55°"
    },
    {
     "litera": "B",
     "html": "30°"
    },
    {
     "litera": "C",
     "html": "25°"
    },
    {
     "litera": "D",
     "html": "20°"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_html": "<p>Niech najmniejszy kąt ma miarę <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math>. Drugi kąt to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>a</mi><mo>+</mo><mn>30</mn><mo>°</mo></mrow></math>, a trzeci to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>4</mn><mi>a</mi></mrow></math>. Suma kątów: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>a</mi><mo>+</mo><mo>(</mo><mi>a</mi><mo>+</mo><mn>30</mn><mo>°</mo><mo>)</mo><mo>+</mo><mn>4</mn><mi>a</mi><mo>=</mo><mn>180</mn><mo>°</mo></mrow></math>, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>6</mn><mi>a</mi><mo>=</mo><mn>150</mn><mo>°</mo></mrow></math>, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>a</mi><mo>=</mo><mn>25</mn><mo>°</mo></mrow></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "nazwij najmniejszy kąt a i zapisz pozostałe jako a+30° i 4a",
   "czas_min": 1
