     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>13</mn><msup><mi>dm</mi><mn>2</mn></msup></mrow></math>"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>6</mn><msup><mi>dm</mi><mn>2</mn></msup></mrow></math>"
