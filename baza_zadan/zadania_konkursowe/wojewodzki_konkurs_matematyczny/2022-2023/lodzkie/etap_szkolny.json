   ],
   "tresc_html": "<p>Rozważmy liczbę <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>10</mn><mo>·</mo><mn>333757983</mn><mo>+</mo><mi>x</mi></mrow></math>, gdzie <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> jest pewną cyfrą. Dokończ zdanie, wskaż poprawną odpowiedź pośród podanych.</p><p>Liczba ta jest podzielna przez 36</p>",
   "warianty": [
    {
     "litera": "A",
