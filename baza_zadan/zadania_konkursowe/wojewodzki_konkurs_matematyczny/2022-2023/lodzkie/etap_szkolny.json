   ],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Po odcięciu kwadratu <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>×</mo><mn>3</mn></math> z arkusza <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>×</mo><mn>5</mn></math> zostaje prostokąt <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>×</mo><mn>2</mn></math>.</p><p>Odcinając kolejno kwadraty <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>×</mo><mn>2</mn></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>×</mo><mn>1</mn></math> zostaje kolejno prostokąt <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>×</mo><mn>1</mn></math>, a na końcu <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>×</mo><mn>1</mn></math>, czyli pole 1 dm².</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "po każdym cięciu zapamiętuj wymiary reszty, a pole licz dopiero na końcu",
