    {
     "litera": "B",
     "html": "Podwyżka w obu sklepach jest taka sama."
    },
    {
     "litera": "C",
     "html": "Podwyżka w sklepie A jest większa niż w sklepie B."
    },
    {
     "litera": "D",
     "html": "Podwyżka w sklepie B jest większa niż w sklepie A."
    },
    {
     "litera": "E",
     "html": "Po podwyżce w sklepie A jest drożej niż w sklepie B."
    }
