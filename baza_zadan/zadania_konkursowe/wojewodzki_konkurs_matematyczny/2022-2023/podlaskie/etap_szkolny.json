  {
   "id": "szkolny_2022_podlaskie_q26",
   "numer": 26,
   "typ": "otwarte",
   "punkty": 2,
   "tematy": [
    "prędkość / droga / czas"
   ],
   "tresc_html": "<p>Bliźniacy Bolek i Lolek chodzą do tej samej szkoły. Bolek idzie do szkoły 20 minut, a Lolek 30 minut. Ile minut po Lolku wyszedł z domu Bolek, jeżeli spotkał Lolka w połowie drogi do szkoły? Zapisz obliczenia.</p>",
   "warianty": [],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "5 minut (Bolek wyszedł 5 minut po Lolku)",
    "zrodlo": "klucz",
    "rozwiazanie_html": "<p>Bolek pokonuje połowę drogi w <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>20</mn><mo>:</mo><mn>2</mn><mo>=</mo><mn>10</mn></mrow></math> minut, a Lolek w <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>30</mn><mo>:</mo><mn>2</mn><mo>=</mo><mn>15</mn></mrow></math> minut. Aby spotkać się w połowie drogi w tym samym momencie, Bolek musi wyjść <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>15</mn><mo>−</mo><mn>10</mn><mo>=</mo><mn>5</mn></mrow></math> minut po Lolku.</p>"
   },
   "czas_min": 2
  },
  {
