    {
     "litera": "D",
     "html": "110°"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>O 9:30 wskazówka minutowa jest w połowie tarczy: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>180</mn><mo>°</mo></mrow></math>. Wskazówka godzinowa jest w połowie drogi między 9 a 10: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>9</mn><mo>·</mo><mn>30</mn><mo>°</mo><mo>+</mo><mn>15</mn><mo>°</mo><mo>=</mo><mn>285</mn><mo>°</mo></mrow></math>. Kąt między nimi: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>285</mn><mo>°</mo><mo>−</mo><mn>180</mn><mo>°</mo><mo>=</mo><mn>105</mn><mo>°</mo></mrow></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "o wpół do dziesiątej wskazówka godzinowa stoi w połowie między 9 a 10",
   "czas_min": 1,
   "haczyk": {
