    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Rok liczy ok. 365,25 dnia (z latami przestępnymi), więc 100 lat to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>100</mn><mo>·</mo><mn>365,25</mn><mo>=</mo><mn>36525</mn></mrow></math> dni. Liczba godzin: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>36525</mn><mo>·</mo><mn>24</mn><mo>=</mo><mn>876600</mn></mrow></math>, czyli ok. 877 000.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "policz najpierw, ile godzin ma jeden rok",
   "czas_min": 1
