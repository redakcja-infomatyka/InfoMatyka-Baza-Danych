   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "kąty",
    "kalendarz i czas"
   ],
   "tresc_html": "<p>Jaką miarę ma kąt utworzony przez minutową i godzinową wskazówkę zegara o godzinie 9:30?</p>",
