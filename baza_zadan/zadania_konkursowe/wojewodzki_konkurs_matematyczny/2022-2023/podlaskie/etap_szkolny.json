   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "trójkąty"
   ],
   "tresc_html": "<p>Obwód pewnego trójkąta wynosi 30 cm. Które z odcinków o podanych niżej długościach (w cm) mogą być jego bokami?</p>",
   "warianty": [
