    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Liczba dzieli się przez 6, gdy jest parzysta i dzieli się przez 3. Suma znanych cyfr: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>3</mn><mo>+</mo><mn>1</mn><mo>+</mo><mn>5</mn><mo>+</mo><mn>8</mn><mo>+</mo><mn>6</mn><mo>=</mo><mn>23</mn></mrow></math>, więc # musi dawać resztę 1 z dzielenia przez 3, a jednocześnie być parzyste. Jedyna taka cyfra to 4.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "przez 6 dzieli się to, co dzieli się jednocześnie przez 2 i przez 3",
   "czas_min": 2
  },
  {
