   "tematy": [
    "ułamki okresowe / rozwinięcia dziesiętne",
    "reszta z dzielenia"
   ],
   "tresc_html": "<p>Sto dwudziestą siódmą cyfrą po przecinku w liczbie <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>0,5</mn><mo>(</mo><mn>0357</mn><mo>)</mo></mrow></math> jest</p>",
   "warianty": [
