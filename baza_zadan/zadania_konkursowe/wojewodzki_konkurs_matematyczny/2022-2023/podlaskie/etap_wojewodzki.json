     "html": "1500 zł"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Niech <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> oznacza zarobek w pierwszym tygodniu. Drugi tydzień to 1,2x, trzeci — 1,25·1,2x=1,5x. Z równania <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>3,7</mn><mi>x</mi><mo>=</mo><mn>3700</mn></mrow></math> mamy x=1000, więc trzeci tydzień to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>1,5</mn><mo>·</mo><mn>1000</mn><mo>=</mo><mn>1500</mn></mrow></math> zł.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "wyraź zarobki z drugiego i trzeciego tygodnia jako wielokrotność pierwszego",
