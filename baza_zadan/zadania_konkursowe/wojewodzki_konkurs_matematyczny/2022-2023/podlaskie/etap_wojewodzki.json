     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>25</mn><mn>198</mn></mfrac></math>"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
