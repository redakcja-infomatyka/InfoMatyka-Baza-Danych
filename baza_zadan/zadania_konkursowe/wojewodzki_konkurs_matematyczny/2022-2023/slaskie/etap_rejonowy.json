    {
     "litera": "III",
     "html": "Wysokość trapezu ma długość <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>3</mn><msqrt><mn>3</mn></msqrt></mrow></math> cm."
    },
    {
     "litera": "IV",
     "html": "Długość przekątnej trapezu jest równa <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>6</mn><msqrt><mn>3</mn></msqrt></mrow></math> cm."
    }
