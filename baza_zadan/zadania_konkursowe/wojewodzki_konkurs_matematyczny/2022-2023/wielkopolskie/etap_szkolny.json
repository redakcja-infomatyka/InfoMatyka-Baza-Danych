   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Od 2 marca do 5 kwietnia mija <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>29</mn><mo>+</mo><mn>5</mn><mo>=</mo><mn>34</mn></math> dni (marzec ma 31 dni), a <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>34</mn><mo>=</mo><mn>4</mn><mo>·</mo><mn>7</mn><mo>+</mo><mn>6</mn></math>. Cofając się o 6 dni od piątku, otrzymujemy sobotę.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "cofaj się od 5 kwietnia całymi tygodniami, aż wejdziesz w marzec",
