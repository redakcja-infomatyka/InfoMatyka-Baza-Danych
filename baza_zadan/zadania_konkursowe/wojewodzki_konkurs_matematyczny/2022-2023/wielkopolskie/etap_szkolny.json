   "punkty": 1,
   "tematy": [
    "prędkość / droga / czas"
   ],
   "tresc_html": "<p>Pan Adam miał przejechać na rowerze 60 km w ciągu 3 godzin. Jego wyjazd opóźnił się o pół godziny. O ile musi zwiększyć prędkość, aby dotrzeć do celu na wyznaczoną godzinę?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mfrac><mtext>km</mtext><mtext>h</mtext></mfrac></math>"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><mfrac><mtext>km</mtext><mtext>h</mtext></mfrac></math>"
    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mfrac><mtext>km</mtext><mtext>h</mtext></mfrac></math>"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>8</mn><mfrac><mtext>km</mtext><mtext>h</mtext></mfrac></math>"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Planowana prędkość: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>60</mn><mo>:</mo><mn>3</mn><mo>=</mo><mn>20</mn></math> km/h. Po opóźnieniu zostaje 2,5 h, więc potrzebna prędkość to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>60</mn><mo>:</mo><mn>2,5</mn><mo>=</mo><mn>24</mn></math> km/h. Wzrost: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>24</mn><mo>−</mo><mn>20</mn><mo>=</mo><mn>4</mn></math> km/h.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "zostało pół godziny mniej — porównaj prędkość planowaną z potrzebną",
   "czas_min": 2
  },
