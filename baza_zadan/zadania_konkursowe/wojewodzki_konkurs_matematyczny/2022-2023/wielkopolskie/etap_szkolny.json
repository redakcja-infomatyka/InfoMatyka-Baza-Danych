 "zadania": [
  {
   "id": "szkolny_2022-2023_wielkopolskie_q1",
   "numer": 1,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "wyrażenia algebraiczne"
   ],
   "tresc_html": "<p>Pani Ania ma <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> banknotów pięćdziesięciozłotowych i o 8 więcej banknotów dwudziestozłotowych. Kwotę pieniędzy, którą dysponuje pani Ania opisuje wyrażenie:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>70</mn><mi>x</mi><mo>+</mo><mn>160</mn><mo>)</mo></math> zł"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>60</mn><mi>x</mi><mo>+</mo><mn>80</mn><mo>)</mo></math> zł"
    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>70</mn><mi>x</mi><mo>−</mo><mn>160</mn><mo>)</mo></math> zł"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>140</mn><mi>x</mi><mo>+</mo><mn>160</mn><mo>)</mo></math> zł"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Banknotów 20-złotowych jest <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mi>x</mi><mo>+</mo><mn>8</mn><mo>)</mo></math>. Kwota: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>50</mn><mi>x</mi><mo>+</mo><mn>20</mn><mo>(</mo><mi>x</mi><mo>+</mo><mn>8</mn><mo>)</mo><mo>=</mo><mn>70</mn><mi>x</mi><mo>+</mo><mn>160</mn></math> zł.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "dwudziestek jest x+8 — zsumuj 50x i 20·(x+8)",
   "czas_min": 1
  },
  {
   "id": "szkolny_2022-2023_wielkopolskie_q2",
   "numer": 2,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "wyrażenia algebraiczne",
    "działania na pierwiastkach"
   ],
   "tresc_html": "<p>Wartość liczbowa wyrażenia <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mo>·</mo><mo>(</mo><mi>x</mi><mi>y</mi><mo>+</mo><msup><mi>y</mi><mn>2</mn></msup><mo>)</mo></math> dla <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mo>−</mo><mn>3</mn></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><mroot><mrow><mo>−</mo><mn>27</mn></mrow><mn>3</mn></mroot></math> jest równa:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "−72"
    },
    {
     "litera": "B",
     "html": "72"
    },
    {
     "litera": "C",
     "html": "0"
    },
    {
     "litera": "D",
     "html": "36"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Skoro <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mroot><mrow><mo>−</mo><mn>27</mn></mrow><mn>3</mn></mroot><mo>=</mo><mo>−</mo><mn>3</mn></math>, to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><mo>−</mo><mn>3</mn></math>. Wtedy <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mi>y</mi><mo>+</mo><msup><mi>y</mi><mn>2</mn></msup><mo>=</mo><mo>(</mo><mo>−</mo><mn>3</mn><mo>)</mo><mo>·</mo><mo>(</mo><mo>−</mo><mn>3</mn><mo>)</mo><mo>+</mo><mn>9</mn><mo>=</mo><mn>18</mn></math>, więc wyrażenie równa się <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mo>·</mo><mn>18</mn><mo>=</mo><mn>72</mn></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "najpierw wyznacz ∛(−27), potem podstaw do nawiasu",
   "czas_min": 1,
   "haczyk": {
    "sila": 2,
    "rodzaje": [
     "znak"
    ],
    "opis": "Kwadrat liczby ujemnej: y² dla y = −3 łatwo potraktować jak −3² i dostać ujemny składnik"
   }
  },
