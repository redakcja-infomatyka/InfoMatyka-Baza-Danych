     "html": "30"
    },
    {
     "litera": "D",
     "html": "15"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Każda para punktów wyznacza jedną prostą (żadne trzy nie są współliniowe), a liczba par spośród 6 punktów wynosi <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>6</mn><mo>·</mo><mn>5</mn></mrow><mn>2</mn></mfrac><mo>=</mo><mn>15</mn></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "każda para punktów wyznacza jedną prostą — policz pary",
   "czas_min": 1,
