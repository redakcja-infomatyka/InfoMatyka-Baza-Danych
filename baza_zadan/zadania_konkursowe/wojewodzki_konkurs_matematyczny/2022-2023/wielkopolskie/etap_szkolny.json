    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Czysty kwas w roztworze się nie zmienia: w 3 kg octu 6% jest <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0,06</mn><mo>·</mo><mn>3</mn><mo>=</mo><mn>0,18</mn></math> kg kwasu, musi więc pochodzić z <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0,18</mn><mo>:</mo><mn>0,1</mn><mo>=</mo><mn>1,8</mn></math> kg octu 10%. Wody trzeba dolać <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>−</mo><mn>1,8</mn><mo>=</mo><mn>1,2</mn></math> kg.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "ilość samego kwasu się nie zmienia — policz ją z 3 kg roztworu 6%",
   "czas_min": 2
