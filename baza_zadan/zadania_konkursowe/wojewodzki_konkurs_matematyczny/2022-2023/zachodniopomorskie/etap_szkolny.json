    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Obliczamy: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo>−</mo><msup><mn>2</mn><mn>6</mn></msup><mo>=</mo><mo>−</mo><mn>64</mn></mrow></math>, a <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><msup><mrow><mo>(</mo><mo>−</mo><mn>2</mn><mo>)</mo></mrow><mn>6</mn></msup><mo>=</mo><mn>64</mn></mrow></math> (parzysta potęga liczby ujemnej jest dodatnia). Wartość wyrażenia: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo>−</mo><mn>64</mn><mo>−</mo><mn>64</mn><mo>=</mo><mo>−</mo><mn>128</mn></mrow></math>.</p>"
   },
   "w_pamieci": "wprost",
