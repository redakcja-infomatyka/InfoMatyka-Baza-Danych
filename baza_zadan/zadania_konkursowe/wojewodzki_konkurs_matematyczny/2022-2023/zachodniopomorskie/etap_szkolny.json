   "punkty": 1,
   "tematy": [
    "podzielność"
   ],
   "tresc_html": "<p>Dla każdej liczby naturalnej dodatniej <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi></math> zawsze nieparzystą jest liczba postaci:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><msup><mn>5</mn><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>−</mo><mn>1</mn></mrow></math>"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><msup><mi>n</mi><mi>n</mi></msup><mo>+</mo><mn>1</mn></mrow></math>"
