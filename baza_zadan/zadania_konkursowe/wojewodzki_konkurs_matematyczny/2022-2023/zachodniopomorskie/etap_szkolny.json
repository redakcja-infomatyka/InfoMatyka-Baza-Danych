    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Suma dziesięciu liczb wynosi 30, więc średnia to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>30</mn><mo>:</mo><mn>10</mn><mo>=</mo><mn>3</mn></mrow></math>. Aby średnia dziewięciu pozostałych liczb też wynosiła 3, ich suma musi być równa <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>9</mn><mo>·</mo><mn>3</mn><mo>=</mo><mn>27</mn></mrow></math>, czyli usunięta liczba to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>30</mn><mo>−</mo><mn>27</mn><mo>=</mo><mn>3</mn></mrow></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "policz najpierw średnią całego zestawu",
   "czas_min": 1
