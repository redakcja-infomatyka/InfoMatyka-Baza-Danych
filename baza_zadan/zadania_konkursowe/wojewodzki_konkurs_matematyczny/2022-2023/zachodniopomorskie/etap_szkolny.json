   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "trójkąty"
   ],
   "tresc_html": "<p>Trójkąt o bokach długości: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>2</mn><mo>−</mo><msqrt><mn>3</mn></msqrt></mrow></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><msqrt><mn>2</mn></msqrt><mo>+</mo><mn>1</mn></mrow></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn></math> jest:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "ostrokątny"
    },
    {
     "litera": "B",
     "html": "prostokątny"
    },
    {
     "litera": "C",
     "html": "nie istnieje"
    },
    {
     "litera": "D",
     "html": "rozwartokątny"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Sprawdzamy nierówność trójkąta dla dwóch krótszych boków: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo>(</mo><mn>2</mn><mo>−</mo><msqrt><mn>3</mn></msqrt><mo>)</mo><mo>+</mo><mo>(</mo><msqrt><mn>2</mn></msqrt><mo>+</mo><mn>1</mn><mo>)</mo><mo>≈</mo><mn>0,27</mn><mo>+</mo><mn>2,41</mn><mo>=</mo><mn>2,68</mn></mrow></math>, co jest mniejsze niż trzeci bok równy 3. Taki trójkąt nie istnieje.</p>"
   },
   "w_pamieci": "pomysl",
   "wskazowka": "zanim policzysz kąty, sprawdź warunek trójkąta — oszacuj √3 ≈ 1,73 i √2 ≈ 1,41",
   "czas_min": 2,
   "haczyk": {
