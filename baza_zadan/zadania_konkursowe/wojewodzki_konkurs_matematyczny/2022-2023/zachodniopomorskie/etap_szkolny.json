    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><msup><mn>8</mn><mi>n</mi></msup><mo>−</mo><mn>1</mn></mrow></math>"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Liczba <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>8</mn><mi>n</mi></msup></math> jest parzysta dla każdego <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi></math>, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><msup><mn>8</mn><mi>n</mi></msup><mo>−</mo><mn>1</mn></mrow></math> jest zawsze nieparzysta.</p>"
   },
   "w_pamieci": "wprost",
