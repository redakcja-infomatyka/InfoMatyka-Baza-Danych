  {
   "id": "szkolny_2022-2023_zachodniopomorskie_q10",
   "numer": 10,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "równania z jedną zmienną"
   ],
   "tresc_html": "<p>Zakładamy, że <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>c</mi></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> są liczbami dodatnimi. Wyznaczając <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> ze wzoru <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>a</mi><mo>=</mo><mfrac><mrow><mn>2</mn><mo>−</mo><mi>b</mi><mi>x</mi></mrow><mi>c</mi></mfrac></mrow></math> otrzymamy:</p>",
   "warianty": [
