    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mo>+</mo><mn>2</mn><msqrt><mn>3</mn></msqrt><mo>+</mo><mn>2</mn><msqrt><mn>5</mn></msqrt></math>"
    }
