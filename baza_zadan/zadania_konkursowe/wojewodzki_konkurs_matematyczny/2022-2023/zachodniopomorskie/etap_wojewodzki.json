    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>+</mo><mn>2</mn><msqrt><mn>5</mn></msqrt><mo>+</mo><msqrt><mn>2</mn></msqrt><mo>+</mo><msqrt><mn>10</mn></msqrt></math>"
    },
    {
     "litera": "C",
