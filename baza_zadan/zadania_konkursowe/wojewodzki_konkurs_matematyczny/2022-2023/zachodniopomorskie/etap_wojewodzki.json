    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Aby <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>9</mn><mrow><mi>n</mi><mo>−</mo><mn>5</mn></mrow></mfrac></math> było liczbą całkowitą, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi><mo>−</mo><mn>5</mn></math> musi być dzielnikiem 9. Dzielniki 9 to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>±</mo><mn>1</mn><mo>,</mo><mo>±</mo><mn>3</mn><mo>,</mo><mo>±</mo><mn>9</mn></math> — sześć liczb, więc jest sześć takich <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "n−5 musi być dzielnikiem 9 — nie zapomnij o dzielnikach ujemnych",
