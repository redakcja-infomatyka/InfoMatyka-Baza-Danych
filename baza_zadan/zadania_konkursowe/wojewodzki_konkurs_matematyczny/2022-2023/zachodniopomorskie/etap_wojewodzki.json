    {
     "litera": "C",
     "html": "361 cm²"
    },
    {
     "litera": "D",
     "html": "441 cm²"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Niech <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> oznacza bok większego kwadratu. Z warunku <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>a</mi><mn>2</mn></msup><mo>−</mo><msup><mrow><mo>(</mo><mi>a</mi><mo>−</mo><mn>1</mn><mo>)</mo></mrow><mn>2</mn></msup><mo>=</mo><mn>39</mn></math> wynika <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>a</mi><mo>−</mo><mn>1</mn><mo>=</mo><mn>39</mn></math>, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mn>20</mn></math>. Mniejszy kwadrat ma bok 19 cm, więc jego pole to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>19</mn><mn>2</mn></msup><mo>=</mo><mn>361</mn></math> cm².</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "różnica pól tych kwadratów to po prostu suma ich boków",
   "czas_min": 2
