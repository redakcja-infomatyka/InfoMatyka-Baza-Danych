     "html": "165°"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>O 12:30 wskazówka minutowa jest odchylona o <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>180</mn><mo>°</mo></math> od godziny 12. Wskazówka godzinowa przeszła połowę drogi między 12 a 1, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>30</mn><mo>°</mo><mo>:</mo><mn>2</mn><mo>=</mo><mn>15</mn><mo>°</mo></math>. Kąt między wskazówkami: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>180</mn><mo>°</mo><mo>−</mo><mn>15</mn><mo>°</mo><mo>=</mo><mn>165</mn><mo>°</mo></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "o 12.30 mała wskazówka jest już w połowie drogi między 12 a 1",
   "czas_min": 2,
   "haczyk": {
    "sila": 2,
    "rodzaje": [
     "pozorna-wlasnosc"
    ],
    "opis": "O 12.30 mała wskazówka nie stoi na 12, tylko przesunęła się o pół godziny drogi"
   }
  },
  {
