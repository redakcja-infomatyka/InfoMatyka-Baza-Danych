   "tresc_html": "<p>Średni wiek w pewnej sześcioosobowej drużynie wynosił 49 lat. Najmłodszy uczestnik zrezygnował i wówczas średnia wieku wzrosła do 53 lat. Ile lat miał najmłodszy zawodnik?</p>",
   "warianty": [],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "29 lat",
    "zrodlo": "klucz",
    "rozwiazanie_html": "<p>Suma lat sześciu zawodników: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mo>·</mo><mn>49</mn><mo>=</mo><mn>294</mn></math>. Suma lat pozostałych pięciu zawodników: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><mo>·</mo><mn>53</mn><mo>=</mo><mn>265</mn></math>. Wiek najmłodszego zawodnika: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>294</mn><mo>−</mo><mn>265</mn><mo>=</mo><mn>29</mn></math>. Najmłodszy zawodnik miał 29 lat.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "porównaj sumę lat całej szóstki z sumą lat pozostałej piątki",
   "czas_min": 2
