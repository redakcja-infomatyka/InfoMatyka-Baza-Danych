   "tresc_html": "<p>Wiktor ustawił czterocyfrowy szyfr swojej kłódki rowerowej wykorzystując wszystkie cyfry swojej daty urodzenia 1988. Jaka jest największa liczba prób, które musiałby wykonać, gdyby zapomniał prawidłowego ustawienia cyfr w swojej kłódce?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "6"
    },
    {
     "litera": "B",
     "html": "9"
    },
    {
     "litera": "C",
     "html": "12"
    },
    {
     "litera": "D",
     "html": "15"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Cyfry szyfru to 1, 9, 8, 8 (z powtórzoną 8). Liczba różnych czterocyfrowych ustawień: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>4</mn><mo>!</mo></mrow><mrow><mn>2</mn><mo>!</mo></mrow></mfrac><mo>=</mo><mn>12</mn></math>. W najgorszym razie Wiktor musi wykonać 12 prób.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "to ustawienia cyfr 1, 9, 8, 8 — powtórzoną ósemkę uwzględnij dzieląc przez 2",
   "czas_min": 2
  },
