   "tresc_html": "<p>W trapezie <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>ABCD</mi></math> przedstawionym na rysunku obok jest taki punkt <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>E</mi></math>, że trójkąt <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>ABE</mi></math> jest prostokątny równoramienny, a trójkąty <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>AED</mi></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>BCE</mi></math> są równoboczne. Ile razy kąt <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>ABC</mi></math> jest większy od kąta <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>CDE</mi></math>?</p>",
   "warianty": [
    {
     "litera": "A",
