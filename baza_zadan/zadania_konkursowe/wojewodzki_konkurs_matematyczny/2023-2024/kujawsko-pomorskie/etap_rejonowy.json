    ],
    "opis": "Szukamy zdania NIEprawdziwego; trzy warianty są prawdziwe"
   }
  },
  {
   "id": "rejonowy_2024_kujawsko-pomorskie_q18",
   "numer": 18,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "wyrażenia algebraiczne"
   ],
   "tresc_html": "<p>Przekształcając wzór na pole trapezu <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>P</mi><mo>=</mo><mfrac><mrow><mo>(</mo><mi>a</mi><mo>+</mo><mi>b</mi><mo>)</mo><mo>·</mo><mi>h</mi></mrow><mn>2</mn></mfrac></mrow></math>, otrzymamy:</p>",
   "warianty": [
