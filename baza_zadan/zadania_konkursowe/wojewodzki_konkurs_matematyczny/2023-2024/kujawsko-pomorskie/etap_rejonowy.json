     "litera": "C",
     "html": "1500 m"
    },
    {
     "litera": "D",
     "html": "2700 m"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Niech długość prostokąta na planie to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>L</mi></math>, wtedy szerokość to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>3</mn><mn>2</mn></mfrac><mi>L</mi></math>. Z pola: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mn>3</mn><mn>2</mn></mfrac><msup><mi>L</mi><mn>2</mn></msup><mo>=</mo><mn>5400</mn></mrow></math>, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>L</mi><mo>=</mo><mn>60</mn></mrow></math> mm, a szerokość 90 mm.</p><p>Obwód na planie: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>2</mn><mo>·</mo><mo>(</mo><mn>60</mn><mo>+</mo><mn>90</mn><mo>)</mo><mo>=</mo><mn>300</mn></mrow></math> mm. W skali 1:10000 daje to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>300</mn><mo>·</mo><mn>10000</mn><mo>=</mo><mn>3000000</mn></mrow></math> mm, czyli 3000 m.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "z pola i stosunku boków wyznacz najpierw wymiary na planie, dopiero potem przelicz skalę",
   "czas_min": 2
