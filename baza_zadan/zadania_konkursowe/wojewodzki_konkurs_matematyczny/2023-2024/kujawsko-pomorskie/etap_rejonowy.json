   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "liczby pierwsze",
    "działania na potęgach",
    "podzielność"
   ],
   "tresc_html": "<p>Zapis dziesiętny, której z podanych liczb kończy się największą liczbą zer?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><msup><mn>2</mn><mn>2</mn></msup><mo>·</mo><msup><mn>3</mn><mn>5</mn></msup><mo>·</mo><msup><mn>5</mn><mn>5</mn></msup></mrow></math>"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><msup><mn>2</mn><mn>5</mn></msup><mo>·</mo><msup><mn>5</mn><mn>3</mn></msup><mo>·</mo><msup><mn>3</mn><mn>2</mn></msup></mrow></math>"
    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><msup><mn>4</mn><mn>3</mn></msup><mo>·</mo><msup><mn>3</mn><mn>5</mn></msup><mo>·</mo><msup><mn>5</mn><mn>2</mn></msup></mrow></math>"
