   "odpowiedz": {
    "poprawna": "72 km",
    "zrodlo": "klucz",
    "rozwiazanie_html": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><mfrac><mtext>m</mtext><mtext>s</mtext></mfrac><mo>=</mo><mn>5</mn><mo>·</mo><mfrac><mrow><mn>3600</mn></mrow><mrow><mn>1000</mn></mrow></mfrac><mfrac><mtext>km</mtext><mtext>h</mtext></mfrac><mo>=</mo><mn>18</mn><mfrac><mtext>km</mtext><mtext>h</mtext></mfrac></math>.</p><p>W ciągu 4 godzin rowerzysta pokona <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mo>·</mo><mn>18</mn><mtext> km</mtext><mo>=</mo><mn>72</mn><mtext> km</mtext></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "zamień 5 m/s na km/h albo policz, ile sekund ma 4 godziny",
   "czas_min": 2,
   "haczyk": {
