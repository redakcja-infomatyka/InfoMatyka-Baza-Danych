   ],
   "tresc_html": "<p>Ile kilometrów pokona rowerzysta w ciągu 4 godzin, jeżeli jedzie ze stałą prędkością <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><mfrac><mtext>m</mtext><mtext>s</mtext></mfrac></math>?</p>",
   "warianty": [],
