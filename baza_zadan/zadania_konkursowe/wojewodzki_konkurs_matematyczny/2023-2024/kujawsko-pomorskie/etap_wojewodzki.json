    },
    {
     "litera": "D",
     "html": "6"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "klucz",
    "rozwiazanie_html": "<p>Liczba podzielna przez 2 i 5 jest podzielna przez 10, zatem numer przeczytanej strony kończy się cyfrą 0, a cyfrą jedności numeru następnej strony jest 1.</p>"
