   "tresc_html": "<p>Kasia jest o 5 lat starsza od Julii, a Julia jest o 4 lata starsza od Ali. Suma lat dziewcząt wynosi 34 lata. Ile lat ma najstarsza z nich?</p>",
   "warianty": [],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "16 lat",
    "zrodlo": "klucz",
    "rozwiazanie_html": "<p>Oznaczmy: wiek Kasi <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math>, wiek Julii <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>−</mo><mn>5</mn></math>, wiek Ali <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>−</mo><mn>5</mn><mo>−</mo><mn>4</mn><mo>=</mo><mi>x</mi><mo>−</mo><mn>9</mn></math>.</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>+</mo><mo>(</mo><mi>x</mi><mo>−</mo><mn>5</mn><mo>)</mo><mo>+</mo><mo>(</mo><mi>x</mi><mo>−</mo><mn>9</mn><mo>)</mo><mo>=</mo><mn>34</mn></math>, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mi>x</mi><mo>−</mo><mn>14</mn><mo>=</mo><mn>34</mn></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mi>x</mi><mo>=</mo><mn>48</mn></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mn>16</mn></math>.</p><p>Najstarsza (Kasia) ma 16 lat.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "wyraź wiek Julii i Ali przez wiek Kasi i dodaj do sumy brakujące lata",
   "czas_min": 5
  },
