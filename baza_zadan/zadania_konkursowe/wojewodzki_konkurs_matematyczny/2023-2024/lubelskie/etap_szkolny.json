    "zmiany procentowe",
    "procenty"
   ],
   "tresc_html": "<p>25% liczby <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> jest równe 20% liczby <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math>.</p><p>Oceń prawdziwość podanych zdań. Wybierz P, jeśli zdanie jest prawdziwe, albo F – jeśli jest fałszywe. Wybraną odpowiedź zaznacz kółkiem.</p>",
   "warianty": [
    {
     "litera": "1",
     "html": "Liczba <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> jest o 5% większa od liczby <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math>."
    },
    {
     "litera": "2",
     "html": "Liczba <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math> jest o 20% większa od liczby <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math>."
    },
    {
     "litera": "3",
     "html": "Jeżeli liczbę <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> zwiększymy o 20%, to otrzymamy liczbę <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math>."
    },
    {
     "litera": "4",
     "html": "Jeżeli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mn>60</mn></math>, to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi><mo>=</mo><mn>75</mn></math>."
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "FFFP",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<ul><li><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0,25</mn><mi>a</mi><mo>=</mo><mn>0,20</mn><mi>b</mi></math>, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mn>0,8</mn><mi>b</mi></math> — a jest o 20% mniejsza od b, nie o 5% większa — <b>F</b>.</li><li><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi><mo>=</mo><mn>1,25</mn><mi>a</mi></math> — b jest o 25% większa od a, nie o 20% — <b>F</b>.</li><li><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1,2</mn><mi>a</mi><mo>=</mo><mn>1,2</mn><mo>·</mo><mn>0,8</mn><mi>b</mi><mo>=</mo><mn>0,96</mn><mi>b</mi><mo>≠</mo><mi>b</mi></math> — <b>F</b>.</li><li>Dla <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mn>60</mn></math>: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi><mo>=</mo><mn>1,25</mn><mo>·</mo><mn>60</mn><mo>=</mo><mn>75</mn></math> — <b>P</b>.</li></ul>"
   },
   "w_pamieci": "wprost",
