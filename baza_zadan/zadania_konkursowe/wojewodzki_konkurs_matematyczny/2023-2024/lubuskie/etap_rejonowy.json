   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Niech Franek ma <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> lat. Kasia: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>−</mo><mn>2</mn></math>, Julka: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>+</mo><mn>3</mn></math>, mama: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>(</mo><mi>x</mi><mo>+</mo><mn>3</mn><mo>)</mo></math>, tata o 4 więcej. Suma: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>9</mn><mi>x</mi><mo>+</mo><mn>23</mn><mo>=</mo><mn>104</mn></math>, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mn>9</mn></math>.</p>"
   },
   "czas_min": 2
