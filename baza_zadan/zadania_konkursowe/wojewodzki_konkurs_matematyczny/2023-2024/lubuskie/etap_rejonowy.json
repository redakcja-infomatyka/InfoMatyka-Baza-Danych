   "tresc_html": "<p>W trapezie <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>ABCD</mi></math>, w którym <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>AB</mi><mo>∥</mo><mi>CD</mi></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>AD</mi><mo>=</mo><mi>DC</mi><mo>=</mo><mi>CB</mi></math> oraz <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>AB</mi><mo>=</mo><mi>AC</mi></math>, miara kąta przy wierzchołku <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>D</mi></math> jest równa</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "72°"
    },
    {
     "litera": "B",
     "html": "108°"
    },
