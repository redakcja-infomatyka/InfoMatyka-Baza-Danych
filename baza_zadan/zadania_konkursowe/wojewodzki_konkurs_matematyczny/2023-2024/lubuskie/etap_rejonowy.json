     "html": "MCXIM"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>2024 rok to 20. rocznica śmierci Miłosza, więc zmarł w 2004 roku. Mając wtedy 93 lata, urodził się w roku <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2004</mn><mo>−</mo><mn>93</mn><mo>=</mo><mn>1911</mn></math>, czyli MCMXI.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "cofnij się od 2024 o rocznicę śmierci, a potem o wiek poety",
   "czas_min": 1
