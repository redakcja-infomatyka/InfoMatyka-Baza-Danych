  {
   "id": "rejonowy_2023-2024_malopolskie_q13",
   "numer": 13,
   "typ": "zamkniete",
   "punkty": 3,
   "tematy": [
    "podobieństwo i skala",
    "zamiana jednostek",
    "graniastosłupy"
   ],
   "tresc_html": "<p>Prostopadłościan ma wymiary <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> km, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math> m, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>c</mi></math> dm. Sporządzono siatkę tego prostopadłościanu w skali 1:500. Jaka jest objętość prostopadłościanu sklejonego z tej siatki?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>a</mi><mi>b</mi><mi>c</mi></mrow><mn>1250</mn></mfrac></math> l"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>4</mn><mi>a</mi><mi>b</mi><mi>c</mi></mrow><mn>5</mn></mfrac></math> l"
    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>a</mi><mi>b</mi><mi>c</mi></mrow><msup><mrow><mo>(</mo><mn>500</mn><mo>)</mo></mrow><mn>3</mn></msup></mfrac></math> l"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msup><mn>10</mn><mn>6</mn></msup><mo>·</mo><mi>a</mi><mi>b</mi><mi>c</mi></mrow><msup><mrow><mo>(</mo><mn>500</mn><mo>)</mo></mrow><mn>3</mn></msup></mfrac></math> l"
    },
    {
     "litera": "E",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>10</mn><mo>·</mo><mi>a</mi><mi>b</mi><mi>c</mi></mrow><msup><mrow><mo>(</mo><mn>500</mn><mo>)</mo></mrow><mn>3</mn></msup></mfrac></math> l"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>W metrach: a km = 1000a m, b m, c dm = 0,1c m. Krawędzie modelu w skali 1:500 (w m): 2a, b/500, c/5000. Objętość modelu: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>a</mi><mo>·</mo><mfrac><mi>b</mi><mn>500</mn></mfrac><mo>·</mo><mfrac><mi>c</mi><mn>5000</mn></mfrac><mo>=</mo><mfrac><mrow><mi>a</mi><mi>b</mi><mi>c</mi></mrow><mn>1250000</mn></mfrac></math> m³ = <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>a</mi><mi>b</mi><mi>c</mi></mrow><mn>1250</mn></mfrac></math> l (1 m³ = 1000 l).</p>"
   },
   "czas_min": 2,
