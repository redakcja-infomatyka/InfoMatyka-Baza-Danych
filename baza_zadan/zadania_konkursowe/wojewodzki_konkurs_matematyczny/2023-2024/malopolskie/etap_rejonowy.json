   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "E",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>W liczniku: a⁵+a³+a²+1 = a³(a²+1) + (a²+1) = (a²+1)(a³+1). Po podzieleniu przez a²+1 zostaje <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>a</mi><mn>3</mn></msup><mo>+</mo><mn>1</mn></math>.</p>"
   },
   "w_pamieci": "pomysl",
   "wskazowka": "pogrupuj licznik: a⁵ + a³ to a³(a² + 1)",
   "czas_min": 2
  },
  {
   "id": "rejonowy_2023-2024_malopolskie_q12",
   "numer": 12,
   "typ": "zamkniete",
   "punkty": 3,
   "tematy": [
