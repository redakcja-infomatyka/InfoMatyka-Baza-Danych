    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Suma wszystkich ośmiu liczb wynosi <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mo>·</mo><mn>8</mn><mo>=</mo><mn>48</mn></math>, a suma siedmiu znanych to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>+</mo><mn>8</mn><mo>+</mo><mn>2</mn><mo>+</mo><mn>15</mn><mo>+</mo><mn>3</mn><mo>+</mo><mn>11</mn><mo>+</mo><mn>7</mn><mo>=</mo><mn>47</mn></math>, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mn>1</mn></math>. Uporządkowany zestaw: 1, 1, 2, 3, 7, 8, 11, 15. Medianą jest <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>3</mn><mo>+</mo><mn>7</mn></mrow><mn>2</mn></mfrac><mo>=</mo><mn>5</mn></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "ze średniej wylicz sumę ośmiu liczb i brakującą daną, potem ustaw wszystko rosnąco",
   "czas_min": 2
  },
  {
   "id": "wojewodzki_2023-2024_wielkopolskie_q10",
   "numer": 10,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "proporcjonalność odwrotna"
   ],
   "tresc_html": "<p>Aby wykonać pewną pracę w ciągu 5 godzin i 15 minut potrzeba 8 pracowników. Ilu pracowników potrzeba, aby wykonać taką samą pracę w ciągu 3 godzin?</p>",
