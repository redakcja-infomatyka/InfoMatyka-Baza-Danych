     "html": "14"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Praca wymaga <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>8</mn><mo>·</mo><mn>5</mn><mfrac><mn>1</mn><mn>4</mn></mfrac><mo>=</mo><mn>42</mn></math> roboczogodzin. Przy 3 godzinach pracy potrzeba <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>42</mn><mo>:</mo><mn>3</mn><mo>=</mo><mn>14</mn></math> pracowników.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "policz najpierw, ilu roboczogodzin wymaga cała praca",
   "czas_min": 2
  },
  {
   "id": "wojewodzki_2023-2024_wielkopolskie_q11",
