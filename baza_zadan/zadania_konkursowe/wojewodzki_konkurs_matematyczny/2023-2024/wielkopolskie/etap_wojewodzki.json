    "działania na potęgach",
    "notacja wykładnicza"
   ],
   "tresc_html": "<p>Większa od 1 jest liczba:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>0,01</mn><mn>2</mn></msup><mo>·</mo><msup><mn>10</mn><mn>3</mn></msup></math>"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>10</mn><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo>·</mo><mn>0,01</mn></math>"
    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0,001</mn><mo>:</mo><msup><mn>100</mn><mrow><mo>−</mo><mn>1</mn></mrow></msup></math>"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>0,01</mn><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo>·</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>2</mn></mrow></msup></math>"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Zapisujemy liczby jako potęgi dziesiątki: A i C dają <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>10</mn><mrow><mo>−</mo><mn>1</mn></mrow></msup></math>, B daje <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></math>, a w D: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>0,01</mn><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo>·</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo>=</mo><msup><mn>10</mn><mn>4</mn></msup><mo>·</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo>=</mo><msup><mn>10</mn><mn>2</mn></msup><mo>=</mo><mn>100</mn></math>.</p><p>Tylko ta liczba jest większa od 1.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "zapisz każdą z liczb jako potęgę dziesiątki i dodaj wykładniki",
   "czas_min": 2
  },
  {
   "id": "wojewodzki_2023-2024_wielkopolskie_q2",
   "numer": 2,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "nierówności"
   ],
   "tresc_html": "<p>Dana jest nierówność <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>2</mn><mn>3</mn></mfrac><mo>−</mo><mi>x</mi><mo>−</mo><mfrac><mrow><mn>7</mn><mo>−</mo><mi>x</mi></mrow><mn>2</mn></mfrac><mo>&lt;</mo><mn>0</mn></math>. Podaj największą liczbę całkowitą, która nie spełnia tej nierówności.</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "−6"
    },
    {
     "litera": "B",
     "html": "−5"
    },
    {
     "litera": "C",
     "html": "−2"
    },
    {
     "litera": "D",
     "html": "−1"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Mnożymy nierówność przez 6: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mo>−</mo><mn>6</mn><mi>x</mi><mo>−</mo><mn>3</mn><mo>(</mo><mn>7</mn><mo>−</mo><mi>x</mi><mo>)</mo><mo>&lt;</mo><mn>0</mn></math>, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>−</mo><mn>3</mn><mi>x</mi><mo>−</mo><mn>17</mn><mo>&lt;</mo><mn>0</mn></math>, stąd <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>&gt;</mo><mo>−</mo><mfrac><mn>17</mn><mn>3</mn></mfrac><mo>≈</mo><mo>−</mo><mn>5,67</mn></math>. Nierówności nie spełniają liczby <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>≤</mo><mo>−</mo><mn>6</mn></math>, więc największa taka liczba całkowita to −6.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "pomnóż nierówność przez 6, a na koniec pamiętaj, że szukasz liczby, która jej nie spełnia",
   "czas_min": 2,
   "haczyk": {
    "sila": 2,
    "rodzaje": [
     "o-co-pytaja",
     "zbior-liczb"
    ],
    "opis": "Pytają o liczbę, która NIE spełnia nierówności; do tego największa całkowita poniżej ujemnego ułamka"
   }
