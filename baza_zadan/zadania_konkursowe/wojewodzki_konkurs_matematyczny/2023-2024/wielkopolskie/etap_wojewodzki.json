    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>3</mn><msqrt><mn>6</mn></msqrt></mrow><mn>10</mn></mfrac></math>"
