   ],
   "tresc_html": "<p>Wartość wyrażenia <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mrow><msup><mn>72</mn><mn>2</mn></msup><mo>−</mo><msup><mn>63</mn><mn>2</mn></msup></mrow></msqrt></math> wynosi:</p>",
