    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>81</mn><mspace width=\"0.2em\"/><msup><mi>cm</mi><mn>2</mn></msup></math>"
