   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Ze wzoru na różnicę kwadratów: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>72</mn><mn>2</mn></msup><mo>−</mo><msup><mn>63</mn><mn>2</mn></msup><mo>=</mo><mo>(</mo><mn>72</mn><mo>−</mo><mn>63</mn><mo>)</mo><mo>(</mo><mn>72</mn><mo>+</mo><mn>63</mn><mo>)</mo><mo>=</mo><mn>9</mn><mo>·</mo><mn>135</mn><mo>=</mo><mn>1215</mn><mo>=</mo><mn>81</mn><mo>·</mo><mn>15</mn></math>. Zatem <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mn>1215</mn></msqrt><mo>=</mo><mn>9</mn><msqrt><mn>15</mn></msqrt></math>.</p>"
   },
   "w_pamieci": "pomysl",
   "wskazowka": "pod pierwiastkiem rozłóż różnicę kwadratów na (72−63)(72+63)",
   "czas_min": 2,
   "haczyk": {
