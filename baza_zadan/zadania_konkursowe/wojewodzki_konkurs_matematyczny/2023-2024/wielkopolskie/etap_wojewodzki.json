    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Niech <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi><mo>=</mo><mn>10</mn><mi>a</mi><mo>+</mo><mi>b</mi></math>. Warunek: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>10</mn><mi>b</mi><mo>+</mo><mi>a</mi><mo>)</mo><mo>−</mo><mo>(</mo><mn>10</mn><mi>a</mi><mo>+</mo><mi>b</mi><mo>)</mo><mo>=</mo><mn>36</mn></math>, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>9</mn><mo>(</mo><mi>b</mi><mo>−</mo><mi>a</mi><mo>)</mo><mo>=</mo><mn>36</mn></math>, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi><mo>=</mo><mi>a</mi><mo>+</mo><mn>4</mn></math>. Cyfra <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> może być równa 1, 2, 3, 4 lub 5 (bo <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi><mo>≤</mo><mn>9</mn></math>) — to 5 liczb.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "zapisz liczbę jako 10a+b — po odwróceniu różnica wychodzi wielokrotnością 9",
   "czas_min": 2
