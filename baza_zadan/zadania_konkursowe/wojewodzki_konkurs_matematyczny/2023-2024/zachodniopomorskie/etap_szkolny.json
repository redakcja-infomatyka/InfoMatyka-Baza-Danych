   ],
   "tresc_html": "<p>Wyznaczając <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>r</mi></math> ze wzoru <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>S</mi><mo>=</mo><mfrac><mrow><mi>a</mi><mo>−</mo><mi>k</mi><mi>r</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>r</mi></mrow></mfrac></math> otrzymamy:</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>r</mi><mo>=</mo><mfrac><mi>a</mi><mi>k</mi></mfrac></math>"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>r</mi><mo>=</mo><mfrac><mrow><mi>S</mi><mo>−</mo><mi>a</mi></mrow><mrow><mi>S</mi><mo>−</mo><mi>k</mi></mrow></mfrac></math>"
    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>r</mi><mo>=</mo><mfrac><mrow><mi>S</mi><mo>+</mo><mi>a</mi></mrow><mrow><mi>S</mi><mo>−</mo><mi>k</mi></mrow></mfrac></math>"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>r</mi><mo>=</mo><mfrac><mrow><mi>S</mi><mo>(</mo><mn>1</mn><mo>−</mo><mi>a</mi><mo>)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>k</mi></mrow></mfrac></math>"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Mnożymy obie strony przez <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>1</mn><mo>−</mo><mi>r</mi><mo>)</mo></math>: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>S</mi><mo>−</mo><mi>S</mi><mi>r</mi><mo>=</mo><mi>a</mi><mo>−</mo><mi>k</mi><mi>r</mi></math>. Przenosimy wyrazy z <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>r</mi></math> na jedną stronę: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>r</mi><mo>(</mo><mi>k</mi><mo>−</mo><mi>S</mi><mo>)</mo><mo>=</mo><mi>a</mi><mo>−</mo><mi>S</mi></math>, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>r</mi><mo>=</mo><mfrac><mrow><mi>S</mi><mo>−</mo><mi>a</mi></mrow><mrow><mi>S</mi><mo>−</mo><mi>k</mi></mrow></mfrac></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "pomnóż obie strony przez 1 − r i zbierz wyrazy z r po jednej stronie",
