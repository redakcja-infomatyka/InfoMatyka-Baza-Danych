     "html": "28"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Skoro dziewczęta stanowią 52% klasy, chłopcy stanowią <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>100</mn><mo>%</mo><mo>−</mo><mn>52</mn><mo>%</mo><mo>=</mo><mn>48</mn><mo>%</mo></math>. Z równania <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0,48</mn><mo>·</mo><mi>n</mi><mo>=</mo><mn>12</mn></math> otrzymujemy <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi><mo>=</mo><mn>25</mn></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "chłopcy to reszta procentów — od nich licz całą klasę",
   "czas_min": 1
  },
  {
   "id": "szkolny_2023-2024_zachodniopomorskie_q10",
   "numer": 10,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
