   "tematy": [
    "procenty"
   ],
   "tresc_html": "<p>W klasie ósmej jest 12 chłopców. Dziewczęta stanowią 52% liczby wszystkich uczniów. Liczba uczniów w tej klasie wynosi:</p>",
