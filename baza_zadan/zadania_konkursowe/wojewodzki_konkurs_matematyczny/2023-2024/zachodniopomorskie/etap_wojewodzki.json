   "tresc_html": "<p>Wartość wyrażenia <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo lspace=\"0\" rspace=\"0\" stretchy=\"false\">|</mo><mo>−</mo><mn>4</mn><mi>x</mi><mo>−</mo><mn>1</mn><mo lspace=\"0\" rspace=\"0\" stretchy=\"false\">|</mo><mo>−</mo><mo lspace=\"0\" rspace=\"0\" stretchy=\"false\">|</mo><mn>10</mn><mo>−</mo><mn>2</mn><mi>x</mi><mo lspace=\"0\" rspace=\"0\" stretchy=\"false\">|</mo></math> dla <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>∈</mo><mo>⟨</mo><mo>−</mo><mfrac><mn>1</mn><mn>4</mn></mfrac><mo>,</mo><mn>5</mn><mo>)</mo></math> wynosi:</p>",
   "warianty": [
    {
