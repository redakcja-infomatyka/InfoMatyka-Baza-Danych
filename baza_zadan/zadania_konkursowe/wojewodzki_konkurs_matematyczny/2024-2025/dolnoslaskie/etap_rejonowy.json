    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Z pierwszego równania: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>4</mn><msup><mi>x</mi><mn>2</mn></msup></mrow><mi>x</mi></mfrac><mo>=</mo><mn>4</mn><mi>x</mi><mo>=</mo><mn>5</mn></math>, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mfrac><mn>5</mn><mn>4</mn></mfrac></math>. Analogicznie <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mi>y</mi><mo>=</mo><mn>7</mn></math>, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><mfrac><mn>7</mn><mn>6</mn></mfrac></math>.</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>+</mo><mi>y</mi><mo>=</mo><mfrac><mn>15</mn><mn>12</mn></mfrac><mo>+</mo><mfrac><mn>14</mn><mn>12</mn></mfrac><mo>=</mo><mfrac><mn>29</mn><mn>12</mn></mfrac><mo>=</mo><mn>2</mn><mfrac><mn>5</mn><mn>12</mn></mfrac></math>.</p>"
   },
