   ],
   "tresc_html": "<p>Na osi liczbowej zaznaczono punkt <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi></math> o współrzędnej 3 i punkt <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi></math> o współrzędnej 7 oraz wszystkie punkty <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>X</mi></math> takie, że <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>AX</mi><mo>+</mo><mi>BX</mi><mo>=</mo><mn>4</mn></math>. Wszystkie zaznaczone punkty wyznaczyły pewien odcinek. Jaka jest długość tego odcinka?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "3"
    },
    {
     "litera": "B",
     "html": "4"
    },
