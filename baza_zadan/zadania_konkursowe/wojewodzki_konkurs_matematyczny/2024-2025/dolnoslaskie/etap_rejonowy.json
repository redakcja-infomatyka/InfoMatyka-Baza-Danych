   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Odległość <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>AB</mi><mo>=</mo><mn>4</mn></math>. Warunek <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>AX</mi><mo>+</mo><mi>BX</mi><mo>=</mo><mn>4</mn></math> spełniają dokładnie punkty leżące na odcinku AB (dla punktów spoza tego odcinka ta suma byłaby większa niż AB).</p><p>Wszystkie zaznaczone punkty pokrywają się więc z odcinkiem AB o długości 4.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "AX + BX = AB oznacza, że X leży między A i B",
   "czas_min": 1
