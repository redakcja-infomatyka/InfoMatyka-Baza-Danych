   ],
   "tresc_html": "<p>Trzycyfrową liczbę naturalną <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> podzielono przez liczbę dwucyfrową <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> i otrzymano w wyniku liczbę dwucyfrową <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math> oraz resztę <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>c</mi></math>, która jest także liczbą dwucyfrową. Okazało się, że <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> jest najmniejszą liczbą o tej własności. Suma <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>a</mi><mo>+</mo><mi>b</mi><mo>+</mo><mi>c</mi></mrow></math> jest równa</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "31"
    },
    {
     "litera": "B",
     "html": "33"
    },
    {
     "litera": "C",
     "html": "37"
    },
    {
     "litera": "D",
     "html": "41"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Reszta jest dwucyfrowa i mniejsza od dzielnika, więc dzielnik <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>a</mi><mo>≥</mo><mn>11</mn></mrow></math>. Najmniejsze <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> otrzymamy dla najmniejszych możliwych wartości: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>a</mi><mo>=</mo><mn>11</mn></mrow></math> (bo <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>c</mi><mo>&lt;</mo><mn>11</mn></mrow></math>, a <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>c</mi></math> dwucyfrowe, więc jedynie <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>c</mi><mo>=</mo><mn>10</mn></mrow></math>) oraz <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>b</mi><mo>=</mo><mn>10</mn></mrow></math>. Wtedy <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>x</mi><mo>=</mo><mn>11</mn><mo>·</mo><mn>10</mn><mo>+</mo><mn>10</mn><mo>=</mo><mn>120</mn></mrow></math>, a <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>a</mi><mo>+</mo><mi>b</mi><mo>+</mo><mi>c</mi><mo>=</mo><mn>11</mn><mo>+</mo><mn>10</mn><mo>+</mo><mn>10</mn><mo>=</mo><mn>31</mn></mrow></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "reszta musi być mniejsza od dzielnika — dobieraj po kolei najmniejsze możliwe b, c i a",
   "czas_min": 2
  },
