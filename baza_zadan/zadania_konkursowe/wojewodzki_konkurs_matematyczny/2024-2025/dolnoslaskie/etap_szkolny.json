    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Z warunku <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><msup><mi>n</mi><mn>2</mn></msup><mo>−</mo><mi>n</mi><mo>=</mo><mn>110</mn></mrow></math>, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>n</mi><mo>·</mo><mo>(</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo>)</mo><mo>=</mo><mn>11</mn><mo>·</mo><mn>10</mn></mrow></math>, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>n</mi><mo>=</mo><mn>11</mn></mrow></math>. Wtedy <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><msup><mi>n</mi><mn>3</mn></msup><mo>−</mo><mi>n</mi><mo>=</mo><mi>n</mi><mo>(</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo>)</mo><mo>(</mo><mi>n</mi><mo>+</mo><mn>1</mn><mo>)</mo><mo>=</mo><mn>110</mn><mo>·</mo><mn>12</mn><mo>=</mo><mn>1320</mn></mrow></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "zapisz warunek jako n(n−1) = 110 i szukaj dwóch kolejnych liczb naturalnych",
