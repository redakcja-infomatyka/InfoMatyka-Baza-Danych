   "tresc_html": "<p>Spośród poniższych równań jedno jest tożsamościowe. Równaniem tym jest</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>(</mo><mn>2</mn><mi>x</mi><mo>−</mo><mn>4</mn><mo>)</mo><mo>=</mo><mn>2</mn><mo>(</mo><mn>3</mn><mi>x</mi><mo>−</mo><mn>4</mn><mo>)</mo></math>"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>5</mn></mfrac><mo>(</mo><mn>3</mn><mi>x</mi><mo>−</mo><mn>6</mn><mo>)</mo><mo>=</mo><mfrac><mn>3</mn><mn>5</mn></mfrac><mo>(</mo><mi>x</mi><mo>−</mo><mn>2</mn><mo>)</mo></math>"
    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>3</mn></mfrac><mo>(</mo><mn>18</mn><mi>x</mi><mo>+</mo><mn>6</mn><mo>)</mo><mo>=</mo><mfrac><mn>2</mn><mn>9</mn></mfrac><mo>(</mo><mn>9</mn><mi>x</mi><mo>−</mo><mn>3</mn><mo>)</mo></math>"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mo>(</mo><mn>2</mn><mi>x</mi><mo>+</mo><mn>7</mn><mo>)</mo><mo>=</mo><mn>5</mn><mo>(</mo><mn>2</mn><mi>x</mi><mo>+</mo><mn>7</mn><mo>)</mo></math>"
