   "tresc_html": "<p>Długości boków pewnego trójkąta są równe <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mn>3</mn></msqrt><mo>,</mo><mn>2</mn><mo>,</mo><msqrt><mn>7</mn></msqrt></math>. Pole tego trójkąta jest równe</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msqrt><mn>28</mn></msqrt><mn>2</mn></mfrac></math>"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mn>3</mn></msqrt></math>"
    },
    {
