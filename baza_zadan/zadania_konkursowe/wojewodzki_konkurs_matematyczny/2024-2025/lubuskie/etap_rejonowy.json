     "litera": "C",
     "html": "120°"
    },
    {
     "litera": "D",
     "html": "135°"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Z sumy kątów trójkąta <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>α</mi><mo>+</mo><mi>β</mi><mo>+</mo><mi>γ</mi><mo>=</mo><mn>180</mn></math>° i warunku <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>α</mi><mo>+</mo><mi>β</mi><mo>=</mo><mfrac><mn>1</mn><mn>3</mn></mfrac><mi>γ</mi></math> otrzymujemy <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>4</mn><mn>3</mn></mfrac><mi>γ</mi><mo>=</mo><mn>180</mn></math>°, czyli γ = 135°.</p><p>Wtedy α+β = 45°, więc największy kąt trójkąta to γ = 135°.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "wstaw warunek do sumy kątów 180° i wyznacz γ",
   "czas_min": 1
  },
