   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Kąt zewnętrzny wielokąta foremnego: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>360</mn><mo>:</mo><mi>n</mi><mo>=</mo><mn>40</mn></math>, stąd n = 9 (dziewięciokąt).</p><p>Liczba przekątnych: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>n</mi><mo>(</mo><mi>n</mi><mo>−</mo><mn>3</mn><mo>)</mo></mrow><mn>2</mn></mfrac><mo>=</mo><mfrac><mrow><mn>9</mn><mo>·</mo><mn>6</mn></mrow><mn>2</mn></mfrac><mo>=</mo><mn>27</mn></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "z kąta zewnętrznego policz liczbę boków, potem użyj wzoru na przekątne",
   "czas_min": 2
