  {
   "id": "rejonowy_2024-2025_malopolskie_q5",
   "numer": 5,
   "typ": "zamkniete",
   "punkty": 2,
   "tematy": [
    "działania na potęgach",
    "wyrażenia algebraiczne"
   ],
   "tresc_html": "<p>Dane jest wyrażenie <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>W</mi><mo>=</mo><mn>2</mn><msup><mi>x</mi><mn>2</mn></msup></math>, gdzie <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> jest dowolną liczbą rzeczywistą. Które z poniższych zdań jest prawdziwe?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "Wartość wyrażenia <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>W</mi></math> jest zawsze parzysta."
    },
    {
     "litera": "B",
     "html": "Wartość wyrażenia <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>W</mi></math> jest zawsze dodatnia."
    },
    {
     "litera": "C",
     "html": "Wartość wyrażenia <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>W</mi></math> jest zawsze większa niż wartość <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math>."
    },
    {
     "litera": "D",
     "html": "Wartość wyrażenia <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>W</mi></math> jest zawsze równa połowie wartości wyrażenia <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mrow><mo>(</mo><mn>2</mn><mi>x</mi><mo>)</mo></mrow><mn>2</mn></msup></math>."
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Obliczamy: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><msup><mrow><mo>(</mo><mn>2</mn><mi>x</mi><mo>)</mo></mrow><mn>2</mn></msup><mo>=</mo><mn>4</mn><msup><mi>x</mi><mn>2</mn></msup></mrow></math>, a połowa tej wartości to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>4</mn><msup><mi>x</mi><mn>2</mn></msup><mo>:</mo><mn>2</mn><mo>=</mo><mn>2</mn><msup><mi>x</mi><mn>2</mn></msup></mrow></math>, czyli dokładnie <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>W</mi></math>, dla każdej liczby <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "sprawdź zdania dla x = 0 i dla ułamka",
   "czas_min": 1,
   "haczyk": {
