     "html": "8"
    },
    {
     "litera": "D",
     "html": "12"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Obecnie prawdopodobieństwo wylosowania białej kuli wynosi <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mn>4</mn><mn>12</mn></mfrac><mo>=</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></math>, ma wzrosnąć dwukrotnie, do <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>2</mn><mn>3</mn></mfrac></math>. Po dołożeniu <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> białych kul: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mn>4</mn><mo>+</mo><mi>x</mi></mrow><mrow><mn>12</mn><mo>+</mo><mi>x</mi></mrow></mfrac><mo>=</mo><mfrac><mn>2</mn><mn>3</mn></mfrac></mrow></math>, stąd <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>3</mn><mo>(</mo><mn>4</mn><mo>+</mo><mi>x</mi><mo>)</mo><mo>=</mo><mn>2</mn><mo>(</mo><mn>12</mn><mo>+</mo><mi>x</mi><mo>)</mo></mrow></math>, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>x</mi><mo>=</mo><mn>12</mn></mrow></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "czarnych kul nie przybywa — jaką częścią wszystkich mają być?",
   "czas_min": 2,
