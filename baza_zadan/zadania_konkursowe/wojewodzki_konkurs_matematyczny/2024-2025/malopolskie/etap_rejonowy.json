   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Suma dwóch kolejnych liczb całkowitych to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>2</mn><mi>n</mi><mo>+</mo><mn>1</mn></mrow></math>. Gdy <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi></math> jest parzyste, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>2</mn><mi>n</mi></mrow></math> dzieli się przez 4, więc reszta wynosi 1. Gdy <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi></math> jest nieparzyste, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>2</mn><mi>n</mi></mrow></math> daje resztę 2 z dzielenia przez 4, więc cała suma daje resztę 3. Możliwe są tylko reszty 1 i 3 — dwie różne reszty.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "sprawdź najpierw, jakiej parzystości jest suma dwóch kolejnych liczb",
   "czas_min": 2
