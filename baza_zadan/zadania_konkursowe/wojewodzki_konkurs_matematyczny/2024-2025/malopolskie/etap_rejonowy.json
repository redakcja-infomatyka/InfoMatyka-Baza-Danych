    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>54</mn><msqrt><mn>3</mn></msqrt><mo>+</mo><mn>54</mn></math>"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>108</mn><msqrt><mn>2</mn></msqrt><mo>+</mo><mn>54</mn><msqrt><mn>3</mn></msqrt></math>"
    },
    {
