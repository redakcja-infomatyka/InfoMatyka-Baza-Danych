    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "A",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Moc to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>100000</mn><mo>·</mo><mn>735,5</mn><mo>=</mo><mn>73550000</mn></math> W. W gigawatach (dzielimy przez miliard): <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>73550000</mn><mo>:</mo><mn>1000000000</mn><mo>=</mo><mn>7,355</mn><mo>·</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>2</mn></mrow></msup></math> GW.</p>"
