    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Sprawdzamy liczby 10–20: przy cyfrze 0 iloczyn cyfr wynosi 0, więc 10 i 20 odpadają. Z pozostałych warunek spełniają 11 (11:1), 12 (12:2=6) i 15 (15:5=3); dla 13, 14, 16, 17, 18, 19 dzielenie nie wychodzi całkowite. Takich liczb jest 3.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "przejrzyj liczby od 10 do 20 — te z cyfrą 0 odpadają od razu",
   "czas_min": 2,
   "haczyk": {
    "sila": 2,
    "rodzaje": [
     "warunek-istnienia"
    ],
    "opis": "Liczby z cyfrą 0 mają iloczyn cyfr 0, a przez zero nie da się dzielić"
   }
