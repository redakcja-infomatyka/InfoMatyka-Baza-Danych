     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>7,355</mn><mo>·</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow></math>"
