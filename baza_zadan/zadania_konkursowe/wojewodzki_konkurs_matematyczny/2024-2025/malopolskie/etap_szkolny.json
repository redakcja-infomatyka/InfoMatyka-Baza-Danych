    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Za t lat mama ma być trzy razy starsza: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>27</mn><mo>+</mo><mi>t</mi><mo>=</mo><mn>3</mn><mo>(</mo><mn>3</mn><mo>+</mo><mi>t</mi><mo>)</mo></math>, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>27</mn><mo>+</mo><mi>t</mi><mo>=</mo><mn>9</mn><mo>+</mo><mn>3</mn><mi>t</mi></math>, skąd <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>t</mi><mo>=</mo><mn>18</mn></math>, więc t=9.</p>"
   },
   "w_pamieci": "wprost",
