    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Rząd części dziesiątych kolejnych odwrotności liczb 3, 5, 7, 11, 13 to: 3, 2, 1, 0, 0 – np. <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>5</mn></mfrac><mo>=</mo><mn>0,2</mn></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>11</mn></mfrac><mo>=</mo><mn>0,0909</mn><mo>…</mo></math>. Parzyste są trzy z tych cyfr (2, 0, 0).</p>"
   },
   "w_pamieci": "wprost",
