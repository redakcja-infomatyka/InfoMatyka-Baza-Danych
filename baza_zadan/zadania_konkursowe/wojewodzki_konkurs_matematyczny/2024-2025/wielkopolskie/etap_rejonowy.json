   ],
   "tresc_html": "<p>Z podanego wzoru <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>=</mo><mfrac><mrow><mi>k</mi><mo>·</mo><mi>x</mi></mrow><mrow><mi>k</mi><mo>·</mo><mi>y</mi><mo>−</mo><mi>z</mi></mrow></mfrac></math> wyznacz „<em>k</em>”. Załóż, że wszystkie pozostałe niewiadome są liczbami dodatnimi.</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>k</mi><mo>=</mo><mfrac><mrow><mn>3</mn><mi>y</mi></mrow><mrow><mn>3</mn><mi>z</mi><mo>+</mo><mi>x</mi></mrow></mfrac></math>"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>k</mi><mo>=</mo><mfrac><mrow><mn>3</mn><mi>y</mi><mo>−</mo><mi>x</mi></mrow><mrow><mn>3</mn><mi>z</mi></mrow></mfrac></math>"
    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>k</mi><mo>=</mo><mfrac><mrow><mn>3</mn><mi>x</mi></mrow><mrow><mi>y</mi><mo>−</mo><mi>z</mi></mrow></mfrac></math>"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>k</mi><mo>=</mo><mfrac><mrow><mn>3</mn><mi>z</mi></mrow><mrow><mn>3</mn><mi>y</mi><mo>−</mo><mi>x</mi></mrow></mfrac></math>"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Mnożymy obie strony przez mianownik: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>(</mo><mi>k</mi><mi>y</mi><mo>−</mo><mi>z</mi><mo>)</mo><mo>=</mo><mi>k</mi><mi>x</mi></math>, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mi>k</mi><mi>y</mi><mo>−</mo><mi>k</mi><mi>x</mi><mo>=</mo><mn>3</mn><mi>z</mi></math>.</p><p>Wyłączamy <em>k</em> przed nawias: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>k</mi><mo>(</mo><mn>3</mn><mi>y</mi><mo>−</mo><mi>x</mi><mo>)</mo><mo>=</mo><mn>3</mn><mi>z</mi></math>, stąd <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>k</mi><mo>=</mo><mfrac><mrow><mn>3</mn><mi>z</mi></mrow><mrow><mn>3</mn><mi>y</mi><mo>−</mo><mi>x</mi></mrow></mfrac></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "pomnóż na krzyż, zbierz wyrazy z k po jednej stronie i wyłącz k przed nawias",
   "czas_min": 2
