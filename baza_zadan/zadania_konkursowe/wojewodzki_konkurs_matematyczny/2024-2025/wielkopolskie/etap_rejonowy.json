    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Liczba jednakowych bukietów musi dzielić liczbę kwiatów każdego koloru, więc szukamy <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtext>NWD</mtext><mo>(</mo><mn>24</mn><mo>,</mo><mn>42</mn><mo>,</mo><mn>36</mn><mo>)</mo></math>.</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtext>NWD</mtext><mo>(</mo><mn>24</mn><mo>,</mo><mn>42</mn><mo>)</mo><mo>=</mo><mn>6</mn></math>, a <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtext>NWD</mtext><mo>(</mo><mn>6</mn><mo>,</mo><mn>36</mn><mo>)</mo><mo>=</mo><mn>6</mn></math>.</p>"
