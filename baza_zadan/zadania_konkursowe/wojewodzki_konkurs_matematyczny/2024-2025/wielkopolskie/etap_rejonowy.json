   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Niech <em>a</em> oznacza obecny wiek Alicji. Różnica wieku obu dziewczynek, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>20</mn><mo>−</mo><mi>a</mi></math>, jest stała.</p><p>Gdy Małgosia miała <em>a</em> lat (czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>20</mn><mo>−</mo><mi>a</mi></math> lat temu), Alicja miała <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>a</mi><mo>−</mo><mn>20</mn></math> lat. Z treści: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>20</mn><mo>=</mo><mn>2</mn><mo>(</mo><mn>2</mn><mi>a</mi><mo>−</mo><mn>20</mn><mo>)</mo></math>, stąd <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mn>15</mn></math>.</p>"
   },
   "w_pamieci": "pomysl",
