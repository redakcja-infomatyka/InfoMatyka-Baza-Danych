    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Z warunku <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>−</mo><mn>12</mn><mo>=</mo><mn>0</mn><mo>,</mo><mn>85</mn><mi>a</mi></math> otrzymujemy <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>,</mo><mn>15</mn><mi>a</mi><mo>=</mo><mn>12</mn></math>, stąd <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mn>80</mn></math>.</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>70</mn><mo>%</mo><mo>·</mo><mn>80</mn><mo>=</mo><mn>56</mn></math>.</p>"
