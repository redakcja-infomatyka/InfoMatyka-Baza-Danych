   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Niebieskich pudełek jest 2, zielonych <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>·</mo><mn>4</mn><mo>=</mo><mn>8</mn></math>, złotych <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>8</mn><mo>·</mo><mn>2</mn><mo>=</mo><mn>16</mn></math>.</p><p>Razem: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>+</mo><mn>2</mn><mo>+</mo><mn>8</mn><mo>+</mo><mn>16</mn><mo>=</mo><mn>27</mn></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "licz warstwami: ile jest niebieskich, zielonych i złotych pudełek, a potem dodaj wszystkie",
   "czas_min": 1
  },
