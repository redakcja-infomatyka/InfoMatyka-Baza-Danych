    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Odległości na mapie wzrosły 1,5 raza, a w terenie się nie zmieniły, więc ten sam odcinek terenu odpowiada teraz 1,5 raza większej długości na mapie. Nowy mianownik skali: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>600000</mn><mo>:</mo><mn>1,5</mn><mo>=</mo><mn>400000</mn></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "powiększenie mapy 1,5 raza tyle samo razy zmniejsza mianownik skali",
   "czas_min": 1,
   "haczyk": {
