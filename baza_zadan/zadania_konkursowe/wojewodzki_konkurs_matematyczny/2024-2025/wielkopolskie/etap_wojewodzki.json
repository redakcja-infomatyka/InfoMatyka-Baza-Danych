   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Cięciwa łącząca końce dwóch promieni ma długość <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>r</mi><msqrt><mn>2</mn></msqrt><mo>=</mo><mn>20</mn><msqrt><mn>2</mn></msqrt></mrow></math>, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>r</mi><mo>=</mo><mn>20</mn></mrow></math>. Pole ćwiartki koła: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mn>1</mn><mn>4</mn></mfrac><mo>·</mo><mi>π</mi><mo>·</mo><msup><mn>20</mn><mn>2</mn></msup><mo>=</mo><mn>100</mn><mi>π</mi></mrow></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "zaznaczony odcinek to przeciwprostokątna trójkąta o przyprostokątnych równych promieniowi",
