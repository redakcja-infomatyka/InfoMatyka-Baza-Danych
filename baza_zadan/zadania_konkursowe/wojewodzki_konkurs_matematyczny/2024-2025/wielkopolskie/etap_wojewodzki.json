    {
     "litera": "D",
     "html": "romb"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Środek symetrii ma figura, którą obrót o 180° przekształca na samą siebie — mają go prostokąt, romb i sześciokąt foremny. Trójkąt równoboczny ma trzy osie symetrii, ale obrót o 180° nie odwzorowuje go na siebie, więc środka symetrii nie ma.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "sprawdź, która z figur nie wygląda tak samo po obrocie o 180°",
   "czas_min": 2
  },
  {
   "id": "wojewodzki_2024-2025_wielkopolskie_q8",
   "numer": 8,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "zadania tekstowe na równania",
    "prawdopodobieństwo",
    "równania z jedną zmienną"
   ],
   "tresc_html": "<p>W woreczku jest 40 kul w czterech kolorach. Niebieskich jest dwa razy więcej niż czarnych, a złotych o cztery więcej niż niebieskich. Kul srebrnych jest sześć. Jakie jest prawdopodobieństwo wylosowania kuli złotej?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>3</mn><mn>20</mn></mfrac></math>"
    },
    {
     "litera": "B",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>12</mn><mn>40</mn></mfrac></math>"
    },
    {
     "litera": "C",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>3</mn><mn>8</mn></mfrac></math>"
    },
    {
     "litera": "D",
     "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>2</mn><mn>5</mn></mfrac></math>"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Niech czarnych kul będzie <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>c</mi></math>. Niebieskich jest <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>2</mn><mi>c</mi></mrow></math>, złotych <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>2</mn><mi>c</mi><mo>+</mo><mn>4</mn></mrow></math>, srebrnych 6. Suma: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>c</mi><mo>+</mo><mn>2</mn><mi>c</mi><mo>+</mo><mo>(</mo><mn>2</mn><mi>c</mi><mo>+</mo><mn>4</mn><mo>)</mo><mo>+</mo><mn>6</mn><mo>=</mo><mn>40</mn></mrow></math>, stąd <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>c</mi><mo>=</mo><mn>6</mn></mrow></math>, więc złotych jest 16. <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>P</mi><mo>=</mo><mfrac><mn>16</mn><mn>40</mn></mfrac><mo>=</mo><mfrac><mn>2</mn><mn>5</mn></mfrac></mrow></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "oznacz liczbę czarnych literką i zapisz sumę wszystkich kolorów jako 40",
   "czas_min": 2
