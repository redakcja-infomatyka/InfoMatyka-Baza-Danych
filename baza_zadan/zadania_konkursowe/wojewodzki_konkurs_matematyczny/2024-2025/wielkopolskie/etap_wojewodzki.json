     "html": "120"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Dzieci stanowią <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>100</mn><mo>%</mo><mo>−</mo><mn>30</mn><mo>%</mo><mo>−</mo><mn>45</mn><mo>%</mo><mo>=</mo><mn>25</mn><mo>%</mo></mrow></math> uczestników. Skoro <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>25</mn><mo>%</mo></mrow></math> to 20 osób, wszystkich uczestników jest <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>20</mn><mo>:</mo><mn>0,25</mn><mo>=</mo><mn>80</mn></mrow></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "sprawdź, jaki procent całości stanowią dzieci",
   "czas_min": 1
