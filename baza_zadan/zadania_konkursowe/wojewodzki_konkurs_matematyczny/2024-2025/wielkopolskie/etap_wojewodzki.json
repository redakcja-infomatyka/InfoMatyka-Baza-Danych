    {
     "litera": "D",
     "html": "69"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Strony 1–9 to 9 cyfr, strony 10–99 to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>90</mn><mo>·</mo><mn>2</mn><mo>=</mo><mn>180</mn></mrow></math> cyfr — razem 189. Zostaje <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>336</mn><mo>−</mo><mn>189</mn><mo>=</mo><mn>147</mn></mrow></math> cyfr na numery trzycyfrowe, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>147</mn><mo>:</mo><mn>3</mn><mo>=</mo><mn>49</mn></mrow></math> takich stron. Ostatnia strona to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>99</mn><mo>+</mo><mn>49</mn><mo>=</mo><mn>148</mn></mrow></math>, więc kartek jest <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>148</mn><mo>:</mo><mn>2</mn><mo>=</mo><mn>74</mn></mrow></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "policz osobno cyfry stron 1–9 i 10–99, a na koniec zamień liczbę stron na kartki",
