   "numer": 5,
   "typ": "zamkniete",
   "punkty": 1,
   "tematy": [
    "zliczanie / metody zliczania"
   ],
   "tresc_html": "<p>Do ponumerowania stron książki użyto 336 cyfr. Ile kartek liczy ta książka?</p>",
   "warianty": [
