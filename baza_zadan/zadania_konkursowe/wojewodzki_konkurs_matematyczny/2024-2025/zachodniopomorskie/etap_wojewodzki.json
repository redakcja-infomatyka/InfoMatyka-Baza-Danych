    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Odcinki trasy: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0,5</mn><mo>·</mo><mn>18</mn><mo>=</mo><mn>9</mn></math> km, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1,5</mn><mo>·</mo><mn>16</mn><mo>=</mo><mn>24</mn></math> km, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2,5</mn><mo>·</mo><mn>12</mn><mo>=</mo><mn>30</mn></math> km. Razem <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>9</mn><mo>+</mo><mn>24</mn><mo>+</mo><mn>30</mn><mo>=</mo><mn>63</mn></math> km.</p>"
