    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Sumy dwóch różnych liczb pierwszych: 8=3+5, 10=3+7, 12=5+7, 14=3+11 — po jednym rozkładzie. Dopiero <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>16</mn><mo>=</mo><mn>3</mn><mo>+</mo><mn>13</mn><mo>=</mo><mn>5</mn><mo>+</mo><mn>11</mn></math> ma dwa różne rozkłady — to najmniejsza taka liczba.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "liczbę nieparzystą da się rozłożyć tylko jako 2 + liczba pierwsza, więc sprawdzaj parzyste",
