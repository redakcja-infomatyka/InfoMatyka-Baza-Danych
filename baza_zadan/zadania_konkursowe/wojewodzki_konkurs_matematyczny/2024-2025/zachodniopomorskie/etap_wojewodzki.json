   "tresc_html": "<p>Bliźniacy Bolek i Lolek chodzą do tej samej szkoły. Bolek idzie do szkoły 20 minut, a Lolek 30 minut. Ile minut po Lolku wyszedł z domu Bolek, jeżeli spotkał Lolka w połowie drogi do szkoły?</p>",
   "warianty": [
    {
     "litera": "A",
     "html": "10 min"
    },
    {
     "litera": "B",
     "html": "5 min"
    },
    {
     "litera": "C",
     "html": "6 min"
    },
    {
     "litera": "D",
     "html": "4 min"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Bolek pokonuje połowę drogi w <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>20</mn><mo>:</mo><mn>2</mn><mo>=</mo><mn>10</mn></math> min, Lolek w <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>30</mn><mo>:</mo><mn>2</mn><mo>=</mo><mn>15</mn></math> min. Skoro spotykają się tam w tej samej chwili, a Bolkowi zajmuje to o <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>15</mn><mo>−</mo><mn>10</mn><mo>=</mo><mn>5</mn></math> min krócej, wyszedł z domu 5 minut po Lolku.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "spotkanie w połowie drogi to połowa czasu każdego z nich",
