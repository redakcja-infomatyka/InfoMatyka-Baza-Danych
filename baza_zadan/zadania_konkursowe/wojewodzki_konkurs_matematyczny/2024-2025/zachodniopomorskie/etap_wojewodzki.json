    {
     "litera": "B",
     "html": "większa o 1,5 cm,"
    },
    {
     "litera": "C",
     "html": "mniejsza o 10 cm,"
    },
    {
     "litera": "D",
     "html": "mniejsza o 2,5 cm,"
    }
   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Suma wzrostów drużyny: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>15</mn><mo>·</mo><mn>183</mn><mo>=</mo><mn>2745</mn></math>. Suma wzrostów odchodzących: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>·</mo><mn>193</mn><mo>=</mo><mn>579</mn></math>. Zostaje <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2745</mn><mo>−</mo><mn>579</mn><mo>=</mo><mn>2166</mn></math> cm dla 12 osób: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2166</mn><mo>:</mo><mn>12</mn><mo>=</mo><mn>180,5</mn></math> cm — mniejsza o 2,5 cm.</p>"
   },
   "w_pamieci": "pomysl",
   "wskazowka": "policz, o ile odchodzący przewyższają średnią, i rozłóż tę nadwyżkę na pozostałych",
   "czas_min": 2
