   "rysunki": [],
   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>2024</mn><mn>2025</mn></mfrac><mo>=</mo><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mn>2025</mn></mfrac></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>2025</mn><mn>2026</mn></mfrac><mo>=</mo><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mn>2026</mn></mfrac></math>. Ponieważ <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>2025</mn></mfrac><mo>&gt;</mo><mfrac><mn>1</mn><mn>2026</mn></mfrac></math>, ułamek Małgosi jest większy, więc z tej samej kwoty zapłaciła więcej.</p>"
   },
   "w_pamieci": "pomysl",
   "wskazowka": "nie mnóż na krzyż — sprawdź, ile każdemu z ułamków brakuje do 1",
   "czas_min": 2
