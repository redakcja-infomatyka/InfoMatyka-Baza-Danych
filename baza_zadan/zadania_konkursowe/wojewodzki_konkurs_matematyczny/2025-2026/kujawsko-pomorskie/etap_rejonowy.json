    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>J</mi><mo>=</mo><mi>A</mi><mo>−</mo><mn>6</mn></math>, a za 6 lat: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mi>A</mi><mo>+</mo><mn>6</mn><mo>)</mo><mo>+</mo><mo>(</mo><mi>J</mi><mo>+</mo><mn>6</mn><mo>)</mo><mo>=</mo><mn>42</mn></math>, czyli <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>+</mo><mi>J</mi><mo>=</mo><mn>30</mn></math>. Stąd <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>J</mi><mo>+</mo><mn>6</mn><mo>=</mo><mn>30</mn></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>J</mi><mo>=</mo><mn>12</mn></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>=</mo><mn>18</mn></math>.</p><ul><li><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>150</mn><mtext>% z </mtext><mn>12</mn><mo>=</mo><mn>18</mn><mo>=</mo><mi>A</mi></math> — <b>P</b>.</li><li>6 lat temu: Agata 12, Jacek 6, a <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>12</mn><mo>=</mo><mn>2</mn><mo>·</mo><mn>6</mn></math> — <b>P</b>.</li></ul>"
