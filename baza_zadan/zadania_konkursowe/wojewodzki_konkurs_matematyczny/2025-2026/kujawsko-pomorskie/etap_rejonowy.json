   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Liczba 225 kończy się na 5, więc każda jej potęga też — <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>225</mn><mn>12</mn></msup></math> kończy się na 5. Cyfry jedności potęg liczby 12 powtarzają się co 4: 2, 4, 8, 6. Ponieważ <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>225</mn><mo>=</mo><mn>4</mn><mo>·</mo><mn>56</mn><mo>+</mo><mn>1</mn></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>12</mn><mn>225</mn></msup></math> kończy się na 2. Suma cyfr jedności: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><mo>+</mo><mn>2</mn><mo>=</mo><mn>7</mn></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "ostatnią cyfrę każdego składnika weź osobno z cyklu ostatnich cyfr potęg",
   "czas_min": 2
  },
