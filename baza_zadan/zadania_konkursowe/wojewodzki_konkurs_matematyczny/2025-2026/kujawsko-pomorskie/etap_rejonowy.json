   "odpowiedz": {
    "poprawna": "B",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>MDCC=1700, MCM=1900, MMDCC=2700, MMD=2500. Odległości od 2026: 326, 126, 674, 474 — najbliżej jest MCM (1900).</p>"
