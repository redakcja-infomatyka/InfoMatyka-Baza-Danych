   "odpowiedz": {
    "poprawna": "D",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Cyfry jedności potęg 7 powtarzają się co 4: 7, 9, 3, 1. Ponieważ <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2026</mn><mo>=</mo><mn>4</mn><mo>·</mo><mn>506</mn><mo>+</mo><mn>2</mn></math>, cyfra jedności <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>7</mn><mn>2026</mn></msup></math> jest taka sama jak w <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>7</mn><mn>2</mn></msup><mo>=</mo><mn>49</mn></math>, czyli 9 – opcja D.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "ostatnie cyfry potęg siódemki powtarzają się co 4 — policz resztę z dzielenia 2026 przez 4",
   "czas_min": 1
  },
