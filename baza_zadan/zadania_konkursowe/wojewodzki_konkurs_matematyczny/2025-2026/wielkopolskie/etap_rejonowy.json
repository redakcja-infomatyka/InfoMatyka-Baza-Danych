   ],
   "rysunki": [],
   "odpowiedz": {
    "poprawna": "C",
    "zrodlo": "klucz",
    "rozwiazanie_ai_html": "<p>Niech w drugiej sali było <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi></math> osób, w pierwszej <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>+</mo><mn>8</mn></math>.</p><p>Po przejściu ćwierci osób z pierwszej sali zostaje w niej <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>3</mn><mn>4</mn></mfrac><mo>(</mo><mi>y</mi><mo>+</mo><mn>8</mn><mo>)</mo></math>, co ma być równe <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi></math>: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mi>y</mi><mo>+</mo><mn>24</mn><mo>=</mo><mn>4</mn><mi>y</mi></math>, stąd <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><mn>24</mn></math>.</p>"
   },
   "w_pamieci": "wprost",
   "wskazowka": "wyraź obie sale przez liczbę osób w drugiej sali i porównaj stan po przejściu ćwiartki",
