   "punkty": 1,
   "tematy": [
    "układy równań"
   ],
   "tresc_html": "<p>Układ równań <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>{</mo><mtable columnalign=\"left\"><mtr><mtd><mn>3</mn><mi>x</mi><mo>+</mo><mn>2</mn><mi>y</mi><mo>=</mo><mn>8</mn></mtd></mtr><mtr><mtd><mn>6</mn><mi>x</mi><mo>−</mo><mn>4</mn><mi>y</mi><mo>=</mo><mo>−</mo><mn>4</mn></mtd></mtr></mtable></math> jest spełniony przez pewną parę liczb. Jedną z nich jest <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>5</mn><mn>2</mn></mfrac></math>. Druga liczba to:</p>",
   "warianty": [
